<Window x:Class="LocalAIHub.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Brazhnichenko Hub — Установщик"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="660" Height="575" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#0B0B0C" Foreground="#F4F4F6" FontFamily="Segoe UI Variable Text, Segoe UI">

    <Grid Margin="22" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Image Source="pack://application:,,,/Assets/app.png" Width="38" Height="38" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeaderTitleText" Text="BRAZHNICHENKO HUB · SETUP" FontSize="17" FontFamily="JetBrains Mono, Cascadia Code, Consolas" FontWeight="Bold" Foreground="#F4F4F6"/>
                <TextBlock x:Name="HeaderSubtitleText" Text="Локальная AI-станция (LLM · Vision · Фото · Видео · MCP)" FontSize="12" Foreground="#7E7E87"/>
            </StackPanel>
        </StackPanel>

        <!-- Hardware Detection -->
        <Border Grid.Row="1" Background="#121215" BorderBrush="#FF521B" BorderThickness="2,0,0,0" CornerRadius="4" Padding="13,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="КОНФИГУРАЦИЯ СИСТЕМЫ" FontSize="10.5" FontFamily="JetBrains Mono, Cascadia Code, Consolas" FontWeight="SemiBold" Foreground="#FF521B"/>
                <TextBlock x:Name="HwSummaryText" Text="Определение GPU и оперативной памяти..." FontSize="12.5" FontFamily="JetBrains Mono, Cascadia Code, Consolas" Foreground="#F4F4F6" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Settings & Log -->
        <StackPanel Grid.Row="2">
            <Border x:Name="UpdateModeBanner" Visibility="Collapsed"
                    Background="#121215" BorderBrush="#34D399" BorderThickness="2,0,0,0" CornerRadius="4" Padding="14,11" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="● ОБНАРУЖЕНА УСТАНОВЛЕННАЯ ВЕРСИЯ" FontSize="12" FontFamily="JetBrains Mono, Cascadia Code, Consolas" FontWeight="SemiBold" Foreground="#34D399"/>
                    <TextBlock x:Name="UpdatePathInfoText" Text="—" FontSize="12" FontFamily="Consolas" Foreground="#E4E4E8" TextWrapping="Wrap" Margin="0,4,0,6"/>
                    <TextBlock Text="Обновление заменит только исполняемые модули. Все скачанные модели, движки (llama.cpp / ComfyUI), токены и диалоги сохранятся."
                               FontSize="11.5" Foreground="#9E9EA8" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border x:Name="FullInstallPanel" Background="#121215" BorderBrush="#28282E" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="ДИРЕКТОРИЯ ПРОГРАММЫ:" FontSize="10.5" FontFamily="Consolas" Foreground="#7E7E87" Margin="0,0,0,4"/>
                    <TextBox x:Name="InstallDirBox" Height="30" VerticalContentAlignment="Center"
                             Background="#080809" Foreground="#F4F4F6" BorderBrush="#28282E" Padding="9,0" FontFamily="Consolas" FontSize="12" Margin="0,0,0,10"/>

                    <TextBlock Text="ДИРЕКТОРИЯ МОДЕЛЕЙ И ДАННЫХ:" FontSize="10.5" FontFamily="Consolas" Foreground="#7E7E87" Margin="0,0,0,4"/>
                    <TextBox x:Name="DataDirBox" Height="30" VerticalContentAlignment="Center"
                             Background="#080809" Foreground="#F4F4F6" BorderBrush="#28282E" Padding="9,0" FontFamily="Consolas" FontSize="12" Margin="0,0,0,12"/>

                    <CheckBox x:Name="ShortcutsCheck" Content="Создать ярлыки на Рабочем столе и в меню «Пуск»" IsChecked="True" Foreground="#D4D4DC" Margin="0,0,0,6"/>
                    <CheckBox x:Name="UninstallRegCheck" Content="Зарегистрировать в «Приложениях и возможностях» Windows" IsChecked="True" Foreground="#D4D4DC" Margin="0,0,0,6"/>
                    <CheckBox x:Name="SviNodeCheck" Content="Установить узел ComfyUI-LocalAIHub-SVI" IsChecked="True" Foreground="#D4D4DC" Margin="0,0,0,6"/>
                    <CheckBox x:Name="RegisterMcpCheck" Content="Подключить MCP-сервер в Claude Desktop" IsChecked="False" Foreground="#D4D4DC"/>
                </StackPanel>
            </Border>

            <ProgressBar x:Name="InstallProgressBar" Height="5" Minimum="0" Maximum="100" Value="0" Background="#1A1A1E" Foreground="#FF521B" BorderThickness="0" Margin="0,0,0,8"/>
            <TextBox x:Name="LogBox" Height="96" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Background="#080809" Foreground="#B4B4BC" BorderBrush="#28282E" Padding="8,6" FontFamily="Consolas" FontSize="11.5"
                     Text="Готов к установке."/>
        </StackPanel>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <CheckBox x:Name="LaunchAfterCheck" Content="Запустить станцию после установки" IsChecked="True" Foreground="#B4B4BC" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ToggleReinstallBtn" Content="Параметры" Style="{StaticResource DarkButton}" Click="ToggleReinstallBtn_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                <Button x:Name="InstallBtn" Content="Установить Brazhnichenko Hub" Style="{StaticResource PrimaryButton}" Click="InstallBtn_Click" Margin="0,0,8,0"/>
                <Button x:Name="CloseBtn" Content="Закрыть" Style="{StaticResource DarkButton}" Click="CloseBtn_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
