<Window x:Class="LocalAIHub.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Brazhnichenko Hub — Установщик"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="660" Height="575" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#0F1117" Foreground="#E6EBF5" FontFamily="Segoe UI">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Image Source="pack://application:,,,/Assets/app.png" Width="40" Height="40" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeaderTitleText" Text="Установка Brazhnichenko Hub" FontSize="20" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                <TextBlock x:Name="HeaderSubtitleText" Text="Универсальная локальная AI-студия (LLM • Фото • Видео • GPU Вики • Hugging Face • MCP)" FontSize="12" Foreground="#8C96AD"/>
            </StackPanel>
        </StackPanel>

        <!-- Hardware Detection Preview -->
        <Border Grid.Row="1" Background="#151D2E" BorderBrush="#35528A" BorderThickness="1" CornerRadius="10" Padding="13,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Обнаруженное железо этого ПК" FontSize="12" FontWeight="SemiBold" Foreground="#8AB4FF"/>
                <TextBlock x:Name="HwSummaryText" Text="Определение NVIDIA GPU и оперативной памяти..." FontSize="12.5" Foreground="#E6EBF5" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Settings & Log -->
        <StackPanel Grid.Row="2">
            <!-- Existing Install / Update Banner -->
            <Border x:Name="UpdateModeBanner" Visibility="Collapsed"
                    Background="#14291E" BorderBrush="#2ECC71" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="● На этом ПК уже установлен Brazhnichenko Hub" FontSize="13.5" FontWeight="SemiBold" Foreground="#6AE89E"/>
                    <TextBlock x:Name="UpdatePathInfoText" Text="—" FontSize="12" Foreground="#D4DCEB" TextWrapping="Wrap" Margin="0,4,0,6"/>
                    <TextBlock Text="Быстрое обновление заменит только исполняемые файлы (LocalAIHub.exe, LocalAIHub.Mcp.exe и встроенные модули). Все твои скачанные модели, движки (llama.cpp / ComfyUI), HF-токен и настройки останутся нетронутыми."
                               FontSize="11.5" Foreground="#A5C7B5" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Full Install Options Panel -->
            <Border x:Name="FullInstallPanel" Background="#171B24" BorderBrush="#2A3245" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Папка установки программы (LocalAIHub.exe + LocalAIHub.Mcp.exe):" FontSize="12" Foreground="#8C96AD" Margin="0,0,0,4"/>
                    <TextBox x:Name="InstallDirBox" Height="30" VerticalContentAlignment="Center"
                             Background="#0B0D12" Foreground="#E6EBF5" BorderBrush="#2A3245" Padding="9,0" FontFamily="Consolas" FontSize="12" Margin="0,0,0,10"/>

                    <TextBlock Text="Папка для моделей и данных (или существующие D:\LocalLLM / D:\LocalMediaAI):" FontSize="12" Foreground="#8C96AD" Margin="0,0,0,4"/>
                    <TextBox x:Name="DataDirBox" Height="30" VerticalContentAlignment="Center"
                             Background="#0B0D12" Foreground="#E6EBF5" BorderBrush="#2A3245" Padding="9,0" FontFamily="Consolas" FontSize="12" Margin="0,0,0,12"/>

                    <CheckBox x:Name="ShortcutsCheck" Content="Создать ярлык на Рабочем столе и в меню «Пуск»" IsChecked="True" Foreground="#D4DCEB" Margin="0,0,0,6"/>
                    <CheckBox x:Name="UninstallRegCheck" Content="Добавить в «Приложения и возможности» Windows (с чистым удалением)" IsChecked="True" Foreground="#D4DCEB" Margin="0,0,0,6"/>
                    <CheckBox x:Name="SviNodeCheck" Content="Установить узел ComfyUI-LocalAIHub-SVI (если найден ComfyUI)" IsChecked="True" Foreground="#D4DCEB" Margin="0,0,0,6"/>
                    <CheckBox x:Name="RegisterMcpCheck" Content="Автоматически подключить MCP-сервер в Claude Desktop" IsChecked="False" Foreground="#D4DCEB"/>
                </StackPanel>
            </Border>

            <ProgressBar x:Name="InstallProgressBar" Height="7" Minimum="0" Maximum="100" Value="0" Background="#1F2533" Foreground="#4E7EF8" BorderThickness="0" Margin="0,0,0,8"/>
            <TextBox x:Name="LogBox" Height="96" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Background="#0B0D12" Foreground="#9FB1CE" BorderBrush="#2A3245" Padding="8,6" FontFamily="Consolas" FontSize="11.5"
                     Text="Готов к установке. После установки откроется вкладка «Каталог и GPU Вики» с персональными рекомендациями моделей под твою видеокарту."/>
        </StackPanel>

        <!-- Footer Buttons -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <CheckBox x:Name="LaunchAfterCheck" Content="Запустить после завершения" IsChecked="True" Foreground="#C8D4EA" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ToggleReinstallBtn" Content="Параметры / Переустановить" Style="{StaticResource DarkButton}" Click="ToggleReinstallBtn_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                <Button x:Name="InstallBtn" Content="Установить Brazhnichenko Hub" Style="{StaticResource PrimaryButton}" Click="InstallBtn_Click" Margin="0,0,8,0"/>
                <Button x:Name="CloseBtn" Content="Закрыть" Style="{StaticResource DarkButton}" Click="CloseBtn_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
