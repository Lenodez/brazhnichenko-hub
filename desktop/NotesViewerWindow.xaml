<Window x:Class="LocalAIHub.NotesViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заметки ассистента — Brazhnichenko Hub"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="940" Height="640" MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgCanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Border Grid.Row="0" Background="#0E0E11" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="14,9">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource SuccessButton}" Padding="11,5" FontSize="12" Margin="0,0,6,0" Click="NewNoteBtn_Click" Content="+ Новая" />
                    <Button Style="{StaticResource DarkButton}" Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="RefreshBtn_Click" Content="Обновить" />
                    <Button Style="{StaticResource DarkButton}" Padding="10,5" FontSize="12" Click="OpenFolderBtn_Click" Content="Открыть папку ↗" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ЗАМЕТКИ · MARKDOWN" FontSize="12.5" FontWeight="Bold" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Border Background="#18181C" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="3" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NotesCountBadge" Text="0 заметок" FontSize="10.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                    <TextBlock x:Name="NotesDirText" Text="" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,12,0" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Row 1: Two-pane viewer -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="295" MinWidth="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar: Search + Tags + Notes List -->
            <Border Grid.Column="0" Background="#0D0D10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="SearchBox" Grid.Row="0" Height="30" VerticalContentAlignment="Center"
                             Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderDefaultBrush}" Padding="9,0" FontSize="12.5"
                             CaretBrush="#FF521B" Margin="0,0,0,8"
                             ToolTip="Поиск по заголовку, тексту или тегам"
                             TextChanged="SearchBox_TextChanged" />

                    <WrapPanel x:Name="TagFilterPanel" Grid.Row="1" Margin="0,0,0,8" />

                    <ListBox x:Name="NotesListBox" Grid.Row="2"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="NotesListBox_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,5" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="#121215" BorderBrush="#23232A" BorderThickness="1" CornerRadius="4" Padding="10,8" Cursor="Hand">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#3F3F48" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#201410" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FF521B" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right Pane: Preview / Editor -->
            <Grid Grid.Column="1" Background="{StaticResource BgCanvasBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Note Toolbar -->
                <Border x:Name="NoteToolbarBorder" Grid.Row="0" Background="#111114" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,10" Visibility="Collapsed">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button x:Name="ToggleEditBtn" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="11.5" Margin="0,0,6,0" Click="ToggleEditBtn_Click" Content="Редактировать" />
                            <Button x:Name="SaveEditBtn" Style="{StaticResource SuccessButton}" Padding="11,4" FontSize="11.5" Margin="0,0,6,0" Visibility="Collapsed" Click="SaveEditBtn_Click" Content="Сохранить" />
                            <Button Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11.5" Margin="0,0,6,0" Click="CopyNoteBtn_Click" Content="Копировать" />
                            <Button Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11.5" Margin="0,0,6,0" ToolTip="Открыть в Obsidian / Блокноте / системном редакторе" Click="OpenExternalBtn_Click" Content="Внешний ↗" />
                            <Button Style="{StaticResource GhostDangerButton}" Padding="9,4" FontSize="11.5" Click="DeleteNoteBtn_Click" Content="Удалить" />
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock x:Name="SelectedTitleText" Text="" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SelectedMetaText" Text="" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Preview View -->
                <ScrollViewer x:Name="PreviewScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                    <StackPanel x:Name="PreviewContentPanel" MaxWidth="760" HorizontalAlignment="Left" />
                </ScrollViewer>

                <!-- Raw Markdown Editor View -->
                <TextBox x:Name="RawEditorBox" Grid.Row="1" Visibility="Collapsed"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="#0B0B0D" Foreground="{StaticResource TextPrimaryBrush}"
                         CaretBrush="#FF521B" BorderThickness="0"
                         FontFamily="{StaticResource MonoFontFamily}" FontSize="13"
                         Padding="18,14" />
            </Grid>
        </Grid>

        <!-- Row 2: Slim Status Footer -->
        <Border Grid.Row="2" Background="#0D0D10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="Obsidian / Markdown (.md) · Ctrl+S — сохранить" FontSize="10.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock x:Name="StatusFooterText" Text="Готово" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextSecondaryBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
