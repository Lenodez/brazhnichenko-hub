<UserControl x:Class="LocalAIHub.Views.CatalogTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Detected Hardware & Simulator Bar (Industrial Rack Header) -->
        <Border Grid.Row="0" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2,0,0,0" CornerRadius="4" Padding="13,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock x:Name="CatalogHwSummaryText" Text="Определение GPU и RAM..." FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" x:FieldModifier="internal" />
                    <TextBlock x:Name="CatalogRamAdviceText" Text="—" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" x:FieldModifier="internal" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="СИМУЛЯТОР:" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <ComboBox x:Name="CatalogSimGpuCombo" Width="205" FontSize="12" Margin="0,0,6,0" SelectionChanged="CatalogSim_Changed" x:FieldModifier="internal" />
                    <ComboBox x:Name="CatalogSimRamCombo" Width="88" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" SelectedIndex="0" SelectionChanged="CatalogSim_Changed" x:FieldModifier="internal">
                        <ComboBoxItem Content="Авто RAM" Tag="0" />
                        <ComboBoxItem Content="16 ГБ" Tag="16" />
                        <ComboBoxItem Content="32 ГБ" Tag="32" />
                        <ComboBoxItem Content="64 ГБ" Tag="64" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sharp Architectural Section Tabs + Sort Control -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,9" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel x:Name="CatalogSortPanel" Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,2" x:FieldModifier="internal">
                    <TextBlock Text="СОРТИРОВКА:" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="CatalogSortCombo" Width="190" FontSize="11.5" SelectedIndex="0" SelectionChanged="CatalogSortCombo_Changed" x:FieldModifier="internal">
                        <ComboBoxItem Content="Рекомендуемые (MoE + размер)" Tag="auto" />
                        <ComboBoxItem Content="Размер: большие → малые" Tag="size_desc" />
                        <ComboBoxItem Content="Размер: малые → большие" Tag="size_asc" />
                        <ComboBoxItem Content="Установленные сначала" Tag="installed" />
                        <ComboBoxItem Content="По названию (А–Я)" Tag="name" />
                    </ComboBox>
                </StackPanel>
                <WrapPanel>
                    <Button x:Name="CatTabTextBtn" Content="LLM (Текст и Код)" Style="{StaticResource PrimaryButton}" Padding="11,5" Margin="0,0,5,2" Click="CatTabTextBtn_Click" x:FieldModifier="internal" />
                    <Button x:Name="CatTabPhotoBtn" Content="Фото" Style="{StaticResource DarkButton}" Padding="11,5" Margin="0,0,5,2" Click="CatTabPhotoBtn_Click" x:FieldModifier="internal" />
                    <Button x:Name="CatTabVideoBtn" Content="Видео" Style="{StaticResource DarkButton}" Padding="11,5" Margin="0,0,5,2" Click="CatTabVideoBtn_Click" x:FieldModifier="internal" />
                    <Button x:Name="CatTabWikiBtn" Content="Матрица GPU" Style="{StaticResource DarkButton}" Padding="11,5" Margin="0,0,5,2" Click="CatTabWikiBtn_Click" x:FieldModifier="internal" />
                    <Button x:Name="CatTabHfSearchBtn" Content="Поиск Hugging Face" Style="{StaticResource DarkButton}" Padding="11,5" Margin="0,0,5,2" Click="CatTabHfSearchBtn_Click" x:FieldModifier="internal" />
                    <Button x:Name="CatTabDiskBtn" Content="На диске" Style="{StaticResource DarkButton}" Padding="11,5" Margin="0,0,0,2" Click="CatTabDiskBtn_Click" x:FieldModifier="internal" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- View A: Curated Model Recommendations -->
        <ScrollViewer x:Name="CatalogModelsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0" x:FieldModifier="internal">
            <StackPanel x:Name="CatalogCardsPanel" x:FieldModifier="internal" />
        </ScrollViewer>

        <!-- View B: NVIDIA GPU Matrix -->
        <Grid x:Name="CatalogWikiView" Grid.Row="2" Visibility="Collapsed" x:FieldModifier="internal">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="СЕРИЯ GPU:" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="WikiSeriesCombo" Width="195" FontSize="12" SelectedIndex="0" SelectionChanged="WikiSeriesCombo_Changed" x:FieldModifier="internal">
                    <ComboBoxItem Content="Все серии (GTX 10 → RTX 50)" Tag="all" />
                    <ComboBoxItem Content="GTX 10 (Pascal)" Tag="10" />
                    <ComboBoxItem Content="GTX 16 / RTX 20 (Turing)" Tag="16/20" />
                    <ComboBoxItem Content="RTX 30 (Ampere)" Tag="30" />
                    <ComboBoxItem Content="RTX 40 (Ada Lovelace)" Tag="40" />
                    <ComboBoxItem Content="RTX 50 (Blackwell)" Tag="50" />
                </ComboBox>
            </WrapPanel>
            <DataGrid x:Name="GpuWikiGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="{StaticResource Surface1Brush}" Foreground="{StaticResource TextPrimaryBrush}" RowBackground="#0E0E11" AlternatingRowBackground="#131317" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#202026" HeadersVisibility="Column" FontSize="12" RowHeaderWidth="0" CanUserAddRows="False" CanUserDeleteRows="False" x:FieldModifier="internal">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#16161B" />
                        <Setter Property="Foreground" Value="#8E8E98" />
                        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="9,7" />
                        <Setter Property="BorderBrush" Value="#282830" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ВИДЕОКАРТА" Binding="{Binding ModelName}" Width="185" />
                    <DataGridTextColumn Header="АРХИТЕКТУРА" Binding="{Binding Architecture}" Width="105" />
                    <DataGridTextColumn Header="VRAM" Binding="{Binding VramGB, StringFormat={}{0} ГБ}" Width="66" />
                    <DataGridTextColumn Header="ФОРМАТЫ" Binding="{Binding BestFormatHint}" Width="245" />
                    <DataGridTextColumn Header="ОПТИМАЛЬНЫЕ МОДЕЛИ" Binding="{Binding SummaryRu}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="2" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="11,8" Margin="0,8,0,0">
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run FontWeight="SemiBold" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource AccentBrush}" Text="ПАМЯТЬ: " />
                    <Run Text="16 ГБ RAM — модели целиком в VRAM · 32 ГБ RAM — оптимум для DynamicVRAM (Wan 2.2 FP8, LTX-2.5) и 35B MoE · 64+ ГБ RAM — мгновенный кэш без подкачки с SSD." />
                </TextBlock>
            </Border>
        </Grid>

        <!-- View C: Hugging Face Direct Installer -->
        <Grid x:Name="CatalogHfSearchView" Grid.Row="2" Visibility="Collapsed" x:FieldModifier="internal">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,7">
                <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button x:Name="HfModeLlmBtn" Style="{StaticResource PrimaryButton}" Padding="10,5" FontSize="12" Margin="0,0,5,0" Tag="llm" Click="HfSearchModeBtn_Click" x:FieldModifier="internal">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconChat}" Margin="0,0,6,0" />
                            <TextBlock Text="LLM (GGUF)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="HfModeLoraBtn" Style="{StaticResource DarkButton}" Padding="10,5" FontSize="12" Margin="0,0,5,0" Tag="lora" Click="HfSearchModeBtn_Click" x:FieldModifier="internal">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconLayers}" Margin="0,0,6,0" />
                            <TextBlock Text="LoRA" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="HfModeMediaBtn" Style="{StaticResource DarkButton}" Padding="10,5" FontSize="12" Margin="0,0,5,0" Tag="media" Click="HfSearchModeBtn_Click" x:FieldModifier="internal">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconPhoto}" Margin="0,0,6,0" />
                            <TextBlock Text="Фото / Видео" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="HfModeAllBtn" Style="{StaticResource DarkButton}" Padding="10,5" FontSize="12" Tag="all" Click="HfSearchModeBtn_Click" x:FieldModifier="internal">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconGlobe}" Margin="0,0,6,0" />
                            <TextBlock Text="Все форматы" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <TextBlock x:Name="HfModeHintText" Text="Фильтр готовых GGUF весов" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" x:FieldModifier="internal" />
            </DockPanel>

            <DockPanel Grid.Row="1" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                    <Button x:Name="HfTopPopularBtn" Content="★ Топ под мой ПК" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Padding="13,6" ToolTip="Показать самые популярные модели с Hugging Face, которые запустятся на твоём железе" Click="HfTopPopularBtn_Click" x:FieldModifier="internal" />
                    <Button x:Name="HfSearchBtn" Content="Найти на HF" Style="{StaticResource SuccessButton}" Padding="15,6" Click="HfSearchBtn_Click" x:FieldModifier="internal" />
                </StackPanel>
                <TextBox x:Name="HfSearchQueryBox" Height="32" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="10,0" FontSize="13" FontFamily="{StaticResource MonoFontFamily}" Text="Qwen3-Next-80B-A3B" PreviewKeyDown="HfSearchQueryBox_PreviewKeyDown" x:FieldModifier="internal" />
            </DockPanel>

            <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                <TextBlock Text="БЫСТРО:" FontSize="10.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,2" />
                <Button Content="Qwen3-Next-80B-A3B" Style="{StaticResource DarkButton}" Padding="8,3" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Margin="0,0,5,2" Click="HfQuickChip_Click" />
                <Button Content="Qwen3.8-27B" Style="{StaticResource DarkButton}" Padding="8,3" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Margin="0,0,5,2" Click="HfQuickChip_Click" />
                <Button Content="Qwen3-32B" Style="{StaticResource DarkButton}" Padding="8,3" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Margin="0,0,5,2" Click="HfQuickChip_Click" />
                <Button Content="Gemma 3 27B" Style="{StaticResource DarkButton}" Padding="8,3" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Margin="0,0,5,2" Click="HfQuickChip_Click" />
                <Button Content="abliterated" Tag="abliterated" Style="{StaticResource DarkButton}" Padding="8,3" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Margin="0,0,5,2" Click="HfQuickChip_Click" />
                <Button Content="Wan 2.2 LoRA" Tag="wan 2.2 lora" Style="{StaticResource DarkButton}" Padding="8,3" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Margin="0,0,0,2" Click="HfQuickChip_Click" />
            </WrapPanel>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46*" />
                    <ColumnDefinition Width="54*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,6,0">
                    <DockPanel>
                        <TextBlock x:Name="HfReposHeaderText" Text="01 · РЕПОЗИТОРИЙ" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Top" Margin="0,0,0,6" x:FieldModifier="internal" />
                        <ListBox x:Name="HfReposList" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="HfReposList_SelectionChanged" x:FieldModifier="internal" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="6,0,0,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                <CheckBox x:Name="HfOnlyFitCheck" Content="По памяти GPU" IsChecked="False" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" Checked="HfOnlyFitCheck_Changed" Unchecked="HfOnlyFitCheck_Changed" x:FieldModifier="internal" />
                                <Button x:Name="HfOpenRepoWebBtn" Content="HF ↗" Style="{StaticResource DarkButton}" Padding="8,2" FontSize="11" Visibility="Collapsed" Click="HfOpenRepoWebBtn_Click" x:FieldModifier="internal" />
                            </StackPanel>
                            <TextBlock x:Name="HfFilesHeaderText" Text="02 · ФАЙЛЫ И КВАНТОВАНИЕ" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" x:FieldModifier="internal" />
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,7,0,0">
                            <Border x:Name="HfSelectedFileHintBorder" Visibility="Collapsed" Background="#0E0E12" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="9,6" Margin="0,0,0,7" x:FieldModifier="internal">
                                <TextBlock x:Name="HfSelectedFileHintText" Text="—" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" x:FieldModifier="internal" />
                            </Border>
                            <DockPanel>
                                <ComboBox x:Name="HfTargetFolderCombo" Width="178" FontSize="12" SelectedIndex="0" DockPanel.Dock="Left" x:FieldModifier="internal">
                                    <ComboBoxItem Content="Папка: LLM (models)" Tag="llm_models" />
                                    <ComboBoxItem Content="Папка: Diffusion / Video" Tag="diffusion_models" />
                                    <ComboBoxItem Content="Папка: LoRA" Tag="loras" />
                                    <ComboBoxItem Content="Папка: Text Encoders" Tag="text_encoders" />
                                    <ComboBoxItem Content="Папка: VAE" Tag="vae" />
                                    <ComboBoxItem Content="Папка: Upscalers" Tag="upscale_models" />
                                </ComboBox>
                                <Button x:Name="HfDownloadSelectedBtn" Content="Скачать файл" Style="{StaticResource SuccessButton}" HorizontalAlignment="Right" Padding="14,6" Click="HfDownloadSelectedBtn_Click" x:FieldModifier="internal" />
                            </DockPanel>
                        </StackPanel>

                        <ListBox x:Name="HfFilesList" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="HfFilesList_SelectionChanged" x:FieldModifier="internal" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- View D: Installed Models on Disk -->
        <Grid x:Name="CatalogDiskView" Grid.Row="2" Visibility="Collapsed" x:FieldModifier="internal">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,9">
                <TextBlock x:Name="ModelsSummaryText" Text="Загрузка..." FontSize="12" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" x:FieldModifier="internal" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Показать в папке" Style="{StaticResource DarkButton}" Click="OpenSelectedModelFolderBtn_Click" Margin="0,0,6,0" />
                    <Button Content="Удалить файл" Style="{StaticResource DangerButton}" Click="DeleteSelectedModelBtn_Click" Margin="0,0,6,0" />
                    <Button Content="Обновить" Style="{StaticResource DarkButton}" Click="RefreshModelsBtn_Click" />
                </StackPanel>
            </DockPanel>
            <DataGrid x:Name="ModelsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="{StaticResource Surface1Brush}" Foreground="{StaticResource TextPrimaryBrush}" RowBackground="#0E0E11" AlternatingRowBackground="#131317" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#202026" HeadersVisibility="Column" FontSize="12.5" RowHeaderWidth="0" CanUserAddRows="False" CanUserDeleteRows="False" x:FieldModifier="internal">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#16161B" />
                        <Setter Property="Foreground" Value="#8E8E98" />
                        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="BorderBrush" Value="#282830" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Foreground" Value="#E4E4E8" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#261712" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ТИП" Binding="{Binding Category}" Width="125" />
                    <DataGridTextColumn Header="ФАЙЛ МОДЕЛИ" Binding="{Binding Name}" Width="300" />
                    <DataGridTextColumn Header="НАЗНАЧЕНИЕ" Binding="{Binding Purpose}" Width="*" />
                    <DataGridTextColumn Header="РАЗМЕР (ГБ)" Binding="{Binding SizeGB, StringFormat={}{0:0.00}}" Width="96" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
