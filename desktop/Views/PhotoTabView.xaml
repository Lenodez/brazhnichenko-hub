<UserControl x:Class="LocalAIHub.Views.PhotoTabView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Photo Sub-mode Switcher -->
                    <WrapPanel Grid.Row="0" Margin="0,0,0,9">
                        <Button x:Name="PhotoModeSingleBtn" Content="Одиночное фото" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="PhotoModeSingleBtn_Click" x:FieldModifier="internal" />
                        <Button x:Name="PhotoModeStoryBtn" Content="Фото-история (серия кадров)" Style="{StaticResource DarkButton}" Margin="0,0,8,0" Click="PhotoModeStoryBtn_Click" x:FieldModifier="internal" />
                        <Button x:Name="PhotoModeUpscaleBtn" Content="Апскейл ×4 (до 4K)" Style="{StaticResource DarkButton}" Click="PhotoModeUpscaleBtn_Click" x:FieldModifier="internal" />
                    </WrapPanel>

                    <!-- Photo Sub-view A & C: Single Photo + Upscale (with right Preview Pane) -->
                    <Grid x:Name="PhotoSingleGrid" Grid.Row="1" x:FieldModifier="internal">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="460" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                            <StackPanel>
                                <!-- Prerequisite warning banner -->
                                <Border x:Name="PhotoMissingBanner" Visibility="Collapsed" Background="#241F12" BorderBrush="#C79C2B" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,10" x:FieldModifier="internal">
                                    <DockPanel>
                                        <Button x:Name="PhotoMissingActionBtn" Content="Перейти в Каталог →" Style="{StaticResource SuccessButton}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0" Padding="11,5" Click="PhotoMissingActionBtn_Click" x:FieldModifier="internal" />
                                        <TextBlock x:Name="PhotoMissingText" Text="—" FontSize="12" Foreground="#FFE28A" TextWrapping="Wrap" VerticalAlignment="Center" x:FieldModifier="internal" />
                                    </DockPanel>
                                </Border>

                                <!-- Single Photo Options -->
                                <Border x:Name="StudioPhotoOptions" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10" AllowDrop="True" DragOver="ImageDrop_DragOver" Drop="PhotoRefDrop_Drop" x:FieldModifier="internal">
                                    <StackPanel>
                                        <WrapPanel Margin="0,0,0,9">
                                            <StackPanel Margin="0,0,12,6">
                                                <TextBlock Text="Модель фото" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                                <ComboBox x:Name="StudioPhotoEngineCombo" Width="260" FontSize="12" SelectedIndex="0" SelectionChanged="StudioEngineCombo_Changed" x:FieldModifier="internal">
                                                    <ComboBoxItem Content="Z-Image Turbo (8 шагов, быстрый T2I)" Tag="zimage" />
                                                    <ComboBoxItem Content="FLUX 3 Klein (16 шагов, топ + правка)" Tag="flux3" />
                                                    <ComboBoxItem Content="Qwen-Image 2.1 (8 шагов, текст + правка)" Tag="qwen21" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,6">
                                                <TextBlock Text="Размер" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                                <ComboBox x:Name="StudioPhotoSizeCombo" Width="118" FontSize="12" SelectedIndex="0" x:FieldModifier="internal">
                                                    <ComboBoxItem Content="1024 × 1024" Tag="1024x1024" />
                                                    <ComboBoxItem Content="1024 × 768" Tag="1024x768" />
                                                    <ComboBoxItem Content="768 × 1024" Tag="768x1024" />
                                                    <ComboBoxItem Content="1280 × 720" Tag="1280x720" />
                                                    <ComboBoxItem Content="832 × 480" Tag="832x480" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,6">
                                                <TextBlock Text="Seed (-1 = случ.)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                                <TextBox x:Name="StudioPhotoSeedBox" Text="-1" Width="110" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,6">
                                                <TextBlock Text="Вариации" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                                <ComboBox x:Name="StudioPhotoBatchCombo" Width="76" FontSize="12" SelectedIndex="0" x:FieldModifier="internal">
                                                    <ComboBoxItem Content="×1" Tag="1" />
                                                    <ComboBoxItem Content="×2" Tag="2" />
                                                    <ComboBoxItem Content="×4" Tag="4" />
                                                </ComboBox>
                                            </StackPanel>
                                        </WrapPanel>

                                        <DockPanel Margin="0,0,0,9">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                <Border x:Name="StudioPhotoRefThumbBorder" Visibility="Collapsed" Width="44" Height="44" CornerRadius="6" BorderBrush="#3B5B99" BorderThickness="1" ClipToBounds="True" Margin="0,0,8,0" Cursor="Hand" ToolTip="Кликни, чтобы открыть референс" MouseLeftButtonUp="StudioPhotoRefThumb_Click" x:FieldModifier="internal">
                                                    <Image x:Name="StudioPhotoRefThumbImage" Stretch="UniformToFill" x:FieldModifier="internal" />
                                                </Border>
                                                <Button Content="Референс / фото для правки" Style="{StaticResource DarkButton}" Padding="10,5" FontSize="12" Click="StudioPickPhotoRefBtn_Click" Margin="0,0,6,0" />
                                                <Button Style="{StaticResource DarkButton}" Padding="9,5" FontSize="12" Click="StudioPastePhotoRefBtn_Click" Margin="0,0,6,0" ToolTip="Вставить картинку из буфера обмена (также работает Ctrl+V)"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconClipboard}" Margin="0,0,6,0" /><TextBlock Text="Из буфера" VerticalAlignment="Center" /></StackPanel></Button>
                                                <Button x:Name="StudioPhotoMaskBtn" Style="{StaticResource DarkButton}" Padding="9,5" FontSize="12" Visibility="Collapsed" Margin="0,0,5,0" ToolTip="Нарисовать маску кистью (Inpainting — изменить только выделенную область фото)" Click="StudioPhotoMaskBtn_Click" x:FieldModifier="internal">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconBrush}" Margin="0,0,5,0" />
                                                        <TextBlock x:Name="StudioPhotoMaskBtnText" Text="Маска" VerticalAlignment="Center" x:FieldModifier="internal" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="StudioClearPhotoMaskBtn" Style="{StaticResource GhostDangerButton}" Padding="7,5" FontSize="12" Visibility="Collapsed" Margin="0,0,5,0" ToolTip="Сбросить маску" Click="StudioClearPhotoMaskBtn_Click" x:FieldModifier="internal">
                                                    <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconClose}" />
                                                </Button>
                                                <Button x:Name="StudioClearPhotoRefBtn" Content="Сбросить" Style="{StaticResource DarkButton}" Padding="9,5" FontSize="12" Visibility="Collapsed" Click="StudioClearPhotoRefBtn_Click" x:FieldModifier="internal" />
                                            </StackPanel>
                                            <Button Content="?" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="12" DockPanel.Dock="Right" Margin="8,0,0,0" ToolTip="Спросить AI-Помощника про настройки Фото, Seed, Референс и LoRA" Click="AskAiPhotoSettingsBtn_Click" />
                                            <TextBlock x:Name="StudioPhotoRefLabel" Text="Без референса (перетащи фото сюда, Ctrl+V или выбери файл)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" x:FieldModifier="internal" />
                                        </DockPanel>

                                        <!-- P2 Progressive Disclosure: Extra LoRA & Presets -->
                                        <Expander x:Name="PhotoAdvancedExpander" Style="{StaticResource StudioExpanderStyle}" IsExpanded="False" x:FieldModifier="internal">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconSliders}" Margin="0,0,7,0" />
                                                    <TextBlock Text="Доп. LoRA и пресеты Фото" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <StackPanel>
                                                <!-- Custom Extra LoRA for Photo -->
                                                <DockPanel>
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <TextBlock Text="Сила:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                        <Slider x:Name="PhotoExtraLoraSlider" Width="76" Minimum="0.1" Maximum="1.5" Value="0.75" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="LoraSlider_ValueChanged" x:FieldModifier="internal" />
                                                        <TextBlock x:Name="PhotoExtraLoraValText" Text="0.75" Width="34" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" Typography.NumeralAlignment="Tabular" Foreground="#CFE0FF" VerticalAlignment="Center" Margin="5,0,6,0" x:FieldModifier="internal" />
                                                        <Button Style="{StaticResource DarkButton}" Padding="7,4" FontSize="12" ToolTip="Обновить список LoRA" Click="RefreshLorasBtn_Click" Margin="0,0,4,0">
                                                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconRefresh}" />
                                                        </Button>
                                                        <Button Content="Папка" Style="{StaticResource DarkButton}" Padding="8,4" FontSize="12" ToolTip="Открыть папку ComfyUI\models\loras" Click="OpenLorasFolderBtn_Click" />
                                                    </StackPanel>
                                                    <DockPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Доп. LoRA:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,7,0" DockPanel.Dock="Left" />
                                                        <ComboBox x:Name="PhotoExtraLoraCombo" FontSize="12" SelectedIndex="0" x:FieldModifier="internal" />
                                                    </DockPanel>
                                                </DockPanel>

                                                <!-- Photo Studio Presets -->
                                                <DockPanel Margin="0,8,0,0">
                                                    <TextBlock Text="Пресет:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,7,0" DockPanel.Dock="Left" />
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0">
                                                        <Button Content="Применить" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="12" Margin="0,0,5,0" Click="PhotoPresetApplyBtn_Click" />
                                                        <Button Content="Сохранить" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="12" Margin="0,0,5,0" Click="PhotoPresetSaveBtn_Click" />
                                                        <Button Style="{StaticResource DarkButton}" Padding="8,4" FontSize="12" ToolTip="Удалить пресет" Click="PhotoPresetDeleteBtn_Click">
                                                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconClose}" />
                                                        </Button>
                                                    </StackPanel>
                                                    <ComboBox x:Name="PhotoPresetCombo" FontSize="12" SelectionChanged="PhotoPresetCombo_SelectionChanged" x:FieldModifier="internal" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>

                                <!-- Upscale Options (shown only in Upscale sub-mode) -->
                                <Border x:Name="StudioUpscaleOptions" Visibility="Collapsed" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10" AllowDrop="True" DragOver="ImageDrop_DragOver" Drop="UpscaleDrop_Drop" x:FieldModifier="internal">
                                    <StackPanel>
                                        <TextBlock Text="Увеличение резкости и разрешения в 4 раза (4x-UltraSharp)" FontSize="14" FontWeight="SemiBold" Foreground="#4DD9D5" Margin="0,0,0,6" />
                                        <TextBlock Text="Перетащи фото сюда, вставь Ctrl+V, выбери с диска или отправь готовый кадр из «Одиночного фото». Модель 4x-UltraSharp восстановит мелкие текстуры и увеличит размер ×4 (до 4K) за пару секунд." TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />
                                        <DockPanel>
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                <Button Content="Выбрать фото с диска" Style="{StaticResource PrimaryButton}" Click="StudioPickUpscaleBtn_Click" Margin="0,0,7,0" />
                                                <Button Style="{StaticResource DarkButton}" Click="StudioPasteUpscaleBtn_Click" ToolTip="Вставить картинку из буфера обмена (также работает Ctrl+V)"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconClipboard}" Margin="0,0,6,0" /><TextBlock Text="Из буфера" VerticalAlignment="Center" /></StackPanel></Button>
                                            </StackPanel>
                                            <TextBlock x:Name="StudioUpscaleSourceLabel" Text="Файл не выбран (перетащи фото сюда или выбери)" FontSize="12" Foreground="#C8D4EA" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" x:FieldModifier="internal" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Photo Prompt + Built-in AI Director + Style Chips -->
                                <Border x:Name="PhotoPromptCard" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10" x:FieldModifier="internal">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,5">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Button x:Name="PhotoMicBtn" Style="{StaticResource DarkButton}" Padding="8,5" FontSize="12" Margin="0,0,6,0" ToolTip="Надиктовать идею промпта голосом (локальный Whisper STT)" Click="PhotoMicBtn_Click" x:FieldModifier="internal">
                                                    <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconMic}" />
                                                </Button>
                                                <Button x:Name="PhotoHistoryBtn" Style="{StaticResource DarkButton}" Padding="9,5" FontSize="12" Margin="0,0,6,0" ToolTip="Недавние и избранные промпты" Click="PhotoHistoryBtn_Click" x:FieldModifier="internal"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconHistory}" Margin="0,0,6,0" /><TextBlock Text="История" VerticalAlignment="Center" /></StackPanel></Button>
                                                <Button Style="{StaticResource DarkButton}" Padding="8,5" FontSize="12" Margin="0,0,0,0" ToolTip="Копировать промпт" Click="PhotoCopyPromptBtn_Click"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconCopy}" /></Button>
                                            </StackPanel>
                                            <TextBlock Text="Промпт (пиши по-русски или по-английски)" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,7">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <ComboBox x:Name="PhotoSingleDirectorModelCombo" Width="165" FontSize="11" Margin="0,0,6,0" ToolTip="Модель LLM для Режиссёра" SelectionChanged="DirectorModelCombo_SelectionChanged" x:FieldModifier="internal" />
                                                <Button x:Name="PhotoEnhanceDirectorBtn" Style="{StaticResource PrimaryButton}" Padding="11,5" FontSize="12" Click="PhotoEnhanceDirectorBtn_Click" x:FieldModifier="internal"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconSparkles}" Margin="0,0,6,0" /><TextBlock Text="Улучшить Режиссёром" VerticalAlignment="Center" /></StackPanel></Button>
                                            </StackPanel>
                                            <TextBlock Text="Нажми «Улучшить Режиссёром» — выбранная LLM переведёт идею и распишет свет и оптику." FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBox x:Name="PhotoPromptBox" Height="106" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="10,8" FontSize="13" Text="Cinematic 35mm photograph of a cozy wooden cabin by a misty northern lake at golden hour, warm glowing windows, natural reflections on calm water, ultra detailed, sharp focus" x:FieldModifier="internal" />
                                        <WrapPanel x:Name="PhotoChipsPanel" Margin="0,8,0,0" x:FieldModifier="internal" />
                                    </StackPanel>
                                </Border>

                                <!-- Action Row -->
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <Button x:Name="PhotoGenerateBtn" Content="Сгенерировать фото" Style="{StaticResource SuccessButton}" Padding="20,10" FontSize="14" FontWeight="SemiBold" Click="PhotoGenerateBtn_Click" x:FieldModifier="internal" />
                                        <Button x:Name="PhotoEnqueueBtn" Content="+ В очередь" Style="{StaticResource DarkButton}" Padding="13,10" FontSize="13" Margin="8,0,0,0" Click="PhotoEnqueueBtn_Click" x:FieldModifier="internal" />
                                    </StackPanel>
                                    <Button x:Name="PhotoUseLastSeedBtn" Content="Повторить последний Seed" Style="{StaticResource DarkButton}" Padding="11,8" FontSize="12" HorizontalAlignment="Right" Visibility="Collapsed" Click="PhotoUseLastSeedBtn_Click" x:FieldModifier="internal" />
                                </DockPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Right: Photo Result Preview -->
                        <Border Grid.Column="1" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Результат" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Content="Папка" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="12" HorizontalAlignment="Right" Click="StudioOpenOutputFolderBtn_Click" />
                                </DockPanel>

                                <Border x:Name="PhotoPreviewBorder" Grid.Row="1" Background="{StaticResource WellBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Cursor="Hand" MouseLeftButtonUp="PhotoPreviewBorder_Click" x:FieldModifier="internal">
                                    <Grid>
                                        <Image x:Name="PhotoPreviewImage" Stretch="Uniform" Visibility="Collapsed" x:FieldModifier="internal" />
                                        <TextBlock x:Name="PhotoPreviewPlaceholder" Text="Здесь появится готовое фото&#xA;или 4K апскейл" TextAlignment="Center" Foreground="#6B7794" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" x:FieldModifier="internal" />
                                    </Grid>
                                </Border>

                                <WrapPanel x:Name="PhotoBatchStripPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,7,0,0" x:FieldModifier="internal" />

                                <TextBlock x:Name="PhotoResultMetaText" Grid.Row="3" Text="Ожидание генерации..." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,8" x:FieldModifier="internal" />

                                <WrapPanel Grid.Row="4">
                                    <Button x:Name="PhotoOpenResultBtn" Content="Открыть оригинал" Style="{StaticResource PrimaryButton}" Padding="11,6" FontSize="12" Margin="0,0,6,6" Visibility="Collapsed" Click="PhotoOpenResultBtn_Click" x:FieldModifier="internal" />
                                    <Button x:Name="PhotoCompareBeforeAfterBtn" Style="{StaticResource DarkButton}" Padding="10,6" FontSize="12" Margin="0,0,6,6" Visibility="Collapsed" ToolTip="Интерактивное сравнение До / После со шторкой" Click="PhotoCompareBeforeAfterBtn_Click" x:FieldModifier="internal">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconColumns}" Margin="0,0,5,0" />
                                            <TextBlock Text="До / После" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="PhotoBatchGridBtn" Style="{StaticResource DarkButton}" Padding="10,6" FontSize="12" Margin="0,0,6,6" Visibility="Collapsed" ToolTip="Сравнить все сгенерированные вариации в полноэкранной сетке 2×2" Click="PhotoBatchGridBtn_Click" x:FieldModifier="internal">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconGallery}" Margin="0,0,5,0" />
                                            <TextBlock Text="Сетка 2×2" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="PhotoSendToUpscaleBtn" Content="Апскейл ×4 →" Style="{StaticResource DarkButton}" Padding="10,6" FontSize="12" Margin="0,0,6,6" Visibility="Collapsed" Click="StudioSendToUpscaleBtn_Click" x:FieldModifier="internal" />
                                    <Button x:Name="PhotoSendToVideoBtn" Content="Оживить в Видео →" Style="{StaticResource DarkButton}" Padding="10,6" FontSize="12" Margin="0,0,6,6" Visibility="Collapsed" Click="StudioSendToVideoBtn_Click" x:FieldModifier="internal" />
                                    <Button x:Name="PhotoSendToStoryBtn" Content="В Видео-историю →" Style="{StaticResource SuccessButton}" Padding="10,6" FontSize="12" Margin="0,0,0,6" Visibility="Collapsed" Click="StudioSendToStoryBtn_Click" x:FieldModifier="internal" />
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Photo Sub-view B: Photo Story (with Built-in AI Scenario Director!) -->
                    <Grid x:Name="PhotoStoryView" Grid.Row="1" Visibility="Collapsed" x:FieldModifier="internal">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Built-in Interactive AI Director for Photo Story -->
                        <Border Grid.Row="0" Background="#151D2E" BorderBrush="#35528A" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,9">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock Text="AI-Режиссёр фото-истории (уточнить вопросами или собрать и дорабатывать этапы)" FontSize="12" FontWeight="SemiBold" Foreground="#8AB4FF" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="LLM:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <ComboBox x:Name="PhotoStoryDirectorModelCombo" Width="210" FontSize="12" ToolTip="Модель LLM для Режиссёра" SelectionChanged="DirectorModelCombo_SelectionChanged" x:FieldModifier="internal" />
                                    </StackPanel>
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PhotoDirectorIdeaBox" Grid.Column="0" Height="34" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="9,0" FontSize="13" Margin="0,0,8,0" Text="Рыжеволосая девушка-фотограф гуляет по осеннему Токио: утро на улице, кофе в уютном кафе, вечер под неоном" x:FieldModifier="internal" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox x:Name="PhotoDirectorOrientCombo" Width="82" FontSize="12" SelectedIndex="0" Margin="0,0,6,0" Height="34" x:FieldModifier="internal">
                                            <ComboBoxItem Content="Авто" Tag="auto" />
                                            <ComboBoxItem Content="1:1" Tag="1:1" />
                                            <ComboBoxItem Content="16:9" Tag="16:9" />
                                            <ComboBoxItem Content="9:16" Tag="9:16" />
                                        </ComboBox>
                                        <ComboBox x:Name="PhotoDirectorCountCombo" Width="74" FontSize="12" SelectedIndex="1" Margin="0,0,6,0" Height="34" x:FieldModifier="internal">
                                            <ComboBoxItem Content="2 кад." Tag="2" />
                                            <ComboBoxItem Content="3 кад." Tag="3" />
                                            <ComboBoxItem Content="4 кад." Tag="4" />
                                            <ComboBoxItem Content="5 кад." Tag="5" />
                                            <ComboBoxItem Content="6 кад." Tag="6" />
                                        </ComboBox>
                                        <Button x:Name="PhotoDirectorDiscussBtn" Style="{StaticResource DarkButton}" Height="34" Padding="11,0" Margin="0,0,6,0" ToolTip="Режиссёр задаст 2 уточняющих вопроса, чтобы убрать размытость" Click="PhotoDirectorDiscussBtn_Click" x:FieldModifier="internal"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconChat}" Margin="0,0,6,0" /><TextBlock Text="Уточнить" VerticalAlignment="Center" /></StackPanel></Button>
                                        <Button x:Name="PhotoDirectorBuildBtn" Style="{StaticResource PrimaryButton}" Height="34" Padding="12,0" Click="PhotoDirectorBuildBtn_Click" x:FieldModifier="internal"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconSparkles}" Margin="0,0,6,0" /><TextBlock Text="Собрать сценарий" VerticalAlignment="Center" /></StackPanel></Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Collapsible Director Discussion & Stage Revision Chat -->
                                <Border x:Name="PhotoDirectorChatPanel" Visibility="Collapsed" Background="#0E1421" BorderBrush="#293A5E" BorderThickness="1" CornerRadius="8" Padding="10,9" Margin="0,8,0,0" x:FieldModifier="internal">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Диалог с Режиссёром • Enter — отправить • Shift+Enter — новая строка" FontSize="12" Foreground="#8FA8D6" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                <Button Content="Очистить" Style="{StaticResource DarkButton}" Padding="8,2" FontSize="11" Margin="0,0,5,0" Click="PhotoDirectorClearChatBtn_Click" />
                                                <Button Content="Свернуть ×" Style="{StaticResource DarkButton}" Padding="8,2" FontSize="11" Click="PhotoDirectorHideChatBtn_Click" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Background="#090C13" BorderBrush="#232D42" BorderThickness="1" CornerRadius="7" Padding="8,6" Margin="0,0,0,7">
                                            <ScrollViewer x:Name="PhotoDirectorChatScroll" MaxHeight="200" VerticalScrollBarVisibility="Auto" x:FieldModifier="internal">
                                                <StackPanel x:Name="PhotoDirectorMessagesPanel" x:FieldModifier="internal" />
                                            </ScrollViewer>
                                        </Border>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="PhotoDirectorReplyBox" Grid.Column="0" MinHeight="38" MaxHeight="104" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="#2E3B56" Padding="9,7" FontSize="13" Margin="0,0,7,0" ToolTip="Enter — отправить сообщение • Shift+Enter — перенос строки" PreviewKeyDown="PhotoDirectorReplyBox_PreviewKeyDown" x:FieldModifier="internal" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                <Button x:Name="PhotoDirectorSendReplyBtn" Content="Отправить" Style="{StaticResource DarkButton}" Height="38" Padding="12,0" Margin="0,0,6,0" Click="PhotoDirectorSendReplyBtn_Click" x:FieldModifier="internal" />
                                                <Button x:Name="PhotoDirectorReviseBtn" Style="{StaticResource SuccessButton}" Height="38" Padding="12,0" Click="PhotoDirectorReviseBtn_Click" x:FieldModifier="internal"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconSparkles}" Margin="0,0,6,0" /><TextBlock Text="Применить в этапы" VerticalAlignment="Center" /></StackPanel></Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Photo Story Toolbar -->
                        <Border Grid.Row="1" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,9">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="Модель:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox x:Name="PhotoStoryEngineCombo" Width="230" FontSize="12" SelectedIndex="0" Margin="0,0,12,0" x:FieldModifier="internal">
                                        <ComboBoxItem Content="FLUX 3 Klein (16 шагов, топ)" Tag="flux3" />
                                        <ComboBoxItem Content="Qwen-Image 2.1 (8 шагов)" Tag="qwen21" />
                                    </ComboBox>
                                    <TextBlock Text="Размер:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox x:Name="PhotoStorySizeCombo" Width="125" FontSize="12" SelectedIndex="0" x:FieldModifier="internal">
                                        <ComboBoxItem Content="1024 × 1024" Tag="1024x1024" />
                                        <ComboBoxItem Content="1024 × 768" Tag="1024x768" />
                                        <ComboBoxItem Content="768 × 1024" Tag="768x1024" />
                                        <ComboBoxItem Content="1280 × 720" Tag="1280x720" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="+ Добавить этап" Style="{StaticResource PrimaryButton}" Click="AddPhotoStageBtn_Click" Margin="0,0,8,0" />
                                    <Button Content="Новая история" Style="{StaticResource DarkButton}" Click="ResetPhotoStoryBtn_Click" Margin="0,0,8,0" />
                                    <Button Content="Папка" Style="{StaticResource DarkButton}" Click="OpenStoriesFolderBtn_Click" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <StackPanel x:Name="PhotoStagesPanel" x:FieldModifier="internal" />
                        </ScrollViewer>
                    </Grid>
                </Grid></UserControl>