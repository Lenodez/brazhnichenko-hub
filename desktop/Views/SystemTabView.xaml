<UserControl x:Class="LocalAIHub.Views.SystemTabView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- System Sub-mode Pills -->
                    <WrapPanel Grid.Row="0" Margin="0,0,0,9">
                        <Button x:Name="SysTabServicesBtn" Content="Сервисы и порты" Style="{StaticResource PrimaryButton}" Margin="0,0,7,4" Click="SysTabServicesBtn_Click" x:FieldModifier="internal" />
                        <Button x:Name="SysTabSettingsBtn" Content="Настройки, HF и MCP" Style="{StaticResource DarkButton}" Margin="0,0,7,4" Click="SysTabSettingsBtn_Click" x:FieldModifier="internal" />
                        <Button x:Name="SysTabLogsBtn" Content="Логи" Style="{StaticResource DarkButton}" Margin="0,0,7,4" Click="SysTabLogsBtn_Click" x:FieldModifier="internal" />
                        <Button x:Name="SysTabGuideBtn" Content="Шпаргалка" Style="{StaticResource DarkButton}" Margin="0,0,0,4" Click="SysTabGuideBtn_Click" x:FieldModifier="internal" />
                    </WrapPanel>

                    <!-- System View A: Services & Ports -->
                    <ScrollViewer x:Name="SysServicesView" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,2,4,0" x:FieldModifier="internal">
                        <StackPanel VerticalAlignment="Top">
                            <UniformGrid x:Name="ServicesGrid" Columns="3" VerticalAlignment="Top" x:FieldModifier="internal" />

                            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16,13" Margin="6,10,6,0">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Быстрые переходы" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="При генерации фото или видео Хаб сам переключает GPU между LLM и ComfyUI." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource PrimaryButton}" Click="JumpAssistantBtn_Click" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconChat}" Margin="0,0,6,0" /><TextBlock Text="AI-Помощник" VerticalAlignment="Center" /></StackPanel></Button>
                                        <Button Style="{StaticResource DarkButton}" Click="JumpPhotoBtn_Click" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconPhoto}" Margin="0,0,6,0" /><TextBlock Text="Фото" VerticalAlignment="Center" /></StackPanel></Button>
                                        <Button Style="{StaticResource DarkButton}" Click="JumpVideoBtn_Click" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconVideo}" Margin="0,0,6,0" /><TextBlock Text="Видео" VerticalAlignment="Center" /></StackPanel></Button>
                                        <Button Style="{StaticResource SuccessButton}" Click="JumpCatalogBtn_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconPackage}" Margin="0,0,6,0" /><TextBlock Text="Модели и GPU" VerticalAlignment="Center" /></StackPanel></Button>
                                    </WrapPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- System View B: Settings, Runtimes, HF & MCP -->
                    <ScrollViewer x:Name="SysSettingsView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,2,4,0" x:FieldModifier="internal">
                        <StackPanel>
                            <!-- App Auto-Updates Card -->
                            <Border Background="#151D2E" BorderBrush="#35528A" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <Button x:Name="UpdateServerToggleBtn" Style="{StaticResource DarkButton}" Padding="10,6" Margin="0,0,6,0" ToolTip="Настроить адрес, токен или сертификат сервера обновлений" Click="UpdateServerToggleBtn_Click" x:FieldModifier="internal"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconSettings}" Margin="0,0,6,0" /><TextBlock Text="Сервер" VerticalAlignment="Center" /></StackPanel></Button>
                                            <Button x:Name="UpdateCheckBtn" Content="Проверить обновления" Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,6,0" Click="UpdateCheckBtn_Click" x:FieldModifier="internal" />
                                            <Button x:Name="UpdateSettingsInstallBtn" Content="⬇ Обновить сейчас" Style="{StaticResource SuccessButton}" Padding="12,6" Visibility="Collapsed" Click="UpdateInstallNowBtn_Click" x:FieldModifier="internal" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="UpdateSettingsTitleText" Text="Обновления Brazhnichenko Hub (текущая версия v2.3.1)" FontSize="13.5" FontWeight="SemiBold" Foreground="#8AB4FF" x:FieldModifier="internal" />
                                            <TextBlock x:Name="UpdateSettingsStatusText" Text="Автопроверка обновлений включена (защищённый канал TLS + токен + SHA-256)." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" x:FieldModifier="internal" />
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Collapsible Update Server Configuration -->
                                    <Border x:Name="UpdateServerConfigPanel" Visibility="Collapsed" Background="#0F1523" BorderBrush="#293A5E" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,10,0,0" x:FieldModifier="internal">
                                        <StackPanel>
                                            <TextBlock Text="Настройка сервера обновлений (оставь поля пустыми, чтобы использовать встроенный VPS по умолчанию)" FontSize="12" Foreground="#8FA8D6" Margin="0,0,0,8" TextWrapping="Wrap" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="155" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="URL / IP сервера:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,7" />
                                                <TextBox x:Name="CfgUpdateUrlBox" Grid.Row="0" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" Margin="0,0,0,7" ToolTip="По умолчанию: https://github.com/Lenodez/brazhnichenko-hub (GitHub Releases) или свой сервер" x:FieldModifier="internal" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Токен X-Hub-Token:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,7" />
                                                <TextBox x:Name="CfgUpdateTokenBox" Grid.Row="1" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" Margin="0,0,0,7" ToolTip="Пусто = встроенный токен. Заполни только если поменял токен на сервере." x:FieldModifier="internal" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="SHA-256 сертификата:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBox x:Name="CfgUpdateCertBox" Grid.Row="2" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" ToolTip="Опционально. Для нового домена с Let's Encrypt или нового IP можно оставить пустым." x:FieldModifier="internal" />
                                            </Grid>

                                            <DockPanel Margin="0,9,0,0">
                                                <CheckBox x:Name="CfgAutoCheckUpdatesCheck" Content="Проверять обновления при запуске" IsChecked="True" Foreground="#C8D4EA" FontSize="12" VerticalAlignment="Center" DockPanel.Dock="Left" x:FieldModifier="internal" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="Сбросить по умолч." Style="{StaticResource DarkButton}" Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="UpdateServerResetBtn_Click" />
                                                    <Button Content="Сохранить и проверить" Style="{StaticResource SuccessButton}" Padding="12,5" FontSize="12" Click="UpdateServerSaveBtn_Click" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 0. Engine Runtimes -->
                            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="0. Движки (Runtime) — нужны для запуска скачанных моделей" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,8">
                                            <TextBlock Text="llama.cpp (текстовые LLM • NVIDIA CUDA / Vulkan)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock x:Name="RuntimeLlamaStatusText" Text="Проверка..." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" x:FieldModifier="internal" />
                                        </StackPanel>
                                        <Button x:Name="InstallLlamaBtn" Grid.Row="0" Grid.Column="1" Content="Установить / Обновить llama.cpp" Style="{StaticResource SuccessButton}" VerticalAlignment="Center" Margin="0,0,0,8" Click="InstallLlamaBtn_Click" x:FieldModifier="internal" />

                                        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="ComfyUI Portable (фото и видео: FLUX, Z-Image, Wan 2.2, LTX-2.5)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock x:Name="RuntimeComfyStatusText" Text="Проверка..." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" x:FieldModifier="internal" />
                                        </StackPanel>
                                        <Button x:Name="InstallComfyBtn" Grid.Row="1" Grid.Column="1" Content="Установить / Обновить ComfyUI" Style="{StaticResource SuccessButton}" VerticalAlignment="Center" Click="InstallComfyBtn_Click" x:FieldModifier="internal" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 0.5. Local Voice Stack (Whisper STT + Piper HD TTS) -->
                            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Локальный голос (STT микрофон Whisper + нейросетевая озвучка Piper HD)" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,8">
                                            <TextBlock Text="Whisper.cpp (локальный голосовой ввод RU/EN для Чата и промптов)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock x:Name="VoiceWhisperStatusText" Text="Проверка..." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" x:FieldModifier="internal" />
                                        </StackPanel>
                                        <Button x:Name="InstallWhisperBtn" Grid.Row="0" Grid.Column="1" Content="Установить Whisper (~150 МБ)" Style="{StaticResource SuccessButton}" VerticalAlignment="Center" Margin="0,0,0,8" Click="InstallWhisperBtn_Click" x:FieldModifier="internal" />

                                        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="Piper HD TTS (русский нейро-голос Dmitri • Windows-голоса работают сразу)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock x:Name="VoicePiperStatusText" Text="Проверка..." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" x:FieldModifier="internal" />
                                        </StackPanel>
                                        <Button x:Name="InstallPiperBtn" Grid.Row="1" Grid.Column="1" Content="Установить Piper HD (~80 МБ)" Style="{StaticResource DarkButton}" VerticalAlignment="Center" Click="InstallPiperBtn_Click" x:FieldModifier="internal" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 0.6. Smart GPU Idle Auto-Unload & Profile Backup (.zip) -->
                            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Умный контроль GPU и Резервная копия профиля Хаба" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <DockPanel Margin="0,0,0,10">
                                        <ComboBox x:Name="CfgLlmIdleCombo" Width="210" FontSize="12" DockPanel.Dock="Right" SelectionChanged="CfgLlmIdleCombo_SelectionChanged" x:FieldModifier="internal">
                                            <ComboBoxItem Content="Выключено (вручную)" Tag="0" />
                                            <ComboBoxItem Content="Через 10 минут простоя" Tag="10" />
                                            <ComboBoxItem Content="Через 15 минут простоя" Tag="15" />
                                            <ComboBoxItem Content="Через 30 минут простоя" Tag="30" />
                                            <ComboBoxItem Content="Через 60 минут простоя" Tag="60" />
                                        </ComboBox>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="Авто-выгрузка LLM из VRAM при бездействии" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock x:Name="LlmIdleStatusText" Text="Автоматически остановит llama-server, если GPU и чат простаивают — удобно перед играми." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" x:FieldModifier="internal" />
                                        </StackPanel>
                                    </DockPanel>

                                    <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                        <DockPanel>
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                <Button x:Name="ExportProfileBtn" Style="{StaticResource PrimaryButton}" Padding="12,6" FontSize="12" Margin="0,0,6,0" Click="ExportProfileBtn_Click" x:FieldModifier="internal">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconDownload}" Margin="0,0,6,0" />
                                                        <TextBlock Text="Экспорт профиля (.zip)" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="ImportProfileBtn" Style="{StaticResource DarkButton}" Padding="12,6" FontSize="12" Click="ImportProfileBtn_Click" x:FieldModifier="internal">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconRestore}" Margin="0,0,6,0" />
                                                        <TextBlock Text="Импорт профиля (.zip)" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="Экспорт / Импорт настроек, пресетов, диалогов Чата и избранного" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="Сохраняет config.json, пресеты Фото/Видео, историю промптов, избранное Галереи, диалоги Чата и очередь в один ZIP." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 1. Hugging Face Auth -->
                            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="1. Подключение к Hugging Face (для закрытых моделей вроде LTX-2.5 и ускоренной загрузки)" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HfStatusBadgeText" Text="Проверка..." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" x:FieldModifier="internal" />
                                    </DockPanel>
                                    <DockPanel>
                                        <PasswordBox x:Name="HfTokenBox" Height="30" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontSize="13" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                                            <Button Content="Подключить и проверить" Style="{StaticResource PrimaryButton}" Click="HfConnectBtn_Click" Margin="0,0,6,0" />
                                            <Button Content="Отключить" Style="{StaticResource DarkButton}" Click="HfDisconnectBtn_Click" Margin="0,0,6,0" />
                                            <Button Content="Получить токен ↗" Style="{StaticResource DarkButton}" Click="HfOpenTokensPageBtn_Click" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- 2. MCP Server -->
                            <Border Background="#151D2E" BorderBrush="#35528A" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="2. MCP-сервер (подключи Claude, ChatGPT, Cursor или Antigravity к Local AI Hub)" FontSize="13.5" FontWeight="SemiBold" Foreground="#8AB4FF" />
                                            <TextBlock Text="Даёт внешней нейронке 13 инструментов: проверка GPU/RAM, Вики NVIDIA 10–50, рекомендации, установка моделей и движков, тюнинг настроек и сборка Фото/Видео-пайплайнов." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock x:Name="McpStatusText" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="#6AE89E" DockPanel.Dock="Right" VerticalAlignment="Top" x:FieldModifier="internal" />
                                    </DockPanel>
                                    <TextBox x:Name="McpConfigJsonBox" Height="92" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{StaticResource WellBrush}" Foreground="#CFE0FF" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="10,7" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Margin="0,4,0,9" x:FieldModifier="internal" />
                                    <WrapPanel>
                                        <Button Content="Скопировать MCP JSON" Style="{StaticResource PrimaryButton}" Click="CopyMcpJsonBtn_Click" Margin="0,0,8,4" />
                                        <Button Content="Авто-подключить в Antigravity" Style="{StaticResource SuccessButton}" Click="RegisterAntigravityMcpBtn_Click" Margin="0,0,8,4" />
                                        <Button Content="Авто-подключить в Claude Desktop" Style="{StaticResource SuccessButton}" Click="RegisterClaudeMcpBtn_Click" Margin="0,0,8,4" />
                                        <Button x:Name="TestMcpBtn" Content="Проверить MCP-сервер" Style="{StaticResource DarkButton}" Click="TestMcpBtn_Click" Margin="0,0,0,4" x:FieldModifier="internal" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- 3. Universal Paths & Tuning -->
                            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="3. Папки данных и тюнинг параметров LLM / Видео" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Content="? Объяснить настройки (AI)" Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="12" HorizontalAlignment="Right" Click="AskAiTuningSettingsBtn_Click" />
                                    </DockPanel>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Папка LLM:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,0,6" />
                                        <TextBox x:Name="CfgLlmRootBox" Grid.Row="0" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Margin="0,0,0,6" x:FieldModifier="internal" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Папка MediaAI:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,0,6" />
                                        <TextBox x:Name="CfgMediaRootBox" Grid.Row="1" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Margin="0,0,0,6" x:FieldModifier="internal" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Папка Историй:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBox x:Name="CfgStoriesRootBox" Grid.Row="2" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" x:FieldModifier="internal" />
                                    </Grid>

                                    <WrapPanel Margin="0,0,0,10">
                                        <StackPanel Margin="0,0,14,6">
                                            <TextBlock Text="LLM Контекст (0 = авто)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                            <TextBox x:Name="CfgLlmCtxBox" Width="130" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,14,6">
                                            <TextBlock Text="LLM Запас VRAM МиБ (0=авто)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                            <TextBox x:Name="CfgLlmFitBox" Width="155" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,14,6">
                                            <TextBlock Text="LLM Температура" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                            <TextBox x:Name="CfgLlmTempBox" Width="105" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,14,6">
                                            <TextBlock Text="Presence Penalty (анти-луп)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                            <TextBox x:Name="CfgLlmPresenceBox" Width="145" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,14,6">
                                            <TextBlock Text="DRY Multiplier (анти-повтор)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                            <TextBox x:Name="CfgLlmDryBox" Width="150" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,14,6">
                                            <TextBlock Text="Лимит &lt;think&gt; (4096, 0=выкл, -1=∞)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                            <TextBox x:Name="CfgLlmThinkBudgetBox" Width="170" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,14,6">
                                            <TextBlock Text="Wan 2.2 Shift" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                            <TextBox x:Name="CfgWanShiftBox" Width="95" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,14,6">
                                            <TextBlock Text="SVI Lightning High" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                            <TextBox x:Name="CfgSviHighBox" Width="115" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="SVI Хвост (кадров)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                            <TextBox x:Name="CfgSviTailBox" Width="110" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Сохранить настройки" Style="{StaticResource SuccessButton}" Click="SaveHubSettingsBtn_Click" Margin="0,0,8,0" />
                                        <Button Content="Профиль Qwen Анти-луп" Style="{StaticResource PrimaryButton}" Click="ApplyQwenAntiLoopBtn_Click" Margin="0,0,8,0" />
                                        <Button Content="Открыть config.json" Style="{StaticResource DarkButton}" Click="OpenConfigJsonBtn_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- System View C: Logs -->
                    <Grid x:Name="SysLogsView" Grid.Row="1" Visibility="Collapsed" x:FieldModifier="internal">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                            <ComboBox x:Name="LogServiceCombo" Width="290" Margin="0,0,10,0" SelectionChanged="LogServiceCombo_SelectionChanged" x:FieldModifier="internal" />
                            <Button Style="{StaticResource DarkButton}" Margin="0,0,8,0" ToolTip="Скопировать диагностику (версия, GPU/RAM, последние логи и краш-лог)" Click="CopyDiagnosticReportBtn_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconPackage}" Margin="0,0,6,0" /><TextBlock Text="Скопировать отчёт" VerticalAlignment="Center" /></StackPanel></Button>
                            <Button Content="Обновить лог" Style="{StaticResource DarkButton}" Click="RefreshLogBtn_Click" />
                        </StackPanel>
                        <TextBox x:Name="LogsTextBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{StaticResource WellBrush}" Foreground="#C9D4E8" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Padding="10" x:FieldModifier="internal" />
                    </Grid>

                    <!-- System View D: Beginner Guide -->
                    <ScrollViewer x:Name="SysGuideView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,2,4,0" x:FieldModifier="internal">
                        <StackPanel>
                            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Как устроен Local AI Hub (5 простых разделов)" FontSize="15" FontWeight="SemiBold" Foreground="#6EA8FE" Margin="0,0,0,6" />
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#D4DCEB" LineHeight="21">
                                        • Чат — встроенный AI-Помощник (подберёт модели под твою видеокарту, поставит их и разберёт ошибки сети/HF) + запуск основной локальной LLM.
• Фото — одиночное фото (с кнопкой «Улучшить Режиссёром»), Фото-история (серия кадров с единым персонажем и Режиссёром сценариев) и Апскейл ×4 до 4K.
• Видео — одиночное видео (с Режиссёром промптов) и Видео-история (многосценный ролик с Режиссёром, SVI 2.0 Pro и Мостом FLUX 3).
• Модели и GPU — рекомендации под твой ПК, Вики NVIDIA (10–50 серии), поиск Hugging Face и управление файлами на диске.
• Система — сервисы/порты, движки (llama.cpp / ComfyUI), HF-токен, MCP-сервер, тюнинг и логи.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Что выбрать под твою задачу" FontSize="15" FontWeight="SemiBold" Foreground="#4DD9D5" Margin="0,0,0,6" />
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#D4DCEB" LineHeight="21">
                                        • Чат 2.0 с картинками (Vision) → установи Qwen 2.5 VL 7B Vision, Gemma 3 12B Vision или Vision-модуль mmproj для Qwen 3.6 35B (0.84 ГБ), затем перезапусти LLM.
• Быстрое фото с нуля → Фото → Z-Image Turbo (~10–14 с).
• Максимальный фотореализм, правка по фото или Inpainting-маска → Фото → FLUX 3 Klein.
• Надписи на картинке, дизайн, аккуратная правка → Qwen-Image 2.1.
• Батч-вариации и сравнение → выбери ×2/×4 в Фото («Сетка 2×2»), для апскейла/правок используй шторку «До / После».
• Кино-видео по тексту или оживление фото → Видео → Wan 2.2 14B FP8 (DynamicVRAM, 4 шага).
• Длинное видео без «уплывания» персонажа → Видео → Видео-история (SVI 2.0 Pro + Мост FLUX 3).
• Видео сразу со звуком или озвучкой → LTX-2.5 либо «Озвучка видео (Локальный TTS)» под результатом Видео.
• Голосовой ввод (микрофон) → установи Whisper.cpp в «Система → Настройки → Локальный голос».
• Сделать картинку чётче в 4 раза (до 4K) → Фото → Апскейл ×4 (4x-UltraSharp).
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Полезные советы по работе с GPU и VRAM" FontSize="15" FontWeight="SemiBold" Foreground="#FFB35C" Margin="0,0,0,6" />
                                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#D4DCEB" LineHeight="21">
                                        • Авто-переключение GPU: при запуске генерации фото/видео локальная LLM остановится сама, чтобы отдать всю видеопамять ComfyUI.
• Авто-выгрузка при простое: включи таймер (10–60 мин) в «Система → Настройки», чтобы LLM сама освобождала VRAM перед играми.
• Бэкап профиля: сохрани настройки, пресеты, диалоги Чата и избранное Галереи в один ZIP через «Экспорт профиля».
• Промпты можно писать прямо по-русски и нажимать «Улучшить Режиссёром» — LLM сама переведёт и допишет детали.
• Перед запуском игр можно нажать «Освободить GPU» в правом верхнем углу.
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid></UserControl>