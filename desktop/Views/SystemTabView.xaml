<UserControl x:Class="LocalAIHub.Views.SystemTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Clean Segmented System Bar -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,9" Margin="0,0,0,10">
            <WrapPanel>
                <Button x:Name="SysTabServicesBtn" Content="Процессы и порты" Style="{StaticResource PrimaryButton}" Padding="11,5" Margin="0,0,5,2" Click="SysTabServicesBtn_Click" x:FieldModifier="internal" />
                <Button x:Name="SysTabSettingsBtn" Content="Конфигурация" Style="{StaticResource DarkButton}" Padding="11,5" Margin="0,0,5,2" Click="SysTabSettingsBtn_Click" x:FieldModifier="internal" />
                <Button x:Name="SysTabLogsBtn" Content="Логи" Style="{StaticResource DarkButton}" Padding="11,5" Margin="0,0,5,2" Click="SysTabLogsBtn_Click" x:FieldModifier="internal" />
                <Button x:Name="SysTabGuideBtn" Content="Справка" Style="{StaticResource DarkButton}" Padding="11,5" Margin="0,0,0,2" Click="SysTabGuideBtn_Click" x:FieldModifier="internal" />
            </WrapPanel>
        </Border>

        <!-- System View A: Services & Ports -->
        <ScrollViewer x:Name="SysServicesView" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,2,4,0" x:FieldModifier="internal">
            <StackPanel VerticalAlignment="Top">
                <UniformGrid x:Name="ServicesGrid" Columns="2" VerticalAlignment="Top" x:FieldModifier="internal" />

                <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="5" Padding="15,12" Margin="4,10,4,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="АВТОМАТИЧЕСКОЕ УПРАВЛЕНИЕ ПАМЯТЬЮ GPU" FontSize="11.5" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="При запуске рендера фото или видео станция автоматически выгружает LLM и освобождает VRAM под ComfyUI." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}" Click="OpenDesktopAssistantBtn_Click" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconSparkles}" Margin="0,0,6,0" />
                                    <TextBlock Text="Экран · Alt+Space" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DarkButton}" Click="JumpPhotoBtn_Click" Margin="0,0,6,0" Content="Фото" />
                            <Button Style="{StaticResource DarkButton}" Click="JumpVideoBtn_Click" Margin="0,0,6,0" Content="Видео" />
                            <Button Style="{StaticResource SuccessButton}" Click="JumpCatalogBtn_Click" Content="Модели и GPU" />
                        </WrapPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- System View B: Clean Monochrome Settings -->
        <ScrollViewer x:Name="SysSettingsView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,2,8,10" x:FieldModifier="internal">
            <StackPanel MaxWidth="1040" HorizontalAlignment="Left">

                <!-- 1. SYSTEM DESKTOP ASSISTANT -->
                <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2,0,0,0" CornerRadius="4" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Border Background="#18181C" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="SAFE-TOOLS · ЗАМЕТКИ · ТАЙМЕРЫ · ЭКРАН" FontSize="10.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="#34D399" />
                                </Border>
                                <Button Content="Заметки" Style="{StaticResource DarkButton}" Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="OpenNotesViewerBtn_Click" />
                                <Button Content="Вызвать сейчас" Style="{StaticResource PrimaryButton}" Padding="12,5" FontSize="12" Click="OpenDesktopAssistantBtn_Click" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Персональный ассистент ПК (Alt+Space)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Мгновенная панель поверх любых окон: сохраняет заметки (.md / Obsidian), ставит таймеры, ищет в сети и анализирует текущий экран (Vision)." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,12,0" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Margin="0,2,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="МОДЕЛЬ АССИСТЕНТА" FontSize="10.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                <ComboBox x:Name="CfgAssistModelCombo" FontSize="12.5" Padding="8,5" x:FieldModifier="internal" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ГОРЯЧАЯ КЛАВИША" FontSize="10.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                <ComboBox x:Name="CfgAssistHotkeyCombo" FontSize="12.5" Padding="8,5" x:FieldModifier="internal">
                                    <ComboBoxItem Content="Alt + Space (Рекомендуется)" Tag="Alt+Space" />
                                    <ComboBoxItem Content="Ctrl + Shift + Space" Tag="Ctrl+Shift+Space" />
                                    <ComboBoxItem Content="Alt + Q" Tag="Alt+Q" />
                                    <ComboBoxItem Content="Выключено (только из трея)" Tag="None" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="ВВОД ПО УМОЛЧАНИЮ" FontSize="10.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                <ComboBox x:Name="CfgAssistInputModeCombo" FontSize="12.5" Padding="8,5" x:FieldModifier="internal">
                                    <ComboBoxItem Content="Текстовый ввод" Tag="text" />
                                    <ComboBoxItem Content="Голосовой ввод (Whisper)" Tag="voice" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="ПАПКА ЗАМЕТОК (.MD / OBSIDIAN-СОВМЕСТИМАЯ)" FontSize="10.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Обзор…" Style="{StaticResource DarkButton}" Height="30" Padding="12,0" Margin="8,0,0,0" Click="BrowseAssistNotesDirBtn_Click" />
                                <TextBox x:Name="CfgAssistNotesDirBox" Height="30" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                            </DockPanel>
                        </StackPanel>

                        <WrapPanel Margin="0,0,0,10">
                            <CheckBox x:Name="CfgAssistEnabledCheck" Content="Отдельная иконка в системном трее" IsChecked="True" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,18,6" x:FieldModifier="internal" />
                            <CheckBox x:Name="CfgAssistScreenCheck" Content="Автозахват экрана (Vision)" IsChecked="True" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,18,6" x:FieldModifier="internal" />
                            <CheckBox x:Name="CfgAssistWebCheck" Content="Поиск в сети по умолчанию" IsChecked="True" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,18,6" x:FieldModifier="internal" />
                            <CheckBox x:Name="CfgAssistTtsCheck" Content="Автоозвучка ответов (TTS)" IsChecked="False" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" x:FieldModifier="internal" />
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Сохранить параметры ассистента" Style="{StaticResource SuccessButton}" Padding="14,6" FontSize="12" Click="SaveDesktopAssistantBtn_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. HYBRID WEB SEARCH -->
                <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Border Background="#18181C" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="3" Padding="8,2" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="CfgWebSearchBadgeText" Text="БЕЗ API-КЛЮЧЕЙ" FontSize="10.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextSecondaryBrush}" x:FieldModifier="internal" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Гибридный веб-поиск" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Работает бесплатно без ключей (DuckDuckGo + Google News + Wikipedia). Опционально поддерживаются API-ключи Tavily и Brave Search." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,10,0" />
                            </StackPanel>
                        </DockPanel>
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TAVILY API KEY (ОПЦ.)" FontSize="10.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                <PasswordBox x:Name="CfgTavilyKeyBox" Height="30" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="BRAVE SEARCH KEY (ОПЦ.)" FontSize="10.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                <PasswordBox x:Name="CfgBraveKeyBox" Height="30" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                            </StackPanel>
                            <Button Grid.Column="3" Content="Сохранить ключи" Style="{StaticResource DarkButton}" VerticalAlignment="Bottom" Height="30" Padding="12,0" Margin="10,0,0,0" Click="SaveDesktopAssistantBtn_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. UPDATES -->
                <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Button x:Name="UpdateServerToggleBtn" Content="Источник…" Style="{StaticResource DarkButton}" Padding="10,5" Margin="0,0,6,0" Click="UpdateServerToggleBtn_Click" x:FieldModifier="internal" />
                                <Button x:Name="UpdateCheckBtn" Content="Проверить релизы" Style="{StaticResource PrimaryButton}" Padding="12,5" Margin="0,0,6,0" Click="UpdateCheckBtn_Click" x:FieldModifier="internal" />
                                <Button x:Name="UpdateSettingsInstallBtn" Content="Обновить сейчас" Style="{StaticResource SuccessButton}" Padding="12,5" Visibility="Collapsed" Click="UpdateInstallNowBtn_Click" x:FieldModifier="internal" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="UpdateSettingsTitleText" Text="Обновления приложения" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" x:FieldModifier="internal" />
                                <TextBlock x:Name="UpdateSettingsStatusText" Text="GitHub Releases · Lenodez/brazhnichenko-hub" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" x:FieldModifier="internal" />
                            </StackPanel>
                        </DockPanel>

                        <Border x:Name="UpdateServerConfigPanel" Visibility="Collapsed" Background="#0C0C0E" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,10,0,0" x:FieldModifier="internal">
                            <StackPanel>
                                <TextBlock Text="Оставьте поля пустыми для автоматических обновлений через GitHub Releases." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="155" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="URL источника:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,7" />
                                    <TextBox x:Name="CfgUpdateUrlBox" Grid.Row="0" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" Margin="0,0,0,7" x:FieldModifier="internal" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Токен доступа:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,7" />
                                    <TextBox x:Name="CfgUpdateTokenBox" Grid.Row="1" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" Margin="0,0,0,7" x:FieldModifier="internal" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="SHA-256 пиннинг:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="CfgUpdateCertBox" Grid.Row="2" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                </Grid>
                                <DockPanel Margin="0,9,0,0">
                                    <CheckBox x:Name="CfgAutoCheckUpdatesCheck" Content="Проверять обновления при запуске" IsChecked="True" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" DockPanel.Dock="Left" x:FieldModifier="internal" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Сбросить" Style="{StaticResource DarkButton}" Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="UpdateServerResetBtn_Click" />
                                        <Button Content="Сохранить и проверить" Style="{StaticResource SuccessButton}" Padding="12,5" FontSize="12" Click="UpdateServerSaveBtn_Click" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 4. RUNTIMES & VOICE -->
                <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Локальные движки и речевые модули" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,10">
                                <TextBlock Text="llama.cpp (Движок LLM и Vision)" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="RuntimeLlamaStatusText" Text="Проверка..." FontSize="11.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" x:FieldModifier="internal" />
                            </StackPanel>
                            <Button x:Name="InstallLlamaBtn" Grid.Row="0" Grid.Column="1" Content="Установить / Обновить" Style="{StaticResource SuccessButton}" VerticalAlignment="Center" Margin="0,0,0,10" Click="InstallLlamaBtn_Click" x:FieldModifier="internal" />

                            <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,10">
                                <TextBlock Text="ComfyUI (Движок Фото и Видео)" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="RuntimeComfyStatusText" Text="Проверка..." FontSize="11.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" x:FieldModifier="internal" />
                            </StackPanel>
                            <Button x:Name="InstallComfyBtn" Grid.Row="1" Grid.Column="1" Content="Установить / Обновить" Style="{StaticResource SuccessButton}" VerticalAlignment="Center" Margin="0,0,0,10" Click="InstallComfyBtn_Click" x:FieldModifier="internal" />

                            <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,10">
                                <TextBlock Text="Whisper STT (Локальная диктовка)" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="VoiceWhisperStatusText" Text="Проверка..." FontSize="11.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" x:FieldModifier="internal" />
                            </StackPanel>
                            <Button x:Name="InstallWhisperBtn" Grid.Row="2" Grid.Column="1" Content="Установить Whisper (~150 МБ)" Style="{StaticResource DarkButton}" VerticalAlignment="Center" Margin="0,0,0,10" Click="InstallWhisperBtn_Click" x:FieldModifier="internal" />

                            <StackPanel Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Piper HD TTS (Локальный синтез речи)" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="VoicePiperStatusText" Text="Проверка..." FontSize="11.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" x:FieldModifier="internal" />
                            </StackPanel>
                            <Button x:Name="InstallPiperBtn" Grid.Row="3" Grid.Column="1" Content="Установить Piper HD (~80 МБ)" Style="{StaticResource DarkButton}" VerticalAlignment="Center" Click="InstallPiperBtn_Click" x:FieldModifier="internal" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 5. GPU MEMORY, DIRECTORIES & BACKUP -->
                <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Память GPU, директории и резервные копии" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <DockPanel Margin="0,0,0,12">
                            <ComboBox x:Name="CfgLlmIdleCombo" Width="210" FontSize="12" DockPanel.Dock="Right" SelectionChanged="CfgLlmIdleCombo_SelectionChanged" x:FieldModifier="internal">
                                <ComboBoxItem Content="Выключено (вручную)" Tag="0" />
                                <ComboBoxItem Content="Через 10 минут простоя" Tag="10" />
                                <ComboBoxItem Content="Через 15 минут простоя" Tag="15" />
                                <ComboBoxItem Content="Через 30 минут простоя" Tag="30" />
                                <ComboBoxItem Content="Через 60 минут простоя" Tag="60" />
                            </ComboBox>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Автовыгрузка LLM из VRAM при простое" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="LlmIdleStatusText" Text="Освобождает видеопамять автоматически, когда чат не используется." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" x:FieldModifier="internal" />
                            </StackPanel>
                        </DockPanel>

                        <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,7">
                                    <TextBlock Text="Токен Hugging Face (для моделей с лицензией)" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="HfStatusBadgeText" Text="Проверка..." FontSize="11.5" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" x:FieldModifier="internal" />
                                </DockPanel>
                                <DockPanel>
                                    <PasswordBox x:Name="HfTokenBox" Height="30" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontSize="12.5" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                                        <Button Content="Подключить" Style="{StaticResource PrimaryButton}" Click="HfConnectBtn_Click" Margin="0,0,6,0" />
                                        <Button Content="Сбросить" Style="{StaticResource DarkButton}" Click="HfDisconnectBtn_Click" Margin="0,0,6,0" />
                                        <Button Content="HF Tokens ↗" Style="{StaticResource DarkButton}" Click="HfOpenTokensPageBtn_Click" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,12">
                            <StackPanel>
                                <TextBlock Text="Рабочие директории" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="165" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="LLM модели:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,0,6" />
                                    <TextBox x:Name="CfgLlmRootBox" Grid.Row="0" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Margin="0,0,0,6" x:FieldModifier="internal" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="ComfyUI и медиа:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,0,6" />
                                    <TextBox x:Name="CfgMediaRootBox" Grid.Row="1" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Margin="0,0,0,6" x:FieldModifier="internal" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Проекты Историй:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBox x:Name="CfgStoriesRootBox" Grid.Row="2" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" x:FieldModifier="internal" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                    <Button Content="Сохранить директории" Style="{StaticResource SuccessButton}" Click="SaveHubSettingsBtn_Click" Margin="0,0,8,0" />
                                    <Button Content="Открыть config.json" Style="{StaticResource DarkButton}" Click="OpenConfigJsonBtn_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button x:Name="ExportProfileBtn" Style="{StaticResource PrimaryButton}" Padding="12,5" FontSize="12" Margin="0,0,6,0" Click="ExportProfileBtn_Click" x:FieldModifier="internal">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconDownload}" Margin="0,0,6,0" />
                                            <TextBlock Text="Экспорт (.zip)" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ImportProfileBtn" Style="{StaticResource DarkButton}" Padding="12,5" FontSize="12" Click="ImportProfileBtn_Click" x:FieldModifier="internal">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconRestore}" Margin="0,0,6,0" />
                                            <TextBlock Text="Импорт (.zip)" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Резервная копия профиля" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="Архивирует настройки, пресеты, историю промптов, избранное и диалоги." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 6. ADVANCED TUNING -->
                <Expander Header="Низкоуровневые параметры инференса (LLM / Wan 2.2)" Style="{StaticResource StudioExpanderStyle}" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" IsExpanded="False" Margin="0,0,0,12">
                    <StackPanel Margin="4,6,4,4">
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Значение 0 = автоматический расчёт под объём VRAM" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <Button Content="Справка по параметрам" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="12" HorizontalAlignment="Right" Click="AskAiTuningSettingsBtn_Click" />
                        </DockPanel>

                        <WrapPanel Margin="0,0,0,10">
                            <StackPanel Margin="0,0,14,8">
                                <TextBlock Text="Контекст, токены (0 = авто)" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <TextBox x:Name="CfgLlmCtxBox" Width="190" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,8">
                                <TextBlock Text="Резерв VRAM, МБ (0 = авто)" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <TextBox x:Name="CfgLlmFitBox" Width="210" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,8">
                                <TextBlock Text="Температура по умолчанию" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <TextBox x:Name="CfgLlmTempBox" Width="195" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,8">
                                <TextBlock Text="Presence Penalty" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <TextBox x:Name="CfgLlmPresenceBox" Width="195" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,8">
                                <TextBlock Text="DRY Multiplier" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <TextBox x:Name="CfgLlmDryBox" Width="185" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,8">
                                <TextBlock Text="Лимит &lt;think&gt; (0 = выкл)" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <TextBox x:Name="CfgLlmThinkBudgetBox" Width="210" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                            </StackPanel>
                        </WrapPanel>

                        <TextBlock Text="Параметры диффузии видео (Wan 2.2 / SVI 2.0)" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,6" />
                        <WrapPanel Margin="0,0,0,10">
                            <StackPanel Margin="0,0,14,6">
                                <TextBlock Text="Wan 2.2 Shift" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <TextBox x:Name="CfgWanShiftBox" Width="175" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,6">
                                <TextBlock Text="Lightning High Strength" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <TextBox x:Name="CfgSviHighBox" Width="185" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="SVI Tail Frames" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <TextBox x:Name="CfgSviTailBox" Width="175" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Сохранить параметры" Style="{StaticResource SuccessButton}" Click="SaveHubSettingsBtn_Click" Margin="0,0,8,0" />
                            <Button Content="Профиль Анти-луп Qwen" Style="{StaticResource DarkButton}" Click="ApplyQwenAntiLoopBtn_Click" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- 7. MCP SERVER -->
                <Expander Header="MCP-сервер для IDE и агентов (Claude Desktop / Cursor / Antigravity)" Style="{StaticResource StudioExpanderStyle}" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" IsExpanded="False">
                    <StackPanel Margin="4,4,4,2">
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Локальный протокол управления железом и моделями из внешних сред разработки." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="McpStatusText" Text="—" FontSize="11.5" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" Foreground="#34D399" DockPanel.Dock="Right" Margin="10,0,0,0" x:FieldModifier="internal" />
                        </DockPanel>
                        <TextBox x:Name="McpConfigJsonBox" Height="92" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="10,7" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Margin="0,4,0,9" x:FieldModifier="internal" />
                        <WrapPanel>
                            <Button Content="Скопировать JSON" Style="{StaticResource PrimaryButton}" Click="CopyMcpJsonBtn_Click" Margin="0,0,6,4" />
                            <Button Content="Подключить в Antigravity" Style="{StaticResource SuccessButton}" Click="RegisterAntigravityMcpBtn_Click" Margin="0,0,6,4" />
                            <Button Content="Подключить в Claude Desktop" Style="{StaticResource DarkButton}" Click="RegisterClaudeMcpBtn_Click" Margin="0,0,6,4" />
                            <Button x:Name="TestMcpBtn" Content="Тест MCP" Style="{StaticResource DarkButton}" Click="TestMcpBtn_Click" Margin="0,0,0,4" x:FieldModifier="internal" />
                        </WrapPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- System View C: Logs -->
        <Grid x:Name="SysLogsView" Grid.Row="1" Visibility="Collapsed" x:FieldModifier="internal">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                <ComboBox x:Name="LogServiceCombo" Width="290" Margin="0,0,8,0" SelectionChanged="LogServiceCombo_SelectionChanged" x:FieldModifier="internal" />
                <Button Style="{StaticResource DarkButton}" Margin="0,0,6,0" ToolTip="Скопировать диагностику в буфер обмена" Click="CopyDiagnosticReportBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconPackage}" Margin="0,0,6,0" />
                        <TextBlock Text="Скопировать диагностику" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Content="Обновить" Style="{StaticResource DarkButton}" Click="RefreshLogBtn_Click" />
            </StackPanel>
            <TextBox x:Name="LogsTextBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{StaticResource WellBrush}" Foreground="#D4D4DC" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Padding="10" x:FieldModifier="internal" />
        </Grid>

        <!-- System View D: Guide -->
        <ScrollViewer x:Name="SysGuideView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,2,4,0" x:FieldModifier="internal">
            <StackPanel MaxWidth="920" HorizontalAlignment="Left">
                <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="АРХИТЕКТУРА РАБОЧЕЙ СТАНЦИИ" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="22">
• Экран · Alt+Space — быстрый системный оверлей поверх любых окон: анализирует изображение на экране (Vision), ищет в сети и работает строго в режиме чтения без доступа к изменению файлов.
• Чат — многосессионный локальный диалог (GGUF / llama.cpp), голосовая диктовка Whisper, прикрепление скриншотов и гибридный веб-поиск.
• Фото — генерация и редактирование (FLUX 3 Klein, Qwen-Image 2.1, Z-Image Turbo), редактор маски Inpainting, серия кадров и апскейл ×4.
• Видео — рендер клипов и сценарных пайплайнов (Wan 2.2 14B, LTX-2.5 со звуком) и сведение с дикторской озвучкой Piper HD.
• Модели и GPU — расчёт совместимости с видеопамятью, прямой установщик весов с Hugging Face и управление файлами на диске.
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
