<UserControl x:Class="LocalAIHub.Views.SystemTabView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Clean System Sub-mode Pills -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
            <Button x:Name="SysTabServicesBtn" Content="Сервисы" Style="{StaticResource PrimaryButton}" Margin="0,0,7,4" Click="SysTabServicesBtn_Click" x:FieldModifier="internal" />
            <Button x:Name="SysTabSettingsBtn" Content="Настройки" Style="{StaticResource DarkButton}" Margin="0,0,7,4" Click="SysTabSettingsBtn_Click" x:FieldModifier="internal" />
            <Button x:Name="SysTabLogsBtn" Content="Логи" Style="{StaticResource DarkButton}" Margin="0,0,7,4" Click="SysTabLogsBtn_Click" x:FieldModifier="internal" />
            <Button x:Name="SysTabGuideBtn" Content="Шпаргалка" Style="{StaticResource DarkButton}" Margin="0,0,0,4" Click="SysTabGuideBtn_Click" x:FieldModifier="internal" />
        </WrapPanel>

        <!-- System View A: Services & Ports -->
        <ScrollViewer x:Name="SysServicesView" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,2,4,0" x:FieldModifier="internal">
            <StackPanel VerticalAlignment="Top">
                <UniformGrid x:Name="ServicesGrid" Columns="3" VerticalAlignment="Top" x:FieldModifier="internal" />

                <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16,13" Margin="6,10,6,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Быстрые переходы" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="При генерации фото или видео Хаб сам переключает GPU между LLM и ComfyUI." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}" Click="OpenDesktopAssistantBtn_Click" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconSparkles}" Margin="0,0,6,0" /><TextBlock Text="Ассистент ПК" VerticalAlignment="Center" /></StackPanel></Button>
                            <Button Style="{StaticResource DarkButton}" Click="JumpPhotoBtn_Click" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconPhoto}" Margin="0,0,6,0" /><TextBlock Text="Фото" VerticalAlignment="Center" /></StackPanel></Button>
                            <Button Style="{StaticResource DarkButton}" Click="JumpVideoBtn_Click" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconVideo}" Margin="0,0,6,0" /><TextBlock Text="Видео" VerticalAlignment="Center" /></StackPanel></Button>
                            <Button Style="{StaticResource SuccessButton}" Click="JumpCatalogBtn_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconPackage}" Margin="0,0,6,0" /><TextBlock Text="Модели и GPU" VerticalAlignment="Center" /></StackPanel></Button>
                        </WrapPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- System View B: Clean, Human-Friendly Settings -->
        <ScrollViewer x:Name="SysSettingsView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,2,8,10" x:FieldModifier="internal">
            <StackPanel MaxWidth="1040" HorizontalAlignment="Stretch">

                <!-- 1. SYSTEM DESKTOP ASSISTANT (Hotkey + Tray + Screen Vision + Read-Only Safety) -->
                <Border Background="#141C2E" BorderBrush="#2E4B80" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Border Background="#12291E" BorderBrush="#247846" BorderThickness="1" CornerRadius="9" Padding="9,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="Только чтение (безопасно)" FontSize="11" FontWeight="SemiBold" Foreground="#7CF0A8" />
                                </Border>
                                <Button Content="Открыть сейчас" Style="{StaticResource PrimaryButton}" Padding="12,6" FontSize="12" Click="OpenDesktopAssistantBtn_Click" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Системный ассистент ПК (хоткей и иконка в трее)" FontSize="14.5" FontWeight="SemiBold" Foreground="#EDF2FA" />
                                <TextBlock Text="Быстрый вызов локальной нейросети поверх любых окон: видит экран (Vision), ищет в сети, переводит и отвечает голосом или текстом. Не может менять файлы и настройки ПК." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,12,0" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Margin="0,2,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Нейросеть для ассистента" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                <ComboBox x:Name="CfgAssistModelCombo" FontSize="12.5" Padding="8,5" x:FieldModifier="internal" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Горячая клавиша вызова" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                <ComboBox x:Name="CfgAssistHotkeyCombo" FontSize="12.5" Padding="8,5" x:FieldModifier="internal">
                                    <ComboBoxItem Content="Alt + Space (Рекомендуется)" Tag="Alt+Space" />
                                    <ComboBoxItem Content="Ctrl + Shift + Space" Tag="Ctrl+Shift+Space" />
                                    <ComboBoxItem Content="Alt + Q" Tag="Alt+Q" />
                                    <ComboBoxItem Content="Выключено (только из трея)" Tag="None" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Режим ввода по умолчанию" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                <ComboBox x:Name="CfgAssistInputModeCombo" FontSize="12.5" Padding="8,5" x:FieldModifier="internal">
                                    <ComboBoxItem Content="Текстовый ввод" Tag="text" />
                                    <ComboBoxItem Content="Голосовой ввод (Whisper)" Tag="voice" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <WrapPanel Margin="0,0,0,10">
                            <CheckBox x:Name="CfgAssistEnabledCheck" Content="Показывать отдельную иконку ассистента в трее" IsChecked="True" Foreground="#D8E3F8" FontSize="12.5" Margin="0,0,18,6" x:FieldModifier="internal" />
                            <CheckBox x:Name="CfgAssistScreenCheck" Content="Автоматически видеть экран (Vision)" IsChecked="True" Foreground="#D8E3F8" FontSize="12.5" Margin="0,0,18,6" x:FieldModifier="internal" />
                            <CheckBox x:Name="CfgAssistWebCheck" Content="Включать поиск в интернете по умолчанию" IsChecked="True" Foreground="#D8E3F8" FontSize="12.5" Margin="0,0,18,6" x:FieldModifier="internal" />
                            <CheckBox x:Name="CfgAssistTtsCheck" Content="Озвучивать ответы голосом (TTS)" IsChecked="False" Foreground="#D8E3F8" FontSize="12.5" Margin="0,0,0,6" x:FieldModifier="internal" />
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Сохранить настройки ассистента" Style="{StaticResource SuccessButton}" Padding="14,6" FontSize="12.5" Click="SaveDesktopAssistantBtn_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. HYBRID WEB SEARCH -->
                <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Border Background="#132B3A" BorderBrush="#206080" BorderThickness="1" CornerRadius="9" Padding="8,2" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="CfgWebSearchBadgeText" Text="Бесплатный гибрид" FontSize="11" FontWeight="SemiBold" Foreground="#7DD3FC" x:FieldModifier="internal" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Поиск в интернете (для Ассистента и Чата)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Из коробки работает бесплатно без ключей (DuckDuckGo + Google News + Wikipedia). По желанию можно добавить бесплатный ключ Tavily или Brave Search." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,10,0" />
                            </StackPanel>
                        </DockPanel>
                        <Grid Margin="0,2,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ключ Tavily API (опционально)" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                <PasswordBox x:Name="CfgTavilyKeyBox" Height="30" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ключ Brave Search API (опционально)" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                                <PasswordBox x:Name="CfgBraveKeyBox" Height="30" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                            </StackPanel>
                            <Button Grid.Column="3" Content="Сохранить ключи" Style="{StaticResource DarkButton}" VerticalAlignment="Bottom" Height="30" Padding="12,0" Margin="10,0,0,0" Click="SaveDesktopAssistantBtn_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. UPDATES (GitHub Releases) -->
                <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Button x:Name="UpdateServerToggleBtn" Content="Источник…" Style="{StaticResource DarkButton}" Padding="10,6" Margin="0,0,6,0" ToolTip="Настроить альтернативный сервер обновлений" Click="UpdateServerToggleBtn_Click" x:FieldModifier="internal" />
                                <Button x:Name="UpdateCheckBtn" Content="Проверить обновления" Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,6,0" Click="UpdateCheckBtn_Click" x:FieldModifier="internal" />
                                <Button x:Name="UpdateSettingsInstallBtn" Content="Обновить сейчас" Style="{StaticResource SuccessButton}" Padding="12,6" Visibility="Collapsed" Click="UpdateInstallNowBtn_Click" x:FieldModifier="internal" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="UpdateSettingsTitleText" Text="Обновления Brazhnichenko Hub" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" x:FieldModifier="internal" />
                                <TextBlock x:Name="UpdateSettingsStatusText" Text="Источник: GitHub Releases (Lenodez/brazhnichenko-hub)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" x:FieldModifier="internal" />
                            </StackPanel>
                        </DockPanel>

                        <Border x:Name="UpdateServerConfigPanel" Visibility="Collapsed" Background="#0F1523" BorderBrush="#293A5E" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,10,0,0" x:FieldModifier="internal">
                            <StackPanel>
                                <TextBlock Text="Оставь поля пустыми для обновлений с GitHub Releases (по умолчанию)." FontSize="12" Foreground="#8FA8D6" Margin="0,0,0,8" TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="155" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="URL источника:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,7" />
                                    <TextBox x:Name="CfgUpdateUrlBox" Grid.Row="0" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" Margin="0,0,0,7" x:FieldModifier="internal" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Токен доступа (опц.):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,7" />
                                    <TextBox x:Name="CfgUpdateTokenBox" Grid.Row="1" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" Margin="0,0,0,7" x:FieldModifier="internal" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="SHA-256 сертификата:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="CfgUpdateCertBox" Grid.Row="2" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                </Grid>
                                <DockPanel Margin="0,9,0,0">
                                    <CheckBox x:Name="CfgAutoCheckUpdatesCheck" Content="Проверять обновления при запуске" IsChecked="True" Foreground="#C8D4EA" FontSize="12" VerticalAlignment="Center" DockPanel.Dock="Left" x:FieldModifier="internal" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Сбросить" Style="{StaticResource DarkButton}" Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="UpdateServerResetBtn_Click" />
                                        <Button Content="Сохранить и проверить" Style="{StaticResource SuccessButton}" Padding="12,5" FontSize="12" Click="UpdateServerSaveBtn_Click" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 4. INSTALLED ENGINES & VOICE -->
                <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Компоненты и локальный голос" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,10">
                                <TextBlock Text="Движок текстовых нейросетей (llama.cpp)" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="RuntimeLlamaStatusText" Text="Проверка..." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" x:FieldModifier="internal" />
                            </StackPanel>
                            <Button x:Name="InstallLlamaBtn" Grid.Row="0" Grid.Column="1" Content="Установить / Обновить" Style="{StaticResource SuccessButton}" VerticalAlignment="Center" Margin="0,0,0,10" Click="InstallLlamaBtn_Click" x:FieldModifier="internal" />

                            <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,10">
                                <TextBlock Text="Движок фото и видео (ComfyUI)" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="RuntimeComfyStatusText" Text="Проверка..." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" x:FieldModifier="internal" />
                            </StackPanel>
                            <Button x:Name="InstallComfyBtn" Grid.Row="1" Grid.Column="1" Content="Установить / Обновить" Style="{StaticResource SuccessButton}" VerticalAlignment="Center" Margin="0,0,0,10" Click="InstallComfyBtn_Click" x:FieldModifier="internal" />

                            <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,10">
                                <TextBlock Text="Распознавание речи с микрофона (Whisper)" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="VoiceWhisperStatusText" Text="Проверка..." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" x:FieldModifier="internal" />
                            </StackPanel>
                            <Button x:Name="InstallWhisperBtn" Grid.Row="2" Grid.Column="1" Content="Установить Whisper (~150 МБ)" Style="{StaticResource DarkButton}" VerticalAlignment="Center" Margin="0,0,0,10" Click="InstallWhisperBtn_Click" x:FieldModifier="internal" />

                            <StackPanel Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Озвучка ответов (Piper HD голос)" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="VoicePiperStatusText" Text="Проверка..." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" x:FieldModifier="internal" />
                            </StackPanel>
                            <Button x:Name="InstallPiperBtn" Grid.Row="3" Grid.Column="1" Content="Установить Piper HD (~80 МБ)" Style="{StaticResource DarkButton}" VerticalAlignment="Center" Click="InstallPiperBtn_Click" x:FieldModifier="internal" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 5. GPU MEMORY, FOLDERS, HUGGING FACE & BACKUP -->
                <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Память GPU, папки и аккаунты" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <DockPanel Margin="0,0,0,12">
                            <ComboBox x:Name="CfgLlmIdleCombo" Width="210" FontSize="12" DockPanel.Dock="Right" SelectionChanged="CfgLlmIdleCombo_SelectionChanged" x:FieldModifier="internal">
                                <ComboBoxItem Content="Выключено (вручную)" Tag="0" />
                                <ComboBoxItem Content="Через 10 минут простоя" Tag="10" />
                                <ComboBoxItem Content="Через 15 минут простоя" Tag="15" />
                                <ComboBoxItem Content="Через 30 минут простоя" Tag="30" />
                                <ComboBoxItem Content="Через 60 минут простоя" Tag="60" />
                            </ComboBox>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Авто-выгрузка нейросети из видеопамяти" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="LlmIdleStatusText" Text="Освобождает видеокарту автоматически, если чат простаивает (удобно перед играми)." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" x:FieldModifier="internal" />
                            </StackPanel>
                        </DockPanel>

                        <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,7">
                                    <TextBlock Text="Аккаунт Hugging Face (для закрытых моделей вроде LTX-2.5)" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="HfStatusBadgeText" Text="Проверка..." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" x:FieldModifier="internal" />
                                </DockPanel>
                                <DockPanel>
                                    <PasswordBox x:Name="HfTokenBox" Height="30" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontSize="12.5" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                                        <Button Content="Подключить" Style="{StaticResource PrimaryButton}" Click="HfConnectBtn_Click" Margin="0,0,6,0" />
                                        <Button Content="Отключить" Style="{StaticResource DarkButton}" Click="HfDisconnectBtn_Click" Margin="0,0,6,0" />
                                        <Button Content="Токен ↗" Style="{StaticResource DarkButton}" Click="HfOpenTokensPageBtn_Click" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,12">
                            <StackPanel>
                                <TextBlock Text="Папки хранения моделей и генераций" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Текстовые модели (LLM):" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,0,6" />
                                    <TextBox x:Name="CfgLlmRootBox" Grid.Row="0" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Margin="0,0,0,6" x:FieldModifier="internal" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Фото, видео и ComfyUI:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,0,6" />
                                    <TextBox x:Name="CfgMediaRootBox" Grid.Row="1" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Margin="0,0,0,6" x:FieldModifier="internal" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Папка Историй:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBox x:Name="CfgStoriesRootBox" Grid.Row="2" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" x:FieldModifier="internal" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                    <Button Content="Сохранить папки и настройки" Style="{StaticResource SuccessButton}" Click="SaveHubSettingsBtn_Click" Margin="0,0,8,0" />
                                    <Button Content="Открыть config.json" Style="{StaticResource DarkButton}" Click="OpenConfigJsonBtn_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button x:Name="ExportProfileBtn" Style="{StaticResource PrimaryButton}" Padding="12,6" FontSize="12" Margin="0,0,6,0" Click="ExportProfileBtn_Click" x:FieldModifier="internal">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconDownload}" Margin="0,0,6,0" />
                                            <TextBlock Text="Экспорт (.zip)" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ImportProfileBtn" Style="{StaticResource DarkButton}" Padding="12,6" FontSize="12" Click="ImportProfileBtn_Click" x:FieldModifier="internal">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconRestore}" Margin="0,0,6,0" />
                                            <TextBlock Text="Импорт (.zip)" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Резервная копия настроек и чатов" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="Сохраняет настройки, пресеты, историю промптов, избранное и диалоги в один ZIP." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 6. COLLAPSED ADVANCED TUNING (Human-friendly labels, hidden by default!) -->
                <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
                    <Expander Header="Расширенные параметры генерации (для опытных)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13.5" FontWeight="SemiBold" IsExpanded="False">
                        <StackPanel Margin="0,12,0,4">
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Параметры текстовых моделей (LLM) — при значении 0 подбираются автоматически под видеокарту" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                <Button Content="Объяснить параметры (AI)" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="12" HorizontalAlignment="Right" Click="AskAiTuningSettingsBtn_Click" />
                            </DockPanel>

                            <WrapPanel Margin="0,0,0,10">
                                <StackPanel Margin="0,0,14,8">
                                    <TextBlock Text="Память диалога, токены (0 = авто)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                    <TextBox x:Name="CfgLlmCtxBox" Width="190" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,8">
                                    <TextBlock Text="Резерв VRAM для системы, МБ (0 = авто)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                    <TextBox x:Name="CfgLlmFitBox" Width="210" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,8">
                                    <TextBlock Text="Креативность ответов (Температура)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                    <TextBox x:Name="CfgLlmTempBox" Width="195" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,8">
                                    <TextBlock Text="Защита от зацикливания (Presence)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                    <TextBox x:Name="CfgLlmPresenceBox" Width="195" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,8">
                                    <TextBlock Text="Защита от повторов фраз (DRY)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                    <TextBox x:Name="CfgLlmDryBox" Width="185" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,8">
                                    <TextBlock Text="Лимит размышлений &lt;think&gt; (0 = выкл)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                    <TextBox x:Name="CfgLlmThinkBudgetBox" Width="210" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                </StackPanel>
                            </WrapPanel>

                            <TextBlock Text="Тонкая настройка видео-моделей (Wan 2.2 / SVI 2.0)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,6" />
                            <WrapPanel Margin="0,0,0,10">
                                <StackPanel Margin="0,0,14,6">
                                    <TextBlock Text="Динамика шума Wan 2.2 (Shift)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                    <TextBox x:Name="CfgWanShiftBox" Width="175" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,6">
                                    <TextBlock Text="Сила ускорителя Lightning High" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                    <TextBox x:Name="CfgSviHighBox" Width="185" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="Кадры склейки сцен (SVI Tail)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                    <TextBox x:Name="CfgSviTailBox" Width="175" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                </StackPanel>
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Сохранить параметры" Style="{StaticResource SuccessButton}" Click="SaveHubSettingsBtn_Click" Margin="0,0,8,0" />
                                <Button Content="Сбросить на профиль Qwen Анти-луп" Style="{StaticResource PrimaryButton}" Click="ApplyQwenAntiLoopBtn_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- 7. COLLAPSED DEVELOPER INTEGRATION (MCP Server) -->
                <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                    <Expander Header="Интеграция для разработчиков (MCP-сервер для Claude / Cursor / Antigravity)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13.5" FontWeight="SemiBold" IsExpanded="False">
                        <StackPanel Margin="0,10,0,2">
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Позволяет внешним AI-инструментам (Claude Desktop, Cursor, Antigravity) проверять железо и управлять моделями Хаба." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="McpStatusText" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="#6AE89E" DockPanel.Dock="Right" Margin="10,0,0,0" x:FieldModifier="internal" />
                            </DockPanel>
                            <TextBox x:Name="McpConfigJsonBox" Height="92" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{StaticResource WellBrush}" Foreground="#CFE0FF" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="10,7" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Margin="0,4,0,9" x:FieldModifier="internal" />
                            <WrapPanel>
                                <Button Content="Скопировать MCP JSON" Style="{StaticResource PrimaryButton}" Click="CopyMcpJsonBtn_Click" Margin="0,0,8,4" />
                                <Button Content="Подключить в Antigravity" Style="{StaticResource SuccessButton}" Click="RegisterAntigravityMcpBtn_Click" Margin="0,0,8,4" />
                                <Button Content="Подключить в Claude Desktop" Style="{StaticResource SuccessButton}" Click="RegisterClaudeMcpBtn_Click" Margin="0,0,8,4" />
                                <Button x:Name="TestMcpBtn" Content="Проверить MCP" Style="{StaticResource DarkButton}" Click="TestMcpBtn_Click" Margin="0,0,0,4" x:FieldModifier="internal" />
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- System View C: Logs -->
        <Grid x:Name="SysLogsView" Grid.Row="1" Visibility="Collapsed" x:FieldModifier="internal">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                <ComboBox x:Name="LogServiceCombo" Width="290" Margin="0,0,10,0" SelectionChanged="LogServiceCombo_SelectionChanged" x:FieldModifier="internal" />
                <Button Style="{StaticResource DarkButton}" Margin="0,0,8,0" ToolTip="Скопировать диагностику (версия, GPU/RAM, последние логи и краш-лог)" Click="CopyDiagnosticReportBtn_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconPackage}" Margin="0,0,6,0" /><TextBlock Text="Скопировать отчёт" VerticalAlignment="Center" /></StackPanel></Button>
                <Button Content="Обновить лог" Style="{StaticResource DarkButton}" Click="RefreshLogBtn_Click" />
            </StackPanel>
            <TextBox x:Name="LogsTextBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{StaticResource WellBrush}" Foreground="#C9D4E8" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Padding="10" x:FieldModifier="internal" />
        </Grid>

        <!-- System View D: Beginner Guide -->
        <ScrollViewer x:Name="SysGuideView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,2,4,0" x:FieldModifier="internal">
            <StackPanel>
                <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Как устроен Brazhnichenko Hub" FontSize="15" FontWeight="SemiBold" Foreground="#6EA8FE" Margin="0,0,0,6" />
                        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#D4DCEB" LineHeight="21">
• Ассистент ПК (Alt+Space или иконка в трее) — мгновенное окно поверх любых приложений: видит экран (Vision), ищет в интернете, переводит и работает в безопасном режиме «Только чтение».
• Чат — диалоги с локальными моделями, Vision-фото, голосовой ввод Whisper и поиск в сети.
• Фото — генерация, правка, маска (Inpainting), Фото-история и Апскейл ×4.
• Видео — Wan 2.2 14B FP8, LTX-2.5 и Видео-истории с Режиссёром сценариев.
• Модели и GPU — рекомендации под твой ПК, поиск по Hugging Face и управление файлами.
• Система — сервисы, понятные настройки ассистента и движков, обновления с GitHub и логи.
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
