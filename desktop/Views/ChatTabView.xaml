<UserControl x:Class="LocalAIHub.Views.ChatTabView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Sub-mode pills -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,9">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button x:Name="ChatModeLlmBtn" Content="Локальный чат" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="ChatModeLlmBtn_Click" x:FieldModifier="internal" />
                            <Button x:Name="ChatModeAssistantBtn" Content="Гид по Хабу (RAG)" Style="{StaticResource DarkButton}" Click="ChatModeAssistantBtn_Click" x:FieldModifier="internal" />
                        </StackPanel>
                        <TextBlock x:Name="ChatQuickLlmStatusText" Text="LLM: проверка..." FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" x:FieldModifier="internal" />
                    </DockPanel>

                    <!-- Sub-view 1A: Built-in RAG AI Assistant -->
                    <Grid x:Name="ChatAssistantView" Grid.Row="1" x:FieldModifier="internal">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#151D2E" BorderBrush="#35528A" BorderThickness="1" CornerRadius="10" Padding="13,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock x:Name="AssistantStatusTitleText" Text="AI-Помощник Brazhnichenko Hub (RAG: Вики NVIDIA 10–50 + Каталог + Диагностика)" FontSize="13.5" FontWeight="SemiBold" Foreground="#8AB4FF" TextWrapping="Wrap" x:FieldModifier="internal" />
                                    <TextBlock x:Name="AssistantStatusSubText" Text="Проверка модели-помощника (Qwen 3 4B Instruct, 2.33 ГБ)..." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" x:FieldModifier="internal" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="AssistantBackBtn" Content="← Вернуться" Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Click="AssistantBackBtn_Click" Margin="0,0,7,0" x:FieldModifier="internal" />
                                    <Button x:Name="InstallAssistantBtn" Content="Установить Помощника (2.33 ГБ)" Style="{StaticResource SuccessButton}" Click="InstallAssistantBtn_Click" Margin="0,0,7,0" x:FieldModifier="internal" />
                                    <Button x:Name="AssistantNetCheckBtn" Content="Проверка сети" Style="{StaticResource DarkButton}" Click="AssistantNetCheckBtn_Click" Margin="0,0,7,0" x:FieldModifier="internal" />
                                    <Button Content="Очистить" Style="{StaticResource DarkButton}" Click="AssistantClearBtn_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                            <Button Content="Подобрать модель для фото" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="12" Margin="0,0,6,4" Click="AssistantQuickChip_Click" />
                            <Button Content="Подобрать модель для видео" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="12" Margin="0,0,6,4" Click="AssistantQuickChip_Click" />
                            <Button Content="Подобрать текстовую LLM" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="12" Margin="0,0,6,4" Click="AssistantQuickChip_Click" />
                            <Button Content="Как включить картинки (Vision) в чате?" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="12" Margin="0,0,6,4" Click="AssistantQuickChip_Click" />
                            <Button Content="Почему не скачивается / ошибка SSL?" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="12" Margin="0,0,6,4" Click="AssistantQuickChip_Click" />
                            <Button Content="Закрытая модель Hugging Face (403)" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="12" Margin="0,0,6,4" Click="AssistantQuickChip_Click" />
                            <Button Content="Qwen ходит по кругу" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="12" Margin="0,0,0,4" Click="AssistantQuickChip_Click" />
                        </WrapPanel>

                        <Border Grid.Row="2" Background="#0D1017" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                            <ScrollViewer x:Name="AssistantChatScroll" VerticalScrollBarVisibility="Auto" x:FieldModifier="internal">
                                <StackPanel x:Name="AssistantMessagesPanel" x:FieldModifier="internal" />
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Row="3" Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AssistantInputBox" Grid.Column="0" MinHeight="42" MaxHeight="96" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#131722" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="#35425E" BorderThickness="1" Padding="11,9" FontSize="13" PreviewKeyDown="AssistantInputBox_PreviewKeyDown" x:FieldModifier="internal" />
                            <Button x:Name="AssistantSendBtn" Grid.Column="1" Content="Отправить" Style="{StaticResource PrimaryButton}" Margin="9,0,0,0" Padding="18,10" VerticalAlignment="Stretch" Click="AssistantSendBtn_Click" x:FieldModifier="internal" />
                        </Grid>
                    </Grid>

                    <!-- Sub-view 1B: Chat 2.0 (Multi-Session + Personas + Vision + Voice Mic + SSE Streaming) -->
                    <Grid x:Name="ChatLlmView" Grid.Row="1" Visibility="Collapsed" AllowDrop="True" DragOver="ImageDrop_DragOver" Drop="LocalChat_Drop" x:FieldModifier="internal">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Clean Single-Row LLM Bar + Collapsed Tools Expander -->
                        <Border Grid.Row="0" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="11,8" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <Border x:Name="LocalChatVisionBadge" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Поддержка картинок: скачай файл mmproj-*.gguf для этой модели в Каталоге HF" x:FieldModifier="internal">
                                            <TextBlock x:Name="LocalChatVisionBadgeText" Text="Текст" FontSize="11" Foreground="{StaticResource TextMutedBrush}" x:FieldModifier="internal" />
                                        </Border>
                                        <Border x:Name="ChatLlmStatusBadge" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="9,3" Margin="0,0,8,0" VerticalAlignment="Center" x:FieldModifier="internal">
                                            <TextBlock x:Name="ChatLlmStatusBadgeText" Text="○ Остановлен" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" x:FieldModifier="internal" />
                                        </Border>
                                        <Button x:Name="ChatLlmStartBtn" Content="Запустить" Style="{StaticResource PrimaryButton}" Padding="12,5" FontSize="12" Margin="0,0,4,0" Click="ChatLlmStartBtn_Click" x:FieldModifier="internal" />
                                        <Button x:Name="ChatLlmOpenUiBtn" Content="Веб ↗" Style="{StaticResource DarkButton}" Padding="10,5" FontSize="12" Margin="0,0,4,0" Visibility="Collapsed" Click="ChatLlmOpenUiBtn_Click" x:FieldModifier="internal" />
                                        <Button x:Name="ChatLlmStopBtn" Content="Стоп" Style="{StaticResource DangerButton}" Padding="10,5" FontSize="12" Visibility="Collapsed" Click="ChatLlmStopBtn_Click" x:FieldModifier="internal" />
                                    </StackPanel>
                                    <Button x:Name="LocalChatToggleSidebarBtn" Style="{StaticResource DarkButton}" Padding="8,5" Margin="0,0,8,0" DockPanel.Dock="Left" ToolTip="Показать / скрыть список диалогов" Click="LocalChatToggleSidebarBtn_Click" x:FieldModifier="internal">
                                        <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconSidebar}" />
                                    </Button>
                                    <TextBlock Text="Модель:" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left" />
                                    <ComboBox x:Name="ChatLlmModelCombo" DisplayMemberPath="DisplayName" SelectedValuePath="FileName" FontSize="12.5" Padding="8,4" SelectionChanged="ChatLlmModelCombo_SelectionChanged" x:FieldModifier="internal" />
                                </DockPanel>

                                <Expander Header="Дополнительно (Claude, Каталог, Анти-луп, Контекст)" IsExpanded="False" Style="{StaticResource StudioExpanderStyle}" Margin="0,7,0,0" FontSize="11.5">
                                    <WrapPanel Margin="8,6,8,6">
                                        <Button Content="Каталог LLM →" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="12" Margin="0,0,6,2" Click="ChatJumpCatalogTextBtn_Click" />
                                        <Button Content="Claude Desktop" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="12" Margin="0,0,6,2" Click="ChatLlmClaudeBtn_Click" />
                                        <Button Content="Анти-луп Qwen" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="12" Margin="0,0,6,2" Click="ApplyQwenAntiLoopBtn_Click" />
                                        <Button Style="{StaticResource DarkButton}" Padding="10,4" FontSize="12" Margin="0,0,6,2" ToolTip="Скопировать контекст всех моделей и правил промптинга для внешнего чата" Click="CopyStackContextBtn_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconClipboard}" Margin="0,0,6,0" /><TextBlock Text="Скопировать контекст" VerticalAlignment="Center" /></StackPanel></Button>
                                        <Button Content="Контекст .md" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="12" Margin="0,0,0,2" Click="OpenStackContextFileBtn_Click" />
                                    </WrapPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- Row 1: Left Sessions Sidebar + Right Active Chat -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="LocalChatSidebarCol" Width="228" x:FieldModifier="internal" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Sidebar: Multi-Session History -->
                            <Border x:Name="LocalChatSidebarBorder" Grid.Column="0" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="9" Margin="0,0,10,0" x:FieldModifier="internal">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Button x:Name="LocalChatNewBtn" Grid.Row="0" Style="{StaticResource PrimaryButton}" Padding="10,6" FontSize="12" Margin="0,0,0,7" Click="LocalChatNewBtn_Click" x:FieldModifier="internal">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconPlus}" Margin="0,0,6,0" />
                                            <TextBlock Text="Новый чат" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <TextBox x:Name="LocalChatSearchBox" Grid.Row="1" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontSize="12" Margin="0,0,0,7" ToolTip="Поиск по названиям и тексту чатов" TextChanged="LocalChatSearchBox_TextChanged" x:FieldModifier="internal" />

                                    <ListBox x:Name="LocalChatSessionsList" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="LocalChatSessionsList_SelectionChanged" x:FieldModifier="internal" />

                                    <DockPanel Grid.Row="3" Margin="0,7,0,0">
                                        <Button x:Name="LocalChatRenameBtn" Style="{StaticResource DarkButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" ToolTip="Переименовать текущий диалог" Click="LocalChatRenameBtn_Click" x:FieldModifier="internal">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconEdit}" Margin="0,0,5,0" />
                                                <TextBlock Text="Имя" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="LocalChatDeleteSessionBtn" Style="{StaticResource GhostDangerButton}" Padding="8,4" FontSize="11" HorizontalAlignment="Right" ToolTip="Удалить выбранный диалог" Click="LocalChatDeleteSessionBtn_Click" x:FieldModifier="internal">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconTrash}" Margin="0,0,5,0" />
                                                <TextBlock Text="Удалить" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DockPanel>
                                </Grid>
                            </Border>

                            <!-- Right Main Chat Area -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Chat Persona + Temperature Bar -->
                                <Border Grid.Row="0" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="9" Padding="10,6" Margin="0,0,0,7">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="Темп.:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <Slider x:Name="LocalChatTempSlider" Width="82" Minimum="0" Maximum="1.5" Value="0.7" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="LocalChatTempSlider_ValueChanged" x:FieldModifier="internal" />
                                            <TextBlock x:Name="LocalChatTempValText" Text="0.70" Width="34" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" Typography.NumeralAlignment="Tabular" Foreground="#CFE0FF" VerticalAlignment="Center" Margin="6,0,8,0" x:FieldModifier="internal" />
                                            <Button x:Name="LocalChatClearBtn" Content="Очистить" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11" Click="LocalChatClearBtn_Click" x:FieldModifier="internal" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Персона:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                            <ComboBox x:Name="LocalChatPersonaCombo" Width="210" FontSize="12" Padding="8,3" SelectionChanged="LocalChatPersonaCombo_SelectionChanged" x:FieldModifier="internal" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Native Streaming Chat Viewport -->
                                <Border Grid.Row="1" Background="#0D1017" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                    <ScrollViewer x:Name="LocalChatScroll" VerticalScrollBarVisibility="Auto" x:FieldModifier="internal">
                                        <StackPanel x:Name="LocalChatMessagesPanel" x:FieldModifier="internal" />
                                    </ScrollViewer>
                                </Border>

                                <!-- Bottom: Pending Vision Image + Stats + Input + Mic + Send/Stop -->
                                <StackPanel Grid.Row="2" Margin="0,7,0,0">
                                    <Border x:Name="LocalChatPendingImgBorder" Visibility="Collapsed" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,6" x:FieldModifier="internal">
                                        <DockPanel>
                                            <Button x:Name="LocalChatClearImgBtn" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="6,3" ToolTip="Убрать прикреплённое фото" Click="LocalChatClearImgBtn_Click" x:FieldModifier="internal">
                                                <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconClose}" />
                                            </Button>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="44" Height="44" CornerRadius="6" ClipToBounds="True" Margin="0,0,9,0" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1">
                                                    <Image x:Name="LocalChatPendingImg" Stretch="UniformToFill" x:FieldModifier="internal" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="LocalChatPendingImgName" Text="image.png" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" x:FieldModifier="internal" />
                                                    <TextBlock Text="Прикреплено для Vision-запроса (отправится вместе с сообщением)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <DockPanel Margin="0,0,0,6">
                                        <CheckBox x:Name="LocalChatWebSearchCheck" Content="Поиск в сети" IsChecked="False" DockPanel.Dock="Right" Foreground="#93C5FD" FontSize="12" VerticalAlignment="Center" Margin="12,0,2,0" ToolTip="Добавляет свежие факты из интернета (DuckDuckGo + Google News + Wikipedia, либо Tavily/Brave) перед ответом модели" x:FieldModifier="internal" />
                                        <TextBlock x:Name="LocalChatStatsText" Text="Готов к чату • Enter — отправить • Shift+Enter — новая строка • Ctrl+V — фото" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" Typography.NumeralAlignment="Tabular" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" x:FieldModifier="internal" />
                                    </DockPanel>

                                    <Border Background="#131722" BorderBrush="#2E3B56" BorderThickness="1" CornerRadius="12" Padding="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Bottom">
                                                <Button x:Name="LocalChatAttachImgBtn" Style="{StaticResource GhostButton}" Padding="9,8" Margin="0,0,2,0" ToolTip="Прикрепить картинку (Vision) или перетащи файл / нажми Ctrl+V" Click="LocalChatAttachImgBtn_Click" x:FieldModifier="internal">
                                                    <Path Style="{StaticResource UiIcon16}" Data="{StaticResource IconImagePlus}" />
                                                </Button>
                                                <Button x:Name="LocalChatMicBtn" Style="{StaticResource GhostButton}" Padding="9,8" ToolTip="Голосовой ввод (локальный Whisper STT): нажми для записи, нажми ещё раз для распознавания" Click="LocalChatMicBtn_Click" x:FieldModifier="internal">
                                                    <Path Style="{StaticResource UiIcon16}" Data="{StaticResource IconMic}" />
                                                </Button>
                                            </StackPanel>

                                            <TextBox x:Name="LocalChatInputBox" Grid.Column="1" MinHeight="38" MaxHeight="116" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource AccentBrush}" BorderThickness="0" Padding="6,8" FontSize="13.5" PreviewKeyDown="LocalChatInputBox_PreviewKeyDown" x:FieldModifier="internal" />

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="6,0,0,0">
                                                <Button x:Name="LocalChatSendBtn" Content="Отправить" Style="{StaticResource PrimaryButton}" Padding="15,8" Click="LocalChatSendBtn_Click" x:FieldModifier="internal" />
                                                <Button x:Name="LocalChatStopBtn" Style="{StaticResource DangerButton}" Padding="12,8" Margin="5,0,0,0" Visibility="Collapsed" Click="LocalChatStopBtn_Click" x:FieldModifier="internal">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconStop}" Margin="0,0,6,0" />
                                                        <TextBlock Text="Стоп" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid></UserControl>