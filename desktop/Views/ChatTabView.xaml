<UserControl x:Class="LocalAIHub.Views.ChatTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Clean Segmented Mode Header -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,9" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="ChatModeLlmBtn" Content="Локальный чат" Style="{StaticResource PrimaryButton}" Padding="12,5" Margin="0,0,6,0" Click="ChatModeLlmBtn_Click" x:FieldModifier="internal" />
                    <Button x:Name="ChatModeAssistantBtn" Content="Справка и диагностика (RAG)" Style="{StaticResource DarkButton}" Padding="12,5" Click="ChatModeAssistantBtn_Click" x:FieldModifier="internal" />
                </StackPanel>
                <TextBlock x:Name="ChatQuickLlmStatusText" Text="LLM: проверка..." FontSize="11.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" x:FieldModifier="internal" />
            </DockPanel>
        </Border>

        <!-- Sub-view 1A: Built-in Hub Knowledge & Diagnostics -->
        <Grid x:Name="ChatAssistantView" Grid.Row="1" x:FieldModifier="internal">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="5" Padding="13,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock x:Name="AssistantStatusTitleText" Text="База знаний и диагностика Хаба" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" x:FieldModifier="internal" />
                        <TextBlock x:Name="AssistantStatusSubText" Text="Проверка локальной модели-консультанта..." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" x:FieldModifier="internal" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="AssistantBackBtn" Content="← Назад" Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Click="AssistantBackBtn_Click" Margin="0,0,6,0" x:FieldModifier="internal" />
                        <Button x:Name="InstallAssistantBtn" Content="Скачать модель (2.33 ГБ)" Style="{StaticResource SuccessButton}" Click="InstallAssistantBtn_Click" Margin="0,0,6,0" x:FieldModifier="internal" />
                        <Button x:Name="AssistantNetCheckBtn" Content="Сеть" Style="{StaticResource DarkButton}" Click="AssistantNetCheckBtn_Click" Margin="0,0,6,0" x:FieldModifier="internal" />
                        <Button Content="Очистить" Style="{StaticResource DarkButton}" Click="AssistantClearBtn_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                <Button Content="Подобрать модель для фото" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11.5" Margin="0,0,5,4" Click="AssistantQuickChip_Click" />
                <Button Content="Подобрать модель для видео" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11.5" Margin="0,0,5,4" Click="AssistantQuickChip_Click" />
                <Button Content="Подобрать текстовую LLM" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11.5" Margin="0,0,5,4" Click="AssistantQuickChip_Click" />
                <Button Content="Как включить картинки (Vision) в чате?" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11.5" Margin="0,0,5,4" Click="AssistantQuickChip_Click" />
                <Button Content="Почему не скачивается / ошибка SSL?" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11.5" Margin="0,0,5,4" Click="AssistantQuickChip_Click" />
                <Button Content="Закрытая модель Hugging Face (403)" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11.5" Margin="0,0,5,4" Click="AssistantQuickChip_Click" />
                <Button Content="Qwen ходит по кругу" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11.5" Margin="0,0,0,4" Click="AssistantQuickChip_Click" />
            </WrapPanel>

            <!-- Borderless Reading Floor -->
            <Border Grid.Row="2" Background="Transparent" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,1" Padding="4,10">
                <ScrollViewer x:Name="AssistantChatScroll" VerticalScrollBarVisibility="Auto" x:FieldModifier="internal">
                    <StackPanel x:Name="AssistantMessagesPanel" x:FieldModifier="internal" />
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="AssistantInputBox" Grid.Column="0" MinHeight="40" MaxHeight="96" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{StaticResource Surface1Brush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" Padding="11,9" FontSize="13" PreviewKeyDown="AssistantInputBox_PreviewKeyDown" x:FieldModifier="internal" />
                <Button x:Name="AssistantSendBtn" Grid.Column="1" Content="Отправить" Style="{StaticResource SuccessButton}" Margin="8,0,0,0" Padding="18,10" VerticalAlignment="Stretch" Click="AssistantSendBtn_Click" x:FieldModifier="internal" />
            </Grid>
        </Grid>

        <!-- Sub-view 1B: Local LLM Workstation (Receding Sidebar + Open Reading Floor) -->
        <Grid x:Name="ChatLlmView" Grid.Row="1" Visibility="Collapsed" AllowDrop="True" DragOver="ImageDrop_DragOver" Drop="LocalChat_Drop" x:FieldModifier="internal">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Row 0: Clean Instrument Model Bar -->
            <Border Grid.Row="0" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="5" Padding="10,7" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Border x:Name="LocalChatVisionBadge" Background="#18181C" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="7,2" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Поддержка картинок (mmproj-*.gguf)" x:FieldModifier="internal">
                                <TextBlock x:Name="LocalChatVisionBadgeText" Text="ТЕКСТ" FontSize="10.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" x:FieldModifier="internal" />
                            </Border>
                            <Border x:Name="ChatLlmStatusBadge" Background="#18181C" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center" x:FieldModifier="internal">
                                <TextBlock x:Name="ChatLlmStatusBadgeText" Text="○ АВТОСТАРТ" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" x:FieldModifier="internal" />
                            </Border>
                            <Button x:Name="ChatLlmStartBtn" Content="Загрузить в GPU" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="12" Margin="0,0,4,0" Click="ChatLlmStartBtn_Click" x:FieldModifier="internal" />
                            <Button x:Name="ChatLlmOpenUiBtn" Content="Веб ↗" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="12" Margin="0,0,4,0" Visibility="Collapsed" Click="ChatLlmOpenUiBtn_Click" x:FieldModifier="internal" />
                            <Button x:Name="ChatLlmStopBtn" Content="Выгрузить" Style="{StaticResource DangerButton}" Padding="10,4" FontSize="12" Visibility="Collapsed" Click="ChatLlmStopBtn_Click" x:FieldModifier="internal" />
                        </StackPanel>
                        <Button x:Name="LocalChatToggleSidebarBtn" Style="{StaticResource DarkButton}" Padding="8,5" Margin="0,0,8,0" DockPanel.Dock="Left" ToolTip="Показать / скрыть историю диалогов" Click="LocalChatToggleSidebarBtn_Click" x:FieldModifier="internal">
                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconSidebar}" />
                        </Button>
                        <TextBlock Text="МОДЕЛЬ:" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left" />
                        <ComboBox x:Name="ChatLlmModelCombo" DisplayMemberPath="DisplayName" SelectedValuePath="FileName" FontSize="12.5" Padding="8,4" SelectionChanged="ChatLlmModelCombo_SelectionChanged" x:FieldModifier="internal" />
                    </DockPanel>

                    <Expander Header="Инструменты (Claude мост, Анти-луп, Экспорт контекста)" IsExpanded="False" Style="{StaticResource StudioExpanderStyle}" Margin="0,6,0,0" FontSize="11.5">
                        <WrapPanel Margin="4,4,4,2">
                            <Button Content="Каталог LLM →" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11.5" Margin="0,0,6,2" Click="ChatJumpCatalogTextBtn_Click" />
                            <Button Content="Claude Desktop мост" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11.5" Margin="0,0,6,2" Click="ChatLlmClaudeBtn_Click" />
                            <Button Content="Профиль Анти-луп" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11.5" Margin="0,0,6,2" Click="ApplyQwenAntiLoopBtn_Click" />
                            <Button Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11.5" Margin="0,0,6,2" ToolTip="Скопировать системный контекст установленных моделей" Click="CopyStackContextBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconClipboard}" Margin="0,0,5,0" />
                                    <TextBlock Text="Копировать контекст" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Content="Файл .md" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11.5" Margin="0,0,0,2" Click="OpenStackContextFileBtn_Click" />
                        </WrapPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Row 1: Receding Sessions List + Clean Borderless Chat Canvas -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LocalChatSidebarCol" Width="224" x:FieldModifier="internal" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Receding Sessions Column (No outer rounded box — separated cleanly by right hairline) -->
                <Border x:Name="LocalChatSidebarBorder" Grid.Column="0" Background="#0E0E11" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,0,12,0" x:FieldModifier="internal">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button x:Name="LocalChatNewBtn" Grid.Row="0" Style="{StaticResource PrimaryButton}" Padding="10,6" FontSize="12" Margin="0,0,0,7" Click="LocalChatNewBtn_Click" x:FieldModifier="internal">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconPlus}" Margin="0,0,6,0" />
                                <TextBlock Text="Новый диалог" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBox x:Name="LocalChatSearchBox" Grid.Row="1" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontSize="12" Margin="0,0,0,7" ToolTip="Фильтр по истории диалогов" TextChanged="LocalChatSearchBox_TextChanged" x:FieldModifier="internal" />

                        <ListBox x:Name="LocalChatSessionsList" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="LocalChatSessionsList_SelectionChanged" x:FieldModifier="internal" />

                        <DockPanel Grid.Row="3" Margin="0,7,0,0">
                            <Button x:Name="LocalChatRenameBtn" Style="{StaticResource DarkButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" ToolTip="Переименовать диалог" Click="LocalChatRenameBtn_Click" x:FieldModifier="internal">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconEdit}" Margin="0,0,5,0" />
                                    <TextBlock Text="Имя" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="LocalChatDeleteSessionBtn" Style="{StaticResource GhostDangerButton}" Padding="8,4" FontSize="11" HorizontalAlignment="Right" ToolTip="Удалить выбранный диалог" Click="LocalChatDeleteSessionBtn_Click" x:FieldModifier="internal">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconTrash}" Margin="0,0,5,0" />
                                    <TextBlock Text="Удалить" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- Right Main Chat Floor -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Minimal Hairline Persona + Temperature Strip -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="2,0,2,7" Margin="0,0,0,6">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="ТЕМП.:" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Slider x:Name="LocalChatTempSlider" Width="80" Minimum="0" Maximum="1.5" Value="0.7" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="LocalChatTempSlider_ValueChanged" x:FieldModifier="internal" />
                                <TextBlock x:Name="LocalChatTempValText" Text="0.70" Width="34" FontSize="11.5" FontFamily="{StaticResource MonoFontFamily}" Typography.NumeralAlignment="Tabular" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="6,0,8,0" x:FieldModifier="internal" />
                                <Button x:Name="LocalChatClearBtn" Content="Очистить" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11" Click="LocalChatClearBtn_Click" x:FieldModifier="internal" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="РОЛЬ:" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <ComboBox x:Name="LocalChatPersonaCombo" Width="210" FontSize="12" Padding="8,3" SelectionChanged="LocalChatPersonaCombo_SelectionChanged" x:FieldModifier="internal" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Open Unboxed Streaming Chat Viewport -->
                    <ScrollViewer x:Name="LocalChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="2,4,8,4" x:FieldModifier="internal">
                        <StackPanel x:Name="LocalChatMessagesPanel" x:FieldModifier="internal" />
                    </ScrollViewer>

                    <!-- Bottom Precision Composer -->
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <Border x:Name="LocalChatPendingImgBorder" Visibility="Collapsed" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6" x:FieldModifier="internal">
                            <DockPanel>
                                <Button x:Name="LocalChatClearImgBtn" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="6,3" ToolTip="Убрать прикреплённое изображение" Click="LocalChatClearImgBtn_Click" x:FieldModifier="internal">
                                    <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconClose}" />
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="42" Height="42" CornerRadius="3" ClipToBounds="True" Margin="0,0,9,0" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1">
                                        <Image x:Name="LocalChatPendingImg" Stretch="UniformToFill" x:FieldModifier="internal" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="LocalChatPendingImgName" Text="image.png" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" x:FieldModifier="internal" />
                                        <TextBlock Text="Готово к отправке в Vision-модель" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <DockPanel Margin="0,0,0,5">
                            <CheckBox x:Name="LocalChatWebSearchCheck" Content="Поиск в сети" IsChecked="False" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,2,0" ToolTip="Подгружать свежие источники из интернета перед ответом" x:FieldModifier="internal" />
                            <TextBlock x:Name="LocalChatStatsText" Text="Enter — отправить · Shift+Enter — строка · Ctrl+V — скриншот" FontSize="11.5" FontFamily="{StaticResource MonoFontFamily}" Typography.NumeralAlignment="Tabular" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" x:FieldModifier="internal" />
                        </DockPanel>

                        <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Bottom">
                                    <Button x:Name="LocalChatAttachImgBtn" Style="{StaticResource GhostButton}" Padding="9,8" Margin="0,0,2,0" ToolTip="Прикрепить изображение (Vision) или Ctrl+V" Click="LocalChatAttachImgBtn_Click" x:FieldModifier="internal">
                                        <Path Style="{StaticResource UiIcon16}" Data="{StaticResource IconImagePlus}" />
                                    </Button>
                                    <Button x:Name="LocalChatMicBtn" Style="{StaticResource GhostButton}" Padding="9,8" ToolTip="Голосовой ввод (локальный Whisper STT)" Click="LocalChatMicBtn_Click" x:FieldModifier="internal">
                                        <Path Style="{StaticResource UiIcon16}" Data="{StaticResource IconMic}" />
                                    </Button>
                                </StackPanel>

                                <TextBox x:Name="LocalChatInputBox" Grid.Column="1" MinHeight="38" MaxHeight="116" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource AccentBrush}" BorderThickness="0" Padding="6,8" FontSize="13.5" PreviewKeyDown="LocalChatInputBox_PreviewKeyDown" x:FieldModifier="internal" />

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="6,0,0,0">
                                    <Button x:Name="LocalChatSendBtn" Content="Отправить" Style="{StaticResource SuccessButton}" Padding="16,8" Click="LocalChatSendBtn_Click" x:FieldModifier="internal" />
                                    <Button x:Name="LocalChatStopBtn" Style="{StaticResource DangerButton}" Padding="12,8" Margin="5,0,0,0" Visibility="Collapsed" Click="LocalChatStopBtn_Click" x:FieldModifier="internal">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconStop}" Margin="0,0,6,0" />
                                            <TextBlock Text="Стоп" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
