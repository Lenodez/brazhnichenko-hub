<UserControl x:Class="LocalAIHub.Views.VideoTabView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Video Sub-mode Switcher -->
                    <WrapPanel Grid.Row="0" Margin="0,0,0,9">
                        <Button x:Name="VideoModeSingleBtn" Content="Одиночное видео (3–5 сек)" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="VideoModeSingleBtn_Click" x:FieldModifier="internal" />
                        <Button x:Name="VideoModeStoryBtn" Content="Видео-история (длинный ролик)" Style="{StaticResource DarkButton}" Click="VideoModeStoryBtn_Click" x:FieldModifier="internal" />
                    </WrapPanel>

                    <!-- Video Sub-view A: Single Video (with Built-in AI Director + Preview) -->
                    <Grid x:Name="VideoSingleGrid" Grid.Row="1" x:FieldModifier="internal">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="460" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                            <StackPanel>
                                <!-- Prerequisite warning banner -->
                                <Border x:Name="VideoMissingBanner" Visibility="Collapsed" Background="#241F12" BorderBrush="#C79C2B" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,10" x:FieldModifier="internal">
                                    <DockPanel>
                                        <Button x:Name="VideoMissingActionBtn" Content="Перейти в Каталог →" Style="{StaticResource SuccessButton}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0" Padding="11,5" Click="VideoMissingActionBtn_Click" x:FieldModifier="internal" />
                                        <TextBlock x:Name="VideoMissingText" Text="—" FontSize="12" Foreground="#FFE28A" TextWrapping="Wrap" VerticalAlignment="Center" x:FieldModifier="internal" />
                                    </DockPanel>
                                </Border>

                                <!-- Video Options -->
                                <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10" AllowDrop="True" DragOver="ImageDrop_DragOver" Drop="VideoStartDrop_Drop">
                                    <StackPanel>
                                        <WrapPanel Margin="0,0,0,9">
                                            <StackPanel Margin="0,0,10,6">
                                                <TextBlock Text="Модель видео" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                                <ComboBox x:Name="StudioVideoEngineCombo" Width="260" FontSize="12" SelectedIndex="0" SelectionChanged="StudioEngineCombo_Changed" x:FieldModifier="internal">
                                                    <ComboBoxItem Content="Wan 2.2 14B FP8 (DynamicVRAM)" Tag="wan14b_fp8" />
                                                    <ComboBoxItem Content="Wan 2.2 14B Q4 (4 шага, GGUF)" Tag="wan14b" />
                                                    <ComboBoxItem Content="Wan 2.2 14B Q6 (4 шага, GGUF)" Tag="wan14b_q6" />
                                                    <ComboBoxItem Content="LTX-2.5 (Видео + Звук)" Tag="ltx25" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,6">
                                                <TextBlock Text="Размер" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                                <ComboBox x:Name="StudioVideoSizeCombo" Width="108" FontSize="12" SelectedIndex="0" x:FieldModifier="internal">
                                                    <ComboBoxItem Content="832 × 480" Tag="832x480" />
                                                    <ComboBoxItem Content="480 × 832" Tag="480x832" />
                                                    <ComboBoxItem Content="640 × 640" Tag="640x640" />
                                                    <ComboBoxItem Content="768 × 448" Tag="768x448" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,6">
                                                <TextBlock Text="Длина" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                                <ComboBox x:Name="StudioVideoDurCombo" Width="74" FontSize="12" SelectedIndex="1" x:FieldModifier="internal">
                                                    <ComboBoxItem Content="3 сек" Tag="3" />
                                                    <ComboBoxItem Content="4 сек" Tag="4" />
                                                    <ComboBoxItem Content="5 сек" Tag="5" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,6">
                                                <TextBlock Text="Seed (-1)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                                <TextBox x:Name="StudioVideoSeedBox" Text="-1" Width="92" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="7,0" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                            </StackPanel>
                                        </WrapPanel>

                                        <DockPanel Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                <Border x:Name="StudioVideoStartThumbBorder" Visibility="Collapsed" Width="42" Height="42" CornerRadius="6" BorderBrush="#3B5B99" BorderThickness="1" ClipToBounds="True" Margin="0,0,8,0" Cursor="Hand" ToolTip="Кликни, чтобы открыть стартовый кадр" MouseLeftButtonUp="StudioVideoStartThumb_Click" x:FieldModifier="internal">
                                                    <Image x:Name="StudioVideoStartThumbImage" Stretch="UniformToFill" x:FieldModifier="internal" />
                                                </Border>
                                                <Button Content="Стартовое фото (I2V)" Style="{StaticResource DarkButton}" Padding="10,5" FontSize="12" Click="StudioPickVideoStartBtn_Click" Margin="0,0,6,0" />
                                                <Button Style="{StaticResource DarkButton}" Padding="9,5" FontSize="12" Click="StudioPasteVideoStartBtn_Click" Margin="0,0,6,0" ToolTip="Вставить стартовый кадр I2V из буфера обмена (также работает Ctrl+V)"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconClipboard}" Margin="0,0,6,0" /><TextBlock Text="Из буфера" VerticalAlignment="Center" /></StackPanel></Button>
                                                <Button x:Name="StudioClearVideoStartBtn" Content="×" Style="{StaticResource DarkButton}" Padding="8,5" FontSize="12" Visibility="Collapsed" Click="StudioClearVideoStartBtn_Click" x:FieldModifier="internal" />
                                            </StackPanel>
                                            <TextBlock x:Name="StudioVideoStartLabel" Text="Без фото (перетащи фото сюда, Ctrl+V или выбери для I2V)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" x:FieldModifier="internal" />
                                        </DockPanel>

                                        <!-- P2 Progressive Disclosure: End Frame, Extra LoRAs & Presets -->
                                        <Expander x:Name="VideoAdvancedExpander" Style="{StaticResource StudioExpanderStyle}" IsExpanded="False" Margin="0,4,0,0" x:FieldModifier="internal">
                                            <Expander.Header>
                                                <DockPanel>
                                                    <Button Content="?" Style="{StaticResource DarkButton}" Padding="8,2" FontSize="11" DockPanel.Dock="Right" Margin="8,0,8,0" ToolTip="Спросить AI-Помощника про настройки Видео, I2V, SVI и High/Low LoRA" Click="AskAiVideoSettingsBtn_Click" />
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconSliders}" Margin="0,0,7,0" />
                                                        <TextBlock Text="Конечный кадр, Доп. LoRA и пресеты Видео" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Expander.Header>
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,9">
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                        <Border x:Name="StudioVideoEndThumbBorder" Visibility="Collapsed" Width="42" Height="42" CornerRadius="6" BorderBrush="#3B5B99" BorderThickness="1" ClipToBounds="True" Margin="0,0,8,0" Cursor="Hand" ToolTip="Кликни, чтобы открыть конечный кадр" MouseLeftButtonUp="StudioVideoEndThumb_Click" x:FieldModifier="internal">
                                                            <Image x:Name="StudioVideoEndThumbImage" Stretch="UniformToFill" x:FieldModifier="internal" />
                                                        </Border>
                                                        <Button Content="Конечный кадр (опц.)" Style="{StaticResource DarkButton}" Padding="10,5" FontSize="12" Click="StudioPickVideoEndBtn_Click" Margin="0,0,6,0" />
                                                        <Button Style="{StaticResource DarkButton}" Padding="9,5" FontSize="12" Click="StudioPasteVideoEndBtn_Click" Margin="0,0,6,0" ToolTip="Вставить конечный кадр First→Last из буфера обмена (также Ctrl+Shift+V)">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconClipboard}" Margin="0,0,5,0" />
                                                                <TextBlock Text="Из буфера" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button x:Name="StudioClearVideoEndBtn" Style="{StaticResource DarkButton}" Padding="8,5" FontSize="12" Visibility="Collapsed" Click="StudioClearVideoEndBtn_Click" x:FieldModifier="internal">
                                                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconClose}" />
                                                        </Button>
                                                    </StackPanel>
                                                    <TextBlock x:Name="StudioVideoEndLabel" Text="Не задан (свободный финал)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" x:FieldModifier="internal" />
                                                </DockPanel>

                                                <!-- Custom Extra LoRAs for Video (Wan 2.2 High/Low + LTX-2.5) -->
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock Text="Доп. LoRA (Wan 2.2: High + Low • LTX-2.5: только High • также для Видео-истории)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                                                        <Button Style="{StaticResource DarkButton}" Padding="7,3" FontSize="11" ToolTip="Обновить список LoRA" Click="RefreshLorasBtn_Click" Margin="0,0,4,0">
                                                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconRefresh}" />
                                                        </Button>
                                                        <Button Content="Папка LoRA" Style="{StaticResource DarkButton}" Padding="8,3" FontSize="11" ToolTip="Открыть ComfyUI\models\loras" Click="OpenLorasFolderBtn_Click" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <DockPanel Margin="0,0,0,5">
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <Slider x:Name="VideoExtraLoraHighSlider" Width="76" Minimum="0.1" Maximum="1.5" Value="0.75" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="LoraSlider_ValueChanged" x:FieldModifier="internal" />
                                                        <TextBlock x:Name="VideoExtraLoraHighValText" Text="0.75" Width="34" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" Typography.NumeralAlignment="Tabular" Foreground="#CFE0FF" VerticalAlignment="Center" Margin="5,0,0,0" x:FieldModifier="internal" />
                                                    </StackPanel>
                                                    <DockPanel VerticalAlignment="Center">
                                                        <TextBlock Text="High:" Width="36" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                                        <ComboBox x:Name="VideoExtraLoraHighCombo" FontSize="12" SelectedIndex="0" x:FieldModifier="internal" />
                                                    </DockPanel>
                                                </DockPanel>
                                                <DockPanel>
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <Slider x:Name="VideoExtraLoraLowSlider" Width="76" Minimum="0.1" Maximum="1.5" Value="0.75" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="LoraSlider_ValueChanged" x:FieldModifier="internal" />
                                                        <TextBlock x:Name="VideoExtraLoraLowValText" Text="0.75" Width="34" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" Typography.NumeralAlignment="Tabular" Foreground="#CFE0FF" VerticalAlignment="Center" Margin="5,0,0,0" x:FieldModifier="internal" />
                                                    </StackPanel>
                                                    <DockPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Low:" Width="36" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                                        <ComboBox x:Name="VideoExtraLoraLowCombo" FontSize="12" SelectedIndex="0" x:FieldModifier="internal" />
                                                    </DockPanel>
                                                </DockPanel>

                                                <!-- Video Studio Presets -->
                                                <DockPanel Margin="0,8,0,0">
                                                    <TextBlock Text="Пресет:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,7,0" DockPanel.Dock="Left" />
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0">
                                                        <Button Content="Применить" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="12" Margin="0,0,5,0" Click="VideoPresetApplyBtn_Click" />
                                                        <Button Content="Сохранить" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="12" Margin="0,0,5,0" Click="VideoPresetSaveBtn_Click" />
                                                        <Button Style="{StaticResource DarkButton}" Padding="8,4" FontSize="12" ToolTip="Удалить пресет" Click="VideoPresetDeleteBtn_Click">
                                                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconClose}" />
                                                        </Button>
                                                    </StackPanel>
                                                    <ComboBox x:Name="VideoPresetCombo" FontSize="12" SelectionChanged="VideoPresetCombo_SelectionChanged" x:FieldModifier="internal" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>

                                <!-- Video Prompt + Built-in AI Director + Discussion + Motion/Audio Chips -->
                                <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,5">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Button x:Name="VideoMicBtn" Style="{StaticResource DarkButton}" Padding="8,5" FontSize="12" Margin="0,0,6,0" ToolTip="Надиктовать идею сцены голосом (локальный Whisper STT)" Click="VideoMicBtn_Click" x:FieldModifier="internal">
                                                    <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconMic}" />
                                                </Button>
                                                <Button x:Name="VideoHistoryBtn" Style="{StaticResource DarkButton}" Padding="9,5" FontSize="12" Margin="0,0,6,0" ToolTip="Недавние и избранные промпты" Click="VideoHistoryBtn_Click" x:FieldModifier="internal"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconHistory}" Margin="0,0,6,0" /><TextBlock Text="История" VerticalAlignment="Center" /></StackPanel></Button>
                                                <Button Style="{StaticResource DarkButton}" Padding="8,5" FontSize="12" Margin="0,0,0,0" ToolTip="Копировать промпт" Click="VideoCopyPromptBtn_Click"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconCopy}" /></Button>
                                            </StackPanel>
                                            <TextBlock Text="Промпт видео (пиши по-русски или по-английски)" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,7">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <ComboBox x:Name="VideoSingleDirectorModelCombo" Width="152" FontSize="11" Margin="0,0,6,0" ToolTip="Модель LLM для Режиссёра" SelectionChanged="DirectorModelCombo_SelectionChanged" x:FieldModifier="internal" />
                                                <Button x:Name="VideoSingleDiscussBtn" Style="{StaticResource DarkButton}" Padding="10,5" FontSize="12" Margin="0,0,6,0" ToolTip="Обсудить сцену с Режиссёром (движение камеры, свет, действие) и собрать точный промпт" Click="VideoSingleDiscussBtn_Click" x:FieldModifier="internal"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconChat}" Margin="0,0,6,0" /><TextBlock Text="Обсудить" VerticalAlignment="Center" /></StackPanel></Button>
                                                <Button x:Name="VideoEnhanceDirectorBtn" Style="{StaticResource PrimaryButton}" Padding="11,5" FontSize="12" Click="VideoEnhanceDirectorBtn_Click" x:FieldModifier="internal"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconSparkles}" Margin="0,0,6,0" /><TextBlock Text="Улучшить" VerticalAlignment="Center" /></StackPanel></Button>
                                            </StackPanel>
                                            <TextBlock Text="«Обсудить» — уточнить камеру, свет и действие • «Улучшить» — сразу собрать промпт (I2V/T2V)." FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBox x:Name="VideoPromptBox" Height="106" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="10,8" FontSize="13" Text="Smooth cinematic dolly-in shot of a cozy wooden cabin by a misty northern lake at golden hour, gentle ripples across the calm water, soft smoke rising from the chimney, warm glowing windows" x:FieldModifier="internal" />

                                        <!-- Collapsible Single Video Director Discussion Panel -->
                                        <Border x:Name="SingleVideoDirectorChatPanel" Visibility="Collapsed" Background="#0E1421" BorderBrush="#293A5E" BorderThickness="1" CornerRadius="8" Padding="10,9" Margin="0,8,0,0" x:FieldModifier="internal">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock Text="Обсуждение сцены с Режиссёром • Enter — отправить • Shift+Enter — новая строка" FontSize="12" Foreground="#8FA8D6" VerticalAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                        <Button Content="Очистить" Style="{StaticResource DarkButton}" Padding="8,2" FontSize="11" Margin="0,0,5,0" Click="SingleVideoDirectorClearChatBtn_Click" />
                                                        <Button Content="Свернуть ×" Style="{StaticResource DarkButton}" Padding="8,2" FontSize="11" Click="SingleVideoDirectorHideChatBtn_Click" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <Border Background="#090C13" BorderBrush="#232D42" BorderThickness="1" CornerRadius="7" Padding="8,6" Margin="0,0,0,7">
                                                    <ScrollViewer x:Name="SingleVideoDirectorChatScroll" MaxHeight="210" VerticalScrollBarVisibility="Auto" x:FieldModifier="internal">
                                                        <StackPanel x:Name="SingleVideoDirectorMessagesPanel" x:FieldModifier="internal" />
                                                    </ScrollViewer>
                                                </Border>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="SingleVideoDirectorReplyBox" Grid.Column="0" MinHeight="38" MaxHeight="104" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="#2E3B56" Padding="9,7" FontSize="13" Margin="0,0,7,0" ToolTip="Enter — отправить • Shift+Enter — перенос строки" PreviewKeyDown="SingleVideoDirectorReplyBox_PreviewKeyDown" x:FieldModifier="internal" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                        <Button x:Name="SingleVideoDirectorSendBtn" Content="Отправить" Style="{StaticResource DarkButton}" Height="38" Padding="12,0" Margin="0,0,6,0" Click="SingleVideoDirectorSendBtn_Click" x:FieldModifier="internal" />
                                                        <Button x:Name="SingleVideoDirectorApplyBtn" Style="{StaticResource SuccessButton}" Height="38" Padding="12,0" Click="SingleVideoDirectorApplyBtn_Click" x:FieldModifier="internal"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconSparkles}" Margin="0,0,6,0" /><TextBlock Text="Собрать в промпт" VerticalAlignment="Center" /></StackPanel></Button>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <WrapPanel x:Name="VideoChipsPanel" Margin="0,8,0,0" x:FieldModifier="internal" />
                                    </StackPanel>
                                </Border>

                                <!-- Action Row -->
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <Button x:Name="VideoGenerateBtn" Content="Сгенерировать видео" Style="{StaticResource SuccessButton}" Padding="20,10" FontSize="14" FontWeight="SemiBold" Click="VideoGenerateBtn_Click" x:FieldModifier="internal" />
                                        <Button x:Name="VideoEnqueueBtn" Content="+ В очередь" Style="{StaticResource DarkButton}" Padding="13,10" FontSize="13" Margin="8,0,0,0" Click="VideoEnqueueBtn_Click" x:FieldModifier="internal" />
                                    </StackPanel>
                                    <Button x:Name="VideoUseLastSeedBtn" Content="Повторить последний Seed" Style="{StaticResource DarkButton}" Padding="11,8" FontSize="12" HorizontalAlignment="Right" Visibility="Collapsed" Click="VideoUseLastSeedBtn_Click" x:FieldModifier="internal" />
                                </DockPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Right: Video Result Preview -->
                        <Border Grid.Column="1" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Результат видео" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Content="Папка" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="12" HorizontalAlignment="Right" Click="StudioOpenOutputFolderBtn_Click" />
                                </DockPanel>

                                <Border x:Name="VideoPreviewBorder" Grid.Row="1" Background="{StaticResource WellBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Cursor="Hand" MouseLeftButtonUp="VideoPreviewBorder_Click" x:FieldModifier="internal">
                                    <Grid>
                                        <Image x:Name="VideoPreviewImage" Stretch="Uniform" Visibility="Collapsed" x:FieldModifier="internal" />
                                        <TextBlock x:Name="VideoPreviewPlaceholder" Text="Здесь появится кадр&#xA;готового видео" TextAlignment="Center" Foreground="#6B7794" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" x:FieldModifier="internal" />
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="VideoResultMetaText" Grid.Row="2" Text="Ожидание генерации..." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,8" x:FieldModifier="internal" />

                                <StackPanel Grid.Row="3">
                                    <WrapPanel>
                                        <Button x:Name="VideoOpenResultBtn" Content="▶ Смотреть видео" Style="{StaticResource PrimaryButton}" Padding="12,6" FontSize="12" Margin="0,0,6,6" Visibility="Collapsed" Click="VideoOpenResultBtn_Click" x:FieldModifier="internal" />
                                    </WrapPanel>

                                    <!-- Local TTS Voiceover for Video -->
                                    <Expander x:Name="VideoTtsExpander" Style="{StaticResource StudioExpanderStyle}" IsExpanded="False" Margin="0,4,0,0" x:FieldModifier="internal">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconVolume}" Margin="0,0,6,0" />
                                                <TextBlock Text="Озвучка видео (Локальный TTS)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel>
                                            <ComboBox x:Name="VideoTtsVoiceCombo" FontSize="12" Margin="0,0,0,6" DisplayMemberPath="DisplayName" x:FieldModifier="internal" />
                                            <TextBox x:Name="VideoTtsTextBox" Height="56" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,6" FontSize="12" Margin="0,0,0,6" ToolTip="Текст диктора для озвучки ролика (на русском или английском)" x:FieldModifier="internal" />
                                            <WrapPanel>
                                                <Button x:Name="VideoTtsPreviewBtn" Style="{StaticResource DarkButton}" Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="VideoTtsPreviewBtn_Click" x:FieldModifier="internal">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconVolume}" Margin="0,0,5,0" />
                                                        <TextBlock Text="Прослушать" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="VideoTtsMuxBtn" Style="{StaticResource SuccessButton}" Padding="10,5" FontSize="12" Click="VideoTtsMuxBtn_Click" x:FieldModifier="internal">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconVideo}" Margin="0,0,5,0" />
                                                        <TextBlock Text="Наложить на видео" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Video Sub-view B: Video Story (with Built-in AI Scenario Director!) -->
                    <Grid x:Name="VideoStoryView" Grid.Row="1" Visibility="Collapsed" x:FieldModifier="internal">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Built-in Interactive AI Director for Video Story -->
                        <Border Grid.Row="0" Background="#151D2E" BorderBrush="#35528A" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,9">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock Text="AI-Режиссёр видео-истории («Уточнить» вопросами или «Собрать» и дорабатывать этапы)" FontSize="12" FontWeight="SemiBold" Foreground="#8AB4FF" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="LLM:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <ComboBox x:Name="VideoStoryDirectorModelCombo" Width="205" FontSize="12" Margin="0,0,10,0" ToolTip="Модель LLM для Режиссёра" SelectionChanged="DirectorModelCombo_SelectionChanged" x:FieldModifier="internal" />
                                        <CheckBox x:Name="VideoDirectorLoopCheck" Content="Цикл" IsChecked="False" Foreground="#C8D4EA" FontSize="12" VerticalAlignment="Center" ToolTip="Замкнуть финал обратно в Шаг 0" x:FieldModifier="internal" />
                                    </StackPanel>
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="VideoDirectorIdeaBox" Grid.Column="0" Height="34" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="9,0" FontSize="13" Margin="0,0,8,0" Text="Смешной мультяшный попугай корелла на кухне утром крадёт круассан со стола, гордо позирует и улетает с крошками" x:FieldModifier="internal" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox x:Name="VideoDirectorOrientCombo" Width="86" FontSize="12" SelectedIndex="0" Margin="0,0,6,0" Height="34" x:FieldModifier="internal">
                                            <ComboBoxItem Content="Авто" Tag="auto" />
                                            <ComboBoxItem Content="16:9" Tag="16:9" />
                                            <ComboBoxItem Content="9:16" Tag="9:16" />
                                            <ComboBoxItem Content="1:1" Tag="1:1" />
                                        </ComboBox>
                                        <ComboBox x:Name="VideoDirectorCountCombo" Width="74" FontSize="12" SelectedIndex="1" Margin="0,0,6,0" Height="34" x:FieldModifier="internal">
                                            <ComboBoxItem Content="2 сц." Tag="2" />
                                            <ComboBoxItem Content="3 сц." Tag="3" />
                                            <ComboBoxItem Content="4 сц." Tag="4" />
                                            <ComboBoxItem Content="5 сц." Tag="5" />
                                            <ComboBoxItem Content="6 сц." Tag="6" />
                                        </ComboBox>
                                        <Button x:Name="VideoDirectorDiscussBtn" Style="{StaticResource DarkButton}" Height="34" Padding="11,0" Margin="0,0,6,0" ToolTip="Режиссёр задаст 2 уточняющих вопроса, чтобы сделать сюжет острым и конкретным" Click="VideoDirectorDiscussBtn_Click" x:FieldModifier="internal"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconChat}" Margin="0,0,6,0" /><TextBlock Text="Уточнить" VerticalAlignment="Center" /></StackPanel></Button>
                                        <Button x:Name="VideoDirectorBuildBtn" Style="{StaticResource PrimaryButton}" Height="34" Padding="12,0" Click="VideoDirectorBuildBtn_Click" x:FieldModifier="internal"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconSparkles}" Margin="0,0,6,0" /><TextBlock Text="Собрать сценарий" VerticalAlignment="Center" /></StackPanel></Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Collapsible Director Discussion & Stage Revision Chat -->
                                <Border x:Name="VideoDirectorChatPanel" Visibility="Collapsed" Background="#0E1421" BorderBrush="#293A5E" BorderThickness="1" CornerRadius="8" Padding="10,9" Margin="0,8,0,0" x:FieldModifier="internal">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Диалог с Режиссёром • Enter — отправить • Shift+Enter — новая строка" FontSize="12" Foreground="#8FA8D6" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                <Button Content="Очистить" Style="{StaticResource DarkButton}" Padding="8,2" FontSize="11" Margin="0,0,5,0" Click="VideoDirectorClearChatBtn_Click" />
                                                <Button Content="Свернуть ×" Style="{StaticResource DarkButton}" Padding="8,2" FontSize="11" Click="VideoDirectorHideChatBtn_Click" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Background="#090C13" BorderBrush="#232D42" BorderThickness="1" CornerRadius="7" Padding="8,6" Margin="0,0,0,7">
                                            <ScrollViewer x:Name="VideoDirectorChatScroll" MaxHeight="200" VerticalScrollBarVisibility="Auto" x:FieldModifier="internal">
                                                <StackPanel x:Name="VideoDirectorMessagesPanel" x:FieldModifier="internal" />
                                            </ScrollViewer>
                                        </Border>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="VideoDirectorReplyBox" Grid.Column="0" MinHeight="38" MaxHeight="104" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="#2E3B56" Padding="9,7" FontSize="13" Margin="0,0,7,0" ToolTip="Enter — отправить сообщение • Shift+Enter — перенос строки" PreviewKeyDown="VideoDirectorReplyBox_PreviewKeyDown" x:FieldModifier="internal" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                <Button x:Name="VideoDirectorSendReplyBtn" Content="Отправить" Style="{StaticResource DarkButton}" Height="38" Padding="12,0" Margin="0,0,6,0" Click="VideoDirectorSendReplyBtn_Click" x:FieldModifier="internal" />
                                                <Button x:Name="VideoDirectorReviseBtn" Content="Обновить этапы" Style="{StaticResource SuccessButton}" Height="38" Padding="12,0" Click="VideoDirectorReviseBtn_Click" x:FieldModifier="internal" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Video Story Toolbar -->
                        <Border Grid.Row="1" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,9">
                            <DockPanel LastChildFill="False">
                                <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="Движок:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox x:Name="VideoStoryEngineCombo" Width="230" FontSize="12" SelectedIndex="0" Margin="0,0,10,0" x:FieldModifier="internal">
                                        <ComboBoxItem Content="Wan 2.2 14B FP8 (DynamicVRAM)" Tag="wan14b_fp8" />
                                        <ComboBoxItem Content="Wan 2.2 14B Q4 (4 шага, GGUF)" Tag="wan14b" />
                                        <ComboBoxItem Content="Wan 2.2 14B Q6 (4 шага, GGUF)" Tag="wan14b_q6" />
                                        <ComboBoxItem Content="LTX-2.5 (Видео + Звук)" Tag="ltx25" />
                                    </ComboBox>
                                    <TextBlock Text="Размер:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox x:Name="VideoStorySizeCombo" Width="102" FontSize="12" SelectedIndex="0" Margin="0,0,10,0" x:FieldModifier="internal">
                                        <ComboBoxItem Content="832 × 480" Tag="832x480" />
                                        <ComboBoxItem Content="480 × 832" Tag="480x832" />
                                        <ComboBoxItem Content="640 × 640" Tag="640x640" />
                                        <ComboBoxItem Content="768 × 448" Tag="768x448" />
                                    </ComboBox>
                                    <TextBlock Text="Клип:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox x:Name="VideoStoryDurCombo" Width="66" FontSize="12" SelectedIndex="1" x:FieldModifier="internal">
                                        <ComboBoxItem Content="3 сек" Tag="3" />
                                        <ComboBoxItem Content="4 сек" Tag="4" />
                                        <ComboBoxItem Content="5 сек" Tag="5" />
                                    </ComboBox>
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button x:Name="RunVideoPipelineBtn" Content="▶ Запустить пайплайн" Style="{StaticResource SuccessButton}" Padding="11,6" Click="RunVideoPipelineBtn_Click" Margin="0,0,6,0" x:FieldModifier="internal" />
                                    <Button Content="+ Этап" Style="{StaticResource PrimaryButton}" Padding="10,6" Click="AddVideoStageBtn_Click" Margin="0,0,6,0" />
                                    <Button x:Name="MergeVideoStoryBtn" Content="Склеить MP4" Style="{StaticResource DarkButton}" Padding="10,6" Click="MergeVideoStoryBtn_Click" Margin="0,0,6,0" x:FieldModifier="internal" />
                                    <Button Content="Новая" Style="{StaticResource DarkButton}" Padding="10,6" Click="ResetVideoStoryBtn_Click" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <StackPanel x:Name="VideoStagesPanel" x:FieldModifier="internal" />
                        </ScrollViewer>
                    </Grid>
                </Grid></UserControl>