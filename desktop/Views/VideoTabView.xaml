<UserControl x:Class="LocalAIHub.Views.VideoTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Clean Segmented Video Mode Bar -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,9" Margin="0,0,0,10">
            <WrapPanel>
                <Button x:Name="VideoModeSingleBtn" Content="Одиночный клип (3–5 сек)" Style="{StaticResource PrimaryButton}" Padding="12,5" Margin="0,0,6,0" Click="VideoModeSingleBtn_Click" x:FieldModifier="internal" />
                <Button x:Name="VideoModeStoryBtn" Content="Видео-история (Пайплайн сцен)" Style="{StaticResource DarkButton}" Padding="12,5" Click="VideoModeStoryBtn_Click" x:FieldModifier="internal" />
            </WrapPanel>
        </Border>

        <!-- Video Sub-view A: Balanced 52/48 Studio Split -->
        <Grid x:Name="VideoSingleGrid" Grid.Row="1" x:FieldModifier="internal">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52*" MinWidth="430" />
                <ColumnDefinition Width="48*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                <StackPanel>
                    <Border x:Name="VideoMissingBanner" Visibility="Collapsed" Background="#24190B" BorderBrush="#9A6718" BorderThickness="1" CornerRadius="5" Padding="12,9" Margin="0,0,0,10" x:FieldModifier="internal">
                        <DockPanel>
                            <Button x:Name="VideoMissingActionBtn" Content="Открыть Каталог →" Style="{StaticResource SuccessButton}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0" Padding="11,5" Click="VideoMissingActionBtn_Click" x:FieldModifier="internal" />
                            <TextBlock x:Name="VideoMissingText" Text="—" FontSize="12" Foreground="#FCD34D" TextWrapping="Wrap" VerticalAlignment="Center" x:FieldModifier="internal" />
                        </DockPanel>
                    </Border>

                    <!-- Video Parameters -->
                    <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="5" Padding="13" Margin="0,0,0,10" AllowDrop="True" DragOver="ImageDrop_DragOver" Drop="VideoStartDrop_Drop">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <StackPanel Margin="0,0,10,6">
                                    <TextBlock Text="МОДЕЛЬ ВИДЕО" FontSize="10.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <ComboBox x:Name="StudioVideoEngineCombo" Width="244" FontSize="12" SelectedIndex="0" SelectionChanged="StudioEngineCombo_Changed" x:FieldModifier="internal">
                                        <ComboBoxItem Content="Wan 2.2 14B FP8 (DynamicVRAM)" Tag="wan14b_fp8" />
                                        <ComboBoxItem Content="Wan 2.2 14B Q4 (4 шага, GGUF)" Tag="wan14b" />
                                        <ComboBoxItem Content="Wan 2.2 14B Q6 (4 шага, GGUF)" Tag="wan14b_q6" />
                                        <ComboBoxItem Content="LTX-2.5 (Видео + Звук)" Tag="ltx25" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,6">
                                    <TextBlock Text="ФОРМАТ" FontSize="10.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <ComboBox x:Name="StudioVideoSizeCombo" Width="106" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" SelectedIndex="0" x:FieldModifier="internal">
                                        <ComboBoxItem Content="832 × 480" Tag="832x480" />
                                        <ComboBoxItem Content="480 × 832" Tag="480x832" />
                                        <ComboBoxItem Content="640 × 640" Tag="640x640" />
                                        <ComboBoxItem Content="768 × 448" Tag="768x448" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,6">
                                    <TextBlock Text="ДЛИНА" FontSize="10.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <ComboBox x:Name="StudioVideoDurCombo" Width="74" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" SelectedIndex="1" x:FieldModifier="internal">
                                        <ComboBoxItem Content="3 сек" Tag="3" />
                                        <ComboBoxItem Content="4 сек" Tag="4" />
                                        <ComboBoxItem Content="5 сек" Tag="5" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="SEED (-1)" FontSize="10.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <TextBox x:Name="StudioVideoSeedBox" Text="-1" Width="90" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="7,0" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" x:FieldModifier="internal" />
                                </StackPanel>
                            </WrapPanel>

                            <DockPanel Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <Border x:Name="StudioVideoStartThumbBorder" Visibility="Collapsed" Width="40" Height="40" CornerRadius="4" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" ClipToBounds="True" Margin="0,0,8,0" Cursor="Hand" ToolTip="Открыть стартовый кадр" MouseLeftButtonUp="StudioVideoStartThumb_Click" x:FieldModifier="internal">
                                        <Image x:Name="StudioVideoStartThumbImage" Stretch="UniformToFill" x:FieldModifier="internal" />
                                    </Border>
                                    <Button Content="+ Стартовый кадр (I2V)" Style="{StaticResource DarkButton}" Padding="10,5" FontSize="12" Click="StudioPickVideoStartBtn_Click" Margin="0,0,6,0" />
                                    <Button Style="{StaticResource DarkButton}" Padding="9,5" FontSize="12" Click="StudioPasteVideoStartBtn_Click" Margin="0,0,6,0" ToolTip="Вставить стартовый кадр из буфера обмена (Ctrl+V)">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconClipboard}" Margin="0,0,5,0" />
                                            <TextBlock Text="Буфер" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="StudioClearVideoStartBtn" Content="×" Style="{StaticResource DarkButton}" Padding="8,5" FontSize="12" Visibility="Collapsed" Click="StudioClearVideoStartBtn_Click" x:FieldModifier="internal" />
                                </StackPanel>
                                <TextBlock x:Name="StudioVideoStartLabel" Text="Без кадра (чистый T2V или перетащите фото)" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" x:FieldModifier="internal" />
                            </DockPanel>

                            <Expander x:Name="VideoAdvancedExpander" Style="{StaticResource StudioExpanderStyle}" IsExpanded="False" Margin="0,4,0,0" x:FieldModifier="internal">
                                <Expander.Header>
                                    <DockPanel>
                                        <Button Content="?" Style="{StaticResource DarkButton}" Padding="8,2" FontSize="11" DockPanel.Dock="Right" Margin="8,0,8,0" ToolTip="Справка по параметрам Видео и High/Low LoRA" Click="AskAiVideoSettingsBtn_Click" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconSliders}" Margin="0,0,7,0" />
                                            <TextBlock Text="Конечный кадр, LoRA (High/Low) и пресеты" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,9">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <Border x:Name="StudioVideoEndThumbBorder" Visibility="Collapsed" Width="40" Height="40" CornerRadius="4" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" ClipToBounds="True" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="StudioVideoEndThumb_Click" x:FieldModifier="internal">
                                                <Image x:Name="StudioVideoEndThumbImage" Stretch="UniformToFill" x:FieldModifier="internal" />
                                            </Border>
                                            <Button Content="+ Конечный кадр" Style="{StaticResource DarkButton}" Padding="10,5" FontSize="12" Click="StudioPickVideoEndBtn_Click" Margin="0,0,6,0" />
                                            <Button Style="{StaticResource DarkButton}" Padding="9,5" FontSize="12" Click="StudioPasteVideoEndBtn_Click" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconClipboard}" Margin="0,0,5,0" />
                                                    <TextBlock Text="Буфер" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="StudioClearVideoEndBtn" Style="{StaticResource DarkButton}" Padding="8,5" FontSize="12" Visibility="Collapsed" Click="StudioClearVideoEndBtn_Click" x:FieldModifier="internal">
                                                <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconClose}" />
                                            </Button>
                                        </StackPanel>
                                        <TextBlock x:Name="StudioVideoEndLabel" Text="Свободный финал" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" x:FieldModifier="internal" />
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="ДОП. LoRA (WAN 2.2 HIGH + LOW)" FontSize="10.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                                            <Button Style="{StaticResource DarkButton}" Padding="7,3" FontSize="11" Click="RefreshLorasBtn_Click" Margin="0,0,4,0">
                                                <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconRefresh}" />
                                            </Button>
                                            <Button Content="Папка LoRA" Style="{StaticResource DarkButton}" Padding="8,3" FontSize="11" Click="OpenLorasFolderBtn_Click" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,5">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Slider x:Name="VideoExtraLoraHighSlider" Width="76" Minimum="0.1" Maximum="1.5" Value="0.75" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="LoraSlider_ValueChanged" x:FieldModifier="internal" />
                                            <TextBlock x:Name="VideoExtraLoraHighValText" Text="0.75" Width="34" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" Typography.NumeralAlignment="Tabular" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0" x:FieldModifier="internal" />
                                        </StackPanel>
                                        <DockPanel VerticalAlignment="Center">
                                            <TextBlock Text="HIGH:" Width="42" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                            <ComboBox x:Name="VideoExtraLoraHighCombo" FontSize="12" SelectedIndex="0" x:FieldModifier="internal" />
                                        </DockPanel>
                                    </DockPanel>
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Slider x:Name="VideoExtraLoraLowSlider" Width="76" Minimum="0.1" Maximum="1.5" Value="0.75" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="LoraSlider_ValueChanged" x:FieldModifier="internal" />
                                            <TextBlock x:Name="VideoExtraLoraLowValText" Text="0.75" Width="34" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" Typography.NumeralAlignment="Tabular" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0" x:FieldModifier="internal" />
                                        </StackPanel>
                                        <DockPanel VerticalAlignment="Center">
                                            <TextBlock Text="LOW:" Width="42" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                            <ComboBox x:Name="VideoExtraLoraLowCombo" FontSize="12" SelectedIndex="0" x:FieldModifier="internal" />
                                        </DockPanel>
                                    </DockPanel>

                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock Text="ПРЕСЕТ:" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,7,0" DockPanel.Dock="Left" />
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <Button Content="Применить" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="12" Margin="0,0,5,0" Click="VideoPresetApplyBtn_Click" />
                                            <Button Content="Сохранить" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="12" Margin="0,0,5,0" Click="VideoPresetSaveBtn_Click" />
                                            <Button Style="{StaticResource DarkButton}" Padding="8,4" FontSize="12" Click="VideoPresetDeleteBtn_Click">
                                                <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconClose}" />
                                            </Button>
                                        </StackPanel>
                                        <ComboBox x:Name="VideoPresetCombo" FontSize="12" SelectionChanged="VideoPresetCombo_SelectionChanged" x:FieldModifier="internal" />
                                    </DockPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!-- Video Prompt Dock -->
                    <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="5" Padding="13" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <ComboBox x:Name="VideoSingleDirectorModelCombo" Width="148" FontSize="11" Margin="0,0,6,0" SelectionChanged="DirectorModelCombo_SelectionChanged" x:FieldModifier="internal" />
                                    <Button x:Name="VideoSingleDiscussBtn" Content="Уточнить" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="12" Margin="0,0,5,0" Click="VideoSingleDiscussBtn_Click" x:FieldModifier="internal" />
                                    <Button x:Name="VideoEnhanceDirectorBtn" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="12" Margin="0,0,5,0" Click="VideoEnhanceDirectorBtn_Click" x:FieldModifier="internal">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconSparkles}" Margin="0,0,5,0" />
                                            <TextBlock Text="Обогатить" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="VideoMicBtn" Style="{StaticResource DarkButton}" Padding="8,4" FontSize="12" Margin="0,0,5,0" Click="VideoMicBtn_Click" x:FieldModifier="internal">
                                        <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconMic}" />
                                    </Button>
                                    <Button x:Name="VideoHistoryBtn" Style="{StaticResource DarkButton}" Padding="8,4" FontSize="12" Margin="0,0,5,0" Click="VideoHistoryBtn_Click" x:FieldModifier="internal">
                                        <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconHistory}" />
                                    </Button>
                                    <Button Style="{StaticResource DarkButton}" Padding="8,4" FontSize="12" Click="VideoCopyPromptBtn_Click">
                                        <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconCopy}" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="ПРОМПТ ДВИЖЕНИЯ И КАМЕРЫ" FontSize="11.5" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBox x:Name="VideoPromptBox" Height="112" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="10,8" FontSize="13" Text="Smooth cinematic dolly-in shot of a cozy wooden cabin by a misty northern lake at golden hour, gentle ripples across the calm water, soft smoke rising from the chimney, warm glowing windows" x:FieldModifier="internal" />

                            <Border x:Name="SingleVideoDirectorChatPanel" Visibility="Collapsed" Background="#0C0C0E" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="10,9" Margin="0,8,0,0" x:FieldModifier="internal">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="РАЗБОР СЦЕНЫ" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <Button Content="Очистить" Style="{StaticResource DarkButton}" Padding="8,2" FontSize="11" Margin="0,0,5,0" Click="SingleVideoDirectorClearChatBtn_Click" />
                                            <Button Content="Скрыть ×" Style="{StaticResource DarkButton}" Padding="8,2" FontSize="11" Click="SingleVideoDirectorHideChatBtn_Click" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Border Background="{StaticResource WellBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,7">
                                        <ScrollViewer x:Name="SingleVideoDirectorChatScroll" MaxHeight="210" VerticalScrollBarVisibility="Auto" x:FieldModifier="internal">
                                            <StackPanel x:Name="SingleVideoDirectorMessagesPanel" x:FieldModifier="internal" />
                                        </ScrollViewer>
                                    </Border>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SingleVideoDirectorReplyBox" Grid.Column="0" MinHeight="38" MaxHeight="104" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="9,7" FontSize="13" Margin="0,0,7,0" PreviewKeyDown="SingleVideoDirectorReplyBox_PreviewKeyDown" x:FieldModifier="internal" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <Button x:Name="SingleVideoDirectorSendBtn" Content="Отправить" Style="{StaticResource DarkButton}" Height="38" Padding="12,0" Margin="0,0,6,0" Click="SingleVideoDirectorSendBtn_Click" x:FieldModifier="internal" />
                                            <Button x:Name="SingleVideoDirectorApplyBtn" Content="Вставить в промпт" Style="{StaticResource SuccessButton}" Height="38" Padding="12,0" Click="SingleVideoDirectorApplyBtn_Click" x:FieldModifier="internal" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <WrapPanel x:Name="VideoChipsPanel" Margin="0,8,0,0" x:FieldModifier="internal" />
                        </StackPanel>
                    </Border>

                    <!-- Execution Row -->
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button x:Name="VideoGenerateBtn" Content="Сгенерировать клип" Style="{StaticResource SuccessButton}" Padding="20,10" FontSize="13.5" FontWeight="SemiBold" Click="VideoGenerateBtn_Click" x:FieldModifier="internal" />
                            <Button x:Name="VideoEnqueueBtn" Content="+ В очередь" Style="{StaticResource DarkButton}" Padding="13,10" FontSize="12.5" Margin="8,0,0,0" Click="VideoEnqueueBtn_Click" x:FieldModifier="internal" />
                        </StackPanel>
                        <Button x:Name="VideoUseLastSeedBtn" Content="Фиксировать Seed" Style="{StaticResource DarkButton}" Padding="11,8" FontSize="12" HorizontalAlignment="Right" Visibility="Collapsed" Click="VideoUseLastSeedBtn_Click" x:FieldModifier="internal" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: Cinema Video Stage -->
            <Border Grid.Column="1" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="5" Padding="13">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="МОНИТОР ВИДЕО" FontSize="11.5" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Button Content="Папка вывода" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11.5" HorizontalAlignment="Right" Click="StudioOpenOutputFolderBtn_Click" />
                    </DockPanel>

                    <Border x:Name="VideoPreviewBorder" Grid.Row="1" Background="#070708" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Cursor="Hand" MouseLeftButtonUp="VideoPreviewBorder_Click" x:FieldModifier="internal">
                        <Grid>
                            <Image x:Name="VideoPreviewImage" Stretch="Uniform" Visibility="Collapsed" x:FieldModifier="internal" />
                            <TextBlock x:Name="VideoPreviewPlaceholder" Text="МОНИТОР ОЖИДАЕТ РЕНДЕРА" TextAlignment="Center" FontFamily="{StaticResource MonoFontFamily}" Foreground="#52525C" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" x:FieldModifier="internal" />
                        </Grid>
                    </Border>

                    <TextBlock x:Name="VideoResultMetaText" Grid.Row="2" Text="Готов к рендеру" FontSize="11.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,8" x:FieldModifier="internal" />

                    <StackPanel Grid.Row="3">
                        <WrapPanel>
                            <Button x:Name="VideoOpenResultBtn" Content="Открыть видеоплеер" Style="{StaticResource PrimaryButton}" Padding="12,6" FontSize="12" Margin="0,0,6,6" Visibility="Collapsed" Click="VideoOpenResultBtn_Click" x:FieldModifier="internal" />
                        </WrapPanel>

                        <Expander x:Name="VideoTtsExpander" Style="{StaticResource StudioExpanderStyle}" IsExpanded="False" Margin="0,4,0,0" x:FieldModifier="internal">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconVolume}" Margin="0,0,6,0" />
                                    <TextBlock Text="Локальная дикторская озвучка (TTS)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <ComboBox x:Name="VideoTtsVoiceCombo" FontSize="12" Margin="0,0,0,6" DisplayMemberPath="DisplayName" x:FieldModifier="internal" />
                                <TextBox x:Name="VideoTtsTextBox" Height="56" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,6" FontSize="12" Margin="0,0,0,6" x:FieldModifier="internal" />
                                <WrapPanel>
                                    <Button x:Name="VideoTtsPreviewBtn" Style="{StaticResource DarkButton}" Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="VideoTtsPreviewBtn_Click" x:FieldModifier="internal">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconVolume}" Margin="0,0,5,0" />
                                            <TextBlock Text="Прослушать" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="VideoTtsMuxBtn" Content="Свести звук с видео" Style="{StaticResource SuccessButton}" Padding="10,5" FontSize="12" Click="VideoTtsMuxBtn_Click" x:FieldModifier="internal" />
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Video Sub-view B: Video Story Pipeline -->
        <Grid x:Name="VideoStoryView" Grid.Row="1" Visibility="Collapsed" x:FieldModifier="internal">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,0,0,9">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="СЦЕНАРИЙ ВИДЕО-ПАЙПЛАЙНА" FontSize="11.5" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="LLM:" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <ComboBox x:Name="VideoStoryDirectorModelCombo" Width="205" FontSize="12" Margin="0,0,10,0" SelectionChanged="DirectorModelCombo_SelectionChanged" x:FieldModifier="internal" />
                            <CheckBox x:Name="VideoDirectorLoopCheck" Content="Бесшовный цикл" IsChecked="False" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" x:FieldModifier="internal" />
                        </StackPanel>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="VideoDirectorIdeaBox" Grid.Column="0" Height="34" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="9,0" FontSize="13" Margin="0,0,8,0" Text="Смешной мультяшный попугай корелла на кухне утром крадёт круассан со стола, гордо позирует и улетает с крошками" x:FieldModifier="internal" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="VideoDirectorOrientCombo" Width="84" FontSize="12" SelectedIndex="0" Margin="0,0,6,0" Height="34" x:FieldModifier="internal">
                                <ComboBoxItem Content="Авто" Tag="auto" />
                                <ComboBoxItem Content="16:9" Tag="16:9" />
                                <ComboBoxItem Content="9:16" Tag="9:16" />
                                <ComboBoxItem Content="1:1" Tag="1:1" />
                            </ComboBox>
                            <ComboBox x:Name="VideoDirectorCountCombo" Width="74" FontSize="12" SelectedIndex="1" Margin="0,0,6,0" Height="34" x:FieldModifier="internal">
                                <ComboBoxItem Content="2 сц." Tag="2" />
                                <ComboBoxItem Content="3 сц." Tag="3" />
                                <ComboBoxItem Content="4 сц." Tag="4" />
                                <ComboBoxItem Content="5 сц." Tag="5" />
                                <ComboBoxItem Content="6 сц." Tag="6" />
                            </ComboBox>
                            <Button x:Name="VideoDirectorDiscussBtn" Content="Уточнить" Style="{StaticResource DarkButton}" Height="34" Padding="11,0" Margin="0,0,6,0" Click="VideoDirectorDiscussBtn_Click" x:FieldModifier="internal" />
                            <Button x:Name="VideoDirectorBuildBtn" Content="Собрать сцены" Style="{StaticResource SuccessButton}" Height="34" Padding="12,0" Click="VideoDirectorBuildBtn_Click" x:FieldModifier="internal" />
                        </StackPanel>
                    </Grid>

                    <Border x:Name="VideoDirectorChatPanel" Visibility="Collapsed" Background="#0C0C0E" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="10,9" Margin="0,8,0,0" x:FieldModifier="internal">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="ДИАЛОГ СО СЦЕНАРИСТОМ" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="Очистить" Style="{StaticResource DarkButton}" Padding="8,2" FontSize="11" Margin="0,0,5,0" Click="VideoDirectorClearChatBtn_Click" />
                                    <Button Content="Скрыть ×" Style="{StaticResource DarkButton}" Padding="8,2" FontSize="11" Click="VideoDirectorHideChatBtn_Click" />
                                </StackPanel>
                            </DockPanel>
                            <Border Background="{StaticResource WellBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,7">
                                <ScrollViewer x:Name="VideoDirectorChatScroll" MaxHeight="200" VerticalScrollBarVisibility="Auto" x:FieldModifier="internal">
                                    <StackPanel x:Name="VideoDirectorMessagesPanel" x:FieldModifier="internal" />
                                </ScrollViewer>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="VideoDirectorReplyBox" Grid.Column="0" MinHeight="38" MaxHeight="104" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="9,7" FontSize="13" Margin="0,0,7,0" PreviewKeyDown="VideoDirectorReplyBox_PreviewKeyDown" x:FieldModifier="internal" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button x:Name="VideoDirectorSendReplyBtn" Content="Отправить" Style="{StaticResource DarkButton}" Height="38" Padding="12,0" Margin="0,0,6,0" Click="VideoDirectorSendReplyBtn_Click" x:FieldModifier="internal" />
                                    <Button x:Name="VideoDirectorReviseBtn" Content="Обновить этапы" Style="{StaticResource SuccessButton}" Height="38" Padding="12,0" Click="VideoDirectorReviseBtn_Click" x:FieldModifier="internal" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="5" Padding="12,8" Margin="0,0,0,9">
                <DockPanel LastChildFill="False">
                    <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="ДВИЖОК:" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="VideoStoryEngineCombo" Width="225" FontSize="12" SelectedIndex="0" Margin="0,0,10,0" x:FieldModifier="internal">
                            <ComboBoxItem Content="Wan 2.2 14B FP8 (DynamicVRAM)" Tag="wan14b_fp8" />
                            <ComboBoxItem Content="Wan 2.2 14B Q4 (4 шага, GGUF)" Tag="wan14b" />
                            <ComboBoxItem Content="Wan 2.2 14B Q6 (4 шага, GGUF)" Tag="wan14b_q6" />
                            <ComboBoxItem Content="LTX-2.5 (Видео + Звук)" Tag="ltx25" />
                        </ComboBox>
                        <TextBlock Text="ФОРМАТ:" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="VideoStorySizeCombo" Width="102" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" SelectedIndex="0" Margin="0,0,10,0" x:FieldModifier="internal">
                            <ComboBoxItem Content="832 × 480" Tag="832x480" />
                            <ComboBoxItem Content="480 × 832" Tag="480x832" />
                            <ComboBoxItem Content="640 × 640" Tag="640x640" />
                            <ComboBoxItem Content="768 × 448" Tag="768x448" />
                        </ComboBox>
                        <TextBlock Text="КЛИП:" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="VideoStoryDurCombo" Width="66" FontSize="12" FontFamily="{StaticResource MonoFontFamily}" SelectedIndex="1" x:FieldModifier="internal">
                            <ComboBoxItem Content="3 сек" Tag="3" />
                            <ComboBoxItem Content="4 сек" Tag="4" />
                            <ComboBoxItem Content="5 сек" Tag="5" />
                        </ComboBox>
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button x:Name="RunVideoPipelineBtn" Content="Запустить пайплайн" Style="{StaticResource SuccessButton}" Padding="12,6" Click="RunVideoPipelineBtn_Click" Margin="0,0,6,0" x:FieldModifier="internal" />
                        <Button Content="+ Сцена" Style="{StaticResource PrimaryButton}" Padding="10,6" Click="AddVideoStageBtn_Click" Margin="0,0,6,0" />
                        <Button x:Name="MergeVideoStoryBtn" Content="Склеить MP4" Style="{StaticResource DarkButton}" Padding="10,6" Click="MergeVideoStoryBtn_Click" Margin="0,0,6,0" x:FieldModifier="internal" />
                        <Button Content="Сброс" Style="{StaticResource DarkButton}" Padding="10,6" Click="ResetVideoStoryBtn_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel x:Name="VideoStagesPanel" x:FieldModifier="internal" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
