<UserControl x:Class="LocalAIHub.Views.GalleryTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid PreviewKeyDown="GalleryGrid_PreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Architectural Filter Strip + Search + Sort -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,9" Margin="0,0,0,9">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button x:Name="GalleryFilterAllBtn" Content="Все файлы" Style="{StaticResource PrimaryButton}" Padding="11,5" FontSize="12" Margin="0,0,5,0" Click="GalleryFilterBtn_Click" Tag="all" x:FieldModifier="internal" />
                    <Button x:Name="GalleryFilterPhotoBtn" Style="{StaticResource DarkButton}" Padding="11,5" FontSize="12" Margin="0,0,5,0" Click="GalleryFilterBtn_Click" Tag="photo" x:FieldModifier="internal">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconPhoto}" Margin="0,0,6,0" />
                            <TextBlock Text="Фото" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="GalleryFilterVideoBtn" Style="{StaticResource DarkButton}" Padding="11,5" FontSize="12" Margin="0,0,5,0" Click="GalleryFilterBtn_Click" Tag="video" x:FieldModifier="internal">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconVideo}" Margin="0,0,6,0" />
                            <TextBlock Text="Видео" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="GalleryFilterFavBtn" Style="{StaticResource DarkButton}" Padding="11,5" FontSize="12" Margin="0,0,5,0" Click="GalleryFilterBtn_Click" Tag="fav" x:FieldModifier="internal">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconStar}" Margin="0,0,6,0" />
                            <TextBlock Text="Избранное" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="GalleryFilterTempBtn" Style="{StaticResource DarkButton}" Padding="11,5" FontSize="12" Margin="0,0,5,0" Click="GalleryFilterBtn_Click" Tag="temp" x:FieldModifier="internal">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconTrash}" Margin="0,0,6,0" />
                            <TextBlock Text="Кэш / Input" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBox x:Name="GallerySearchBox" Width="175" Height="28" VerticalContentAlignment="Center" Background="{StaticResource WellBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" Padding="8,0" FontSize="12" Margin="0,0,6,0" ToolTip="Фильтр по имени файла или папке" TextChanged="GallerySearchBox_TextChanged" x:FieldModifier="internal" />
                    <ComboBox x:Name="GallerySortCombo" Width="140" Height="28" FontSize="12" SelectedIndex="0" Margin="0,0,6,0" SelectionChanged="GallerySortCombo_Changed" x:FieldModifier="internal">
                        <ComboBoxItem Content="Сначала новые" Tag="newest" />
                        <ComboBoxItem Content="Сначала старые" Tag="oldest" />
                        <ComboBoxItem Content="По размеру" Tag="largest" />
                    </ComboBox>
                    <Button Style="{StaticResource DarkButton}" Padding="9,5" FontSize="12" Margin="0,0,6,0" Click="GalleryRefreshBtn_Click" ToolTip="Обновить галерею">
                        <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconRefresh}" />
                    </Button>
                    <Button Content="Папка" Style="{StaticResource DarkButton}" Padding="10,5" FontSize="12" Click="StudioOpenOutputFolderBtn_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Row 1: Batch Selection Bar -->
        <Border Grid.Row="1" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="5" Padding="11,7" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock x:Name="GalleryStatsText" Text="Сканирование..." FontSize="11.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0" x:FieldModifier="internal" />
                <WrapPanel VerticalAlignment="Center">
                    <Button x:Name="GallerySelectAllBtn" Content="Выбрать все" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11.5" Margin="0,0,5,0" Click="GallerySelectAllBtn_Click" x:FieldModifier="internal" />
                    <Button x:Name="GallerySelectTrashBtn" Content="Кроме избранных" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11.5" Margin="0,0,5,0" Click="GallerySelectTrashBtn_Click" x:FieldModifier="internal" />
                    <Button x:Name="GalleryClearSelBtn" Content="Снять выбор" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11.5" Margin="0,0,8,0" Click="GalleryClearSelBtn_Click" x:FieldModifier="internal" />
                    <Button x:Name="GalleryDeleteSelectedBtn" Content="В корзину (0)" Style="{StaticResource DangerButton}" Padding="10,4" FontSize="11.5" Margin="0,0,8,0" IsEnabled="False" Click="GalleryDeleteSelectedBtn_Click" x:FieldModifier="internal" />
                    <Button x:Name="GalleryCleanTempBtn" Content="Очистить кэш Input" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="11.5" Click="GalleryCleanTempBtn_Click" x:FieldModifier="internal" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Row 2: 55/45 Grid + Cinema Inspector -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="55*" MinWidth="440" />
                <ColumnDefinition Width="45*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#09090B" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,12,0">
                <ScrollViewer x:Name="GalleryScroll" VerticalScrollBarVisibility="Auto" x:FieldModifier="internal">
                    <StackPanel>
                        <WrapPanel x:Name="GalleryItemsPanel" x:FieldModifier="internal" />
                        <Button x:Name="GalleryLoadMoreBtn" Content="Загрузить ещё..." Style="{StaticResource DarkButton}" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,10,0,6" Padding="18,7" Click="GalleryLoadMoreBtn_Click" x:FieldModifier="internal" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="5" Padding="13">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="ИНСПЕКТОР · ←/→ · F · DEL" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="←" Style="{StaticResource DarkButton}" Padding="9,3" FontSize="11.5" FontFamily="{StaticResource MonoFontFamily}" Margin="0,0,4,0" Click="GalleryPrevBtn_Click" />
                            <Button Content="→" Style="{StaticResource DarkButton}" Padding="9,3" FontSize="11.5" FontFamily="{StaticResource MonoFontFamily}" Click="GalleryNextBtn_Click" />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Background="#070708" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="GalleryPreviewImage" Stretch="Uniform" Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="GalleryPreviewImage_Click" ToolTip="Открыть на весь экран" x:FieldModifier="internal" />
                            <MediaElement x:Name="GalleryVideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" Visibility="Collapsed" MediaEnded="GalleryVideoPlayer_MediaEnded" x:FieldModifier="internal" />
                            <TextBlock x:Name="GalleryPreviewPlaceholder" Text="ВЫБЕРИТЕ ОБЪЕКТ СЛЕВА" TextAlignment="Center" FontFamily="{StaticResource MonoFontFamily}" Foreground="#52525C" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" x:FieldModifier="internal" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,8,0,8">
                        <TextBlock x:Name="GalleryMetaTitleText" Text="Файл не выбран" FontSize="12.5" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" x:FieldModifier="internal" />
                        <TextBlock x:Name="GalleryMetaSubText" Text="—" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" x:FieldModifier="internal" />
                        <Border x:Name="GalleryMetaPromptBorder" Visibility="Collapsed" Background="#0A0A0C" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,5,0,0" x:FieldModifier="internal">
                            <TextBlock x:Name="GalleryMetaPromptText" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxHeight="62" TextTrimming="CharacterEllipsis" x:FieldModifier="internal" />
                        </Border>
                    </StackPanel>

                    <WrapPanel Grid.Row="3">
                        <Button x:Name="GalleryRestoreStudioBtn" Style="{StaticResource SuccessButton}" Padding="10,6" FontSize="12" Margin="0,0,6,6" Visibility="Collapsed" ToolTip="Восстановить промпт, модель и Seed в Студии" Click="GalleryRestoreStudioBtn_Click" x:FieldModifier="internal">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconRestore}" Margin="0,0,6,0" />
                                <TextBlock Text="В Студию" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="GalleryPlayPauseBtn" Content="Пауза" Style="{StaticResource PrimaryButton}" Padding="11,6" FontSize="12" Margin="0,0,6,6" Visibility="Collapsed" Click="GalleryPlayPauseBtn_Click" x:FieldModifier="internal" />
                        <Button x:Name="GalleryToggleFavBtn" Content="В избранное" Style="{StaticResource DarkButton}" Padding="10,6" FontSize="12" Margin="0,0,6,6" Visibility="Collapsed" Click="GalleryToggleFavBtn_Click" x:FieldModifier="internal" />
                        <Button x:Name="GalleryCopyImageBtn" Style="{StaticResource DarkButton}" Padding="10,6" FontSize="12" Margin="0,0,6,6" Visibility="Collapsed" Click="GalleryCopyImageBtn_Click" x:FieldModifier="internal">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconCopy}" Margin="0,0,6,0" />
                                <TextBlock Text="Копировать" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="GalleryOpenExternalBtn" Content="Открыть ↗" Style="{StaticResource DarkButton}" Padding="10,6" FontSize="12" Margin="0,0,6,6" Visibility="Collapsed" Click="GalleryOpenExternalBtn_Click" x:FieldModifier="internal" />
                        <Button x:Name="GalleryRevealBtn" Content="В папке" Style="{StaticResource DarkButton}" Padding="10,6" FontSize="12" Margin="0,0,6,6" Visibility="Collapsed" Click="GalleryRevealBtn_Click" x:FieldModifier="internal" />
                        <Button x:Name="GallerySendToVideoBtn" Content="→ В Видео" Style="{StaticResource DarkButton}" Padding="10,6" FontSize="12" Margin="0,0,6,6" Visibility="Collapsed" Click="GallerySendToVideoBtn_Click" x:FieldModifier="internal" />
                        <Button x:Name="GallerySendToUpscaleBtn" Content="→ Апскейл ×4" Style="{StaticResource DarkButton}" Padding="10,6" FontSize="12" Margin="0,0,6,6" Visibility="Collapsed" Click="GallerySendToUpscaleBtn_Click" x:FieldModifier="internal" />
                        <Button x:Name="GallerySendToPhotoRefBtn" Content="→ Референс" Style="{StaticResource DarkButton}" Padding="10,6" FontSize="12" Margin="0,0,6,6" Visibility="Collapsed" Click="GallerySendToPhotoRefBtn_Click" x:FieldModifier="internal" />
                        <Button x:Name="GalleryDeleteCurrentBtn" Style="{StaticResource DangerButton}" Padding="11,6" FontSize="12" Margin="0,0,0,6" Visibility="Collapsed" Click="GalleryDeleteCurrentBtn_Click" x:FieldModifier="internal">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconTrash}" Margin="0,0,6,0" />
                                <TextBlock Text="Удалить" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
