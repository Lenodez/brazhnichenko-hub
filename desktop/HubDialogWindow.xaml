<Window x:Class="LocalAIHub.HubDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="490"
        MaxHeight="560"
        ShowInTaskbar="False"
        Background="{StaticResource Surface1Brush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        BorderThickness="0"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{StaticResource Surface1Brush}"
            BorderBrush="{StaticResource BorderDefaultBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Dark Titlebar -->
            <Border Grid.Row="0"
                    Background="#11151E"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,11,10,11"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel>
                    <Button x:Name="CloseHeaderBtn"
                            DockPanel.Dock="Right"
                            Style="{StaticResource GhostButton}"
                            Padding="6,4"
                            ToolTip="Закрыть (Esc)"
                            Click="CloseHeaderBtn_Click">
                        <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconClose}"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="IconBadge"
                                Width="26" Height="26"
                                CornerRadius="7"
                                Background="{StaticResource AccentTintBrush}"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <Path x:Name="IconPath"
                                  Width="15" Height="15"
                                  Stretch="Uniform"
                                  Data="{StaticResource IconInfo}"
                                  Stroke="{StaticResource AccentBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TitleText"
                                   Text="Brazhnichenko Hub"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Scrollable Message Body -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          MaxHeight="360"
                          Padding="18,16,18,16">
                <TextBox x:Name="MessageBoxText"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         FontSize="13"
                         Padding="0"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Disabled"
                         FocusVisualStyle="{x:Null}"/>
            </ScrollViewer>

            <!-- Action Footer -->
            <Border Grid.Row="2"
                    Background="#11151E"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,11">
                <DockPanel>
                    <Button x:Name="CopyTextBtn"
                            DockPanel.Dock="Left"
                            Style="{StaticResource GhostButton}"
                            Padding="9,5"
                            FontSize="12"
                            Click="CopyTextBtn_Click"
                            ToolTip="Скопировать текст сообщения в буфер обмена">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconCopy}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="CopyTextLabel" Text="Копировать" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel x:Name="ButtonsPanel"
                                DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
