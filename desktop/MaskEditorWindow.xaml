<Window x:Class="LocalAIHub.MaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор маски (Inpainting) — Brazhnichenko Hub"
        Width="980" Height="740" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgCanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="1" CornerRadius="5" Padding="12,8" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource DarkButton}" Padding="10,5" Margin="0,0,6,0" ToolTip="Отменить штрих (Ctrl+Z)" Click="UndoBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconUndo}" Margin="0,0,5,0"/>
                            <TextBlock Text="Отмена" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Инвертировать" Style="{StaticResource DarkButton}" Padding="10,5" Margin="0,0,6,0" Click="InvertBtn_Click"/>
                    <Button Content="Очистить" Style="{StaticResource DarkButton}" Padding="10,5" Click="ClearBtn_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BrushToolBtn" Style="{StaticResource PrimaryButton}" Padding="11,5" Margin="0,0,6,0" Click="BrushToolBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconBrush}" Margin="0,0,5,0"/>
                            <TextBlock Text="Кисть" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="EraserToolBtn" Style="{StaticResource DarkButton}" Padding="11,5" Margin="0,0,14,0" Click="EraserToolBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconEraser}" Margin="0,0,5,0"/>
                            <TextBlock Text="Ластик" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="РАЗМЕР:" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="BrushSizeSlider" Width="130" Minimum="8" Maximum="120" Value="42" VerticalAlignment="Center" ValueChanged="BrushSizeSlider_ValueChanged"/>
                    <TextBlock x:Name="BrushSizeText" Text="42 px" Width="44" FontSize="12" FontFamily="{StaticResource MonoFontFamily}"
                               Typography.NumeralAlignment="Tabular" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="#070708" BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="1" CornerRadius="5" Padding="10">
            <Viewbox Stretch="Uniform">
                <Grid x:Name="PaintSurface"
                      Cursor="Cross"
                      MouseLeftButtonDown="PaintSurface_MouseDown"
                      MouseMove="PaintSurface_MouseMove"
                      MouseLeftButtonUp="PaintSurface_MouseUp">
                    <Image x:Name="BaseImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Image x:Name="MaskOverlayImage" Stretch="None" Opacity="0.58" IsHitTestVisible="False"/>
                </Grid>
            </Viewbox>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Отмена" Style="{StaticResource DarkButton}" Padding="14,7" Margin="0,0,8,0" Click="CancelBtn_Click"/>
                <Button Style="{StaticResource SuccessButton}" Padding="16,7" Click="ApplyBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconCheck}" Margin="0,0,6,0"/>
                        <TextBlock Text="Применить маску" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="Закрасьте кистью область для локальной перерисовки. Остальная часть кадра останется нетронутой."
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
