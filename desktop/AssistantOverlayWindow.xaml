<Window x:Class="LocalAIHub.AssistantOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ассистент — Brazhnichenko Hub"
        Width="700" Height="540" MinWidth="540" MinHeight="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFontFamily}"
        Foreground="{StaticResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="#0E121B" BorderBrush="#2D3B59" BorderThickness="1.2" CornerRadius="16" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.6" Color="#000000" />
        </Border.Effect>

        <Grid Margin="14,12,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Clean Draggable Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="CaptureScreenBtn" Style="{StaticResource DarkButton}" Padding="9,5" FontSize="12" Margin="0,0,6,0" ToolTip="Обновить скриншот экрана (Vision)" Click="CaptureScreenBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconPhoto}" Margin="0,0,5,0" />
                            <TextBlock Text="Экран" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DarkButton}" Padding="9,5" FontSize="12" Margin="0,0,6,0" ToolTip="Очистить диалог ассистента" Click="ClearBtn_Click" Content="Очистить" />
                    <Button Style="{StaticResource GhostButton}" Padding="7,5" ToolTip="Скрыть (Esc)" Click="CloseBtn_Click">
                        <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconClose}" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/app.png" Width="22" Height="22" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Ассистент ПК" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Background="#12291E" BorderBrush="#247846" BorderThickness="1" CornerRadius="9" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                            ToolTip="Безопасный режим: ассистент может видеть экран, искать в сети и отвечать, но НЕ имеет доступа к изменению файлов, запуску команд и настройкам ПК.">
                        <TextBlock Text="Только чтение" FontSize="11" FontWeight="SemiBold" Foreground="#7CF0A8" />
                    </Border>
                    <Border Background="#151D2E" BorderBrush="#2C3C5E" BorderThickness="1" CornerRadius="9" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ModelBadgeText" Text="Авто" FontSize="11" Foreground="#93C5FD" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- Row 1: Captured Screen Preview Strip -->
            <Border x:Name="ScreenStripBorder" Grid.Row="1" Visibility="Collapsed" Background="#141A26" BorderBrush="#2A3956" BorderThickness="1" CornerRadius="10" Padding="8,6" Margin="0,0,0,8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="6,3" ToolTip="Убрать скриншот экрана" Click="RemoveScreenBtn_Click">
                        <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconClose}" />
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="58" Height="34" CornerRadius="6" ClipToBounds="True" BorderBrush="#35476B" BorderThickness="1" Margin="0,0,9,0">
                            <Image x:Name="ScreenPreviewImg" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ScreenStatusTitle" Text="Скриншот экрана прикреплён (Vision)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock x:Name="ScreenStatusSub" Text="Нейросеть увидит текущий экран при отправке вопроса" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Row 2: Quick 1-Click Actions -->
            <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                <Button Content="Что на экране?" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="12" Margin="0,0,6,4" Click="QuickChip_Click" Tag="Объясни кратко, что сейчас на экране, и помоги разобраться:" />
                <Button Content="Перевести текст" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="12" Margin="0,0,6,4" Click="QuickChip_Click" Tag="Переведи текст на экране (или в моём сообщении) естественно на русский:" />
                <Button Content="Кратко суть" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="12" Margin="0,0,6,4" Click="QuickChip_Click" Tag="Сделай краткую выжимку в 3-5 пунктах без воды:" />
                <Button Content="Найти в сети" Style="{StaticResource DarkButton}" Padding="10,4" FontSize="12" Margin="0,0,0,4" Click="QuickWebChip_Click" />
            </WrapPanel>

            <!-- Row 3: Clean Messages Feed -->
            <Border Grid.Row="3" Background="#0A0D14" BorderBrush="#1F2738" BorderThickness="1" CornerRadius="12" Padding="12">
                <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MessagesPanel" />
                </ScrollViewer>
            </Border>

            <!-- Row 4: Unified Modern Capsule Composer (Mobile-inspired!) -->
            <Border Grid.Row="4" Background="#141925" BorderBrush="#314162" BorderThickness="1" CornerRadius="14" Padding="10,8,10,7" Margin="0,9,0,0">
                <StackPanel>
                    <TextBox x:Name="InputBox" MinHeight="34" MaxHeight="100" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="#5B8CFF"
                             FontSize="13.5" Padding="2,2" PreviewKeyDown="InputBox_PreviewKeyDown" />

                    <DockPanel Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText" Text="Enter — отправить • Esc — скрыть" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button x:Name="SendBtn" Content="Отправить" Style="{StaticResource PrimaryButton}" Padding="14,6" FontSize="12.5" Click="SendBtn_Click" />
                            <Button x:Name="StopBtn" Content="Стоп" Style="{StaticResource DangerButton}" Padding="14,6" FontSize="12.5" Visibility="Collapsed" Click="StopBtn_Click" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="MicBtn" Style="{StaticResource DarkButton}" Padding="9,6" Margin="0,0,6,0" ToolTip="Голосовой ввод (локальный Whisper)" Click="MicBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconMic}" Margin="0,0,5,0" />
                                    <TextBlock x:Name="MicBtnText" Text="Голос" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <CheckBox x:Name="WebSearchCheck" Content="Поиск в сети" IsChecked="True" Foreground="#93C5FD" FontSize="12" VerticalAlignment="Center" Margin="4,0,10,0" />
                            <CheckBox x:Name="AutoTtsCheck" Content="Озвучивать" IsChecked="False" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
