<Window x:Class="LocalAIHub.AssistantOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Экранный ассистент — Brazhnichenko Hub"
        Width="680" Height="510" MinWidth="520" MinHeight="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFontFamily}"
        Foreground="{StaticResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="#0D0D0F" BorderBrush="#2E2E36" BorderThickness="1" CornerRadius="8" Margin="10" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.7" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Precision Instrument Header -->
            <Border Grid.Row="0" Background="#121216" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="14,9" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button x:Name="CaptureScreenBtn" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11.5" Margin="0,0,6,0" ToolTip="Обновить снимок экрана (Vision)" Click="CaptureScreenBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconPhoto}" Margin="0,0,5,0" />
                                <TextBlock Text="Снимок" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11.5" Margin="0,0,6,0" Click="ClearBtn_Click" Content="Сброс" />
                        <Button Style="{StaticResource GhostButton}" Padding="7,4" ToolTip="Скрыть (Esc)" Click="CloseBtn_Click">
                            <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconClose}" />
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/app.png" Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="ЭКРАН · АССИСТЕНТ" FontSize="12" FontWeight="Bold" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center" />
                        <Border Background="#18181D" BorderBrush="#2C2C35" BorderThickness="1" CornerRadius="3" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                ToolTip="Режим только чтения: нет доступа к изменению файлов и запуску команд.">
                            <TextBlock Text="READ-ONLY" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" Foreground="#34D399" />
                        </Border>
                        <Border Background="#18181D" BorderBrush="#2C2C35" BorderThickness="1" CornerRadius="3" Padding="7,2" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ModelBadgeText" Text="Авто" FontSize="10.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextSecondaryBrush}" MaxWidth="190" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Row 1: Captured Screen Strip -->
            <Border x:Name="ScreenStripBorder" Grid.Row="1" Visibility="Collapsed" Background="#141418" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="14,7">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="6,3" ToolTip="Открепить снимок" Click="RemoveScreenBtn_Click">
                        <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconClose}" />
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="54" Height="32" CornerRadius="3" ClipToBounds="True" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Margin="0,0,9,0">
                            <Image x:Name="ScreenPreviewImg" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ScreenStatusTitle" Text="Захвачен текущий экран (Vision)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock x:Name="ScreenStatusSub" Text="Отправится локальной модели вместе с вопросом" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Row 2: Quick Actions -->
            <WrapPanel Grid.Row="2" Margin="14,8,14,4">
                <Button Content="Разобрать экран" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11.5" Margin="0,0,5,4" Click="QuickChip_Click" Tag="Объясни кратко, что сейчас на экране, и помоги разобраться:" />
                <Button Content="Перевести" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11.5" Margin="0,0,5,4" Click="QuickChip_Click" Tag="Переведи текст на экране (или в моём сообщении) естественно на русский:" />
                <Button Content="Суть в 3 пунктах" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11.5" Margin="0,0,5,4" Click="QuickChip_Click" Tag="Сделай краткую выжимку в 3-5 пунктах без воды:" />
                <Button Content="Поиск в сети" Style="{StaticResource DarkButton}" Padding="9,4" FontSize="11.5" Margin="0,0,0,4" Click="QuickWebChip_Click" />
            </WrapPanel>

            <!-- Row 3: Borderless Messages Feed -->
            <ScrollViewer x:Name="MessagesScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="14,6">
                <StackPanel x:Name="MessagesPanel" />
            </ScrollViewer>

            <!-- Row 4: Sleek Command Composer -->
            <Border Grid.Row="4" Background="#121216" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="0,1,0,0" Padding="14,10">
                <StackPanel>
                    <TextBox x:Name="InputBox" MinHeight="32" MaxHeight="96" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="#FF521B"
                             FontSize="13.5" Padding="2,2" PreviewKeyDown="InputBox_PreviewKeyDown" />

                    <DockPanel Margin="0,7,0,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText" Text="Enter — отправить · Esc — скрыть" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button x:Name="SendBtn" Content="Отправить" Style="{StaticResource SuccessButton}" Padding="14,5" FontSize="12" Click="SendBtn_Click" />
                            <Button x:Name="StopBtn" Content="Стоп" Style="{StaticResource DangerButton}" Padding="14,5" FontSize="12" Visibility="Collapsed" Click="StopBtn_Click" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="MicBtn" Style="{StaticResource DarkButton}" Padding="9,5" Margin="0,0,8,0" ToolTip="Голосовой ввод (локальный Whisper)" Click="MicBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource UiIcon14}" Data="{StaticResource IconMic}" Margin="0,0,5,0" />
                                    <TextBlock x:Name="MicBtnText" Text="Голос" FontSize="11.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <CheckBox x:Name="WebSearchCheck" Content="Сеть" IsChecked="True" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="2,0,12,0" />
                            <CheckBox x:Name="AutoTtsCheck" Content="Озвучка" IsChecked="False" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
